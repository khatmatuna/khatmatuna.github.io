٣٨",1]]],["l",[["3:139","وَلَا"],["3:139","تَهِنُواْ"],["3:139","وَلَا"],["3:139","تَحۡزَنُواْ"],["3:139","وَأَنتُمُ"],["3:139","ٱلۡأَعۡلَوۡنَ"],["3:139","إِن"],["3:139","كُنتُم"],["3:139","مُّؤۡمِنِينَ"],["3:139","۝١٣٩",1]]],["l",[["3:140","إِن"],["3:140","يَمۡسَسۡكُمۡ"],["3:140","قَرۡحࣱ"],["3:140","فَقَدۡ"],["3:140","مَسَّ"],["3:140","ٱلۡقَوۡمَ"],["3:140","قَرۡحࣱ"],["3:140","مِّثۡلُهُۥۚ"],["3:140","وَتِلۡكَ"]]],["l",[["3:140","ٱلۡأَيَّامُ"],["3:140","نُدَاوِلُهَا"],["3:140","بَيۡنَ"],["3:140","ٱلنَّاسِ"],["3:140","وَلِيَعۡلَمَ"],["3:140","ٱللَّهُ"],["3:140","ٱلَّذِينَ"],["3:140","ءَامَنُواْ"]]],["l",[["3:140","وَيَتَّخِذَ"],["3:140","مِنكُمۡ"],["3:140","شُهَدَآءَۗ"],["3:140","وَٱللَّهُ"],["3:140","لَا"],["3:140","يُحِبُّ"],["3:140","ٱلظَّٰلِمِينَ"],["3:140","۝١٤٠",1]]]],"a":[[3,133,"۞ وَسَارِعُوۤا۟ إِلَىٰ مَغۡفِرَةࣲ مِّن رَّبِّكُمۡ وَجَنَّةٍ عَرۡضُهَا ٱلسَّمَـٰوَٰتُ وَٱلۡأَرۡضُ أُعِدَّتۡ لِلۡمُتَّقِینَ"],[3,134,"ٱلَّذِینَ یُنفِقُونَ فِی ٱلسَّرَّاۤءِ وَٱلضَّرَّاۤءِ وَٱلۡكَـٰظِمِینَ ٱلۡغَیۡظَ وَٱلۡعَافِینَ عَنِ ٱلنَّاسِۗ وَٱللَّهُ یُحِبُّ ٱلۡمُحۡسِنِینَ"],[3,135,"وَٱلَّذِینَ إِذَا فَعَلُوا۟ فَـٰحِشَةً أَوۡ ظَلَمُوۤا۟ أَنفُسَهُمۡ ذَكَرُوا۟ ٱللَّهَ فَٱسۡتَغۡفَرُوا۟ لِذُنُوبِهِمۡ وَمَن یَغۡفِرُ ٱلذُّنُوبَ إِلَّا ٱللَّهُ وَلَمۡ یُصِرُّوا۟ عَلَىٰ مَا فَعَلُوا۟ وَهُمۡ یَعۡلَمُونَ"],[3,136,"أُو۟لَـٰۤئِكَ جَزَاۤؤُهُم مَّغۡفِرَةࣱ مِّن رَّبِّهِمۡ وَجَنَّـٰتࣱ تَجۡرِی مِن تَحۡتِهَا ٱلۡأَنۡهَـٰرُ خَـٰلِدِینَ فِیهَاۚ وَنِعۡمَ أَجۡرُ ٱلۡعَـٰمِلِینَ"],[3,137,"قَدۡ خَلَتۡ مِن قَبۡلِكُمۡ سُنَنࣱ فَسِیرُوا۟ فِی ٱلۡأَرۡضِ فَٱنظُرُوا۟ كَیۡفَ كَانَ عَـٰقِبَةُ ٱلۡمُكَذِّبِینَ"],[3,138,"هَـٰذَا بَیَانࣱ لِّلنَّاسِ وَهُدࣰى وَمَوۡعِظَةࣱ لِّلۡمُتَّقِینَ"],[3,139,"وَلَا تَهِنُوا۟ وَلَا تَحۡزَنُوا۟ وَأَنتُمُ ٱلۡأَعۡلَوۡنَ إِن كُنتُم مُّؤۡمِنِینَ"],[3,140,"إِن یَمۡسَسۡكُمۡ قَرۡحࣱ فَقَدۡ مَسَّ ٱلۡقَوۡمَ قَرۡحࣱ مِّثۡلُهُۥۚ وَتِلۡكَ ٱلۡأَیَّامُ نُدَاوِلُهَا بَیۡنَ ٱلنَّاسِ وَلِیَعۡلَمَ ٱللَّهُ ٱلَّذِینَ ءَامَنُوا۟ وَیَتَّخِذَ مِنكُمۡ شُهَدَاۤءَۗ وَٱللَّهُ لَا یُحِبُّ ٱلظَّـٰلِمِینَ"]]}