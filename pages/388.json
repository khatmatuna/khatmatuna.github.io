","ٱلۡأَمِينُ"],["28:26","۝٢٦",1]]],["l",[["28:27","قَالَ"],["28:27","إِنِّيٓ"],["28:27","أُرِيدُ"],["28:27","أَنۡ"],["28:27","أُنكِحَكَ"],["28:27","إِحۡدَى"],["28:27","ٱبۡنَتَيَّ"],["28:27","هَٰتَيۡنِ"],["28:27","عَلَىٰٓ"],["28:27","أَن"]]],["l",[["28:27","تَأۡجُرَنِي"],["28:27","ثَمَٰنِيَ"],["28:27","حِجَجࣲۖ"],["28:27","فَإِنۡ"],["28:27","أَتۡمَمۡتَ"],["28:27","عَشۡرࣰا"],["28:27","فَمِنۡ"],["28:27","عِندِكَۖ"]]],["l",[["28:27","وَمَآ"],["28:27","أُرِيدُ"],["28:27","أَنۡ"],["28:27","أَشُقَّ"],["28:27","عَلَيۡكَۚ"],["28:27","سَتَجِدُنِيٓ"],["28:27","إِن"],["28:27","شَآءَ"],["28:27","ٱللَّهُ"],["28:27","مِنَ"]]],["l",[["28:27","ٱلصَّٰلِحِينَ"],["28:27","۝٢٧",1],["28:28","قَالَ"],["28:28","ذَٰلِكَ"],["28:28","بَيۡنِي"],["28:28","وَبَيۡنَكَۖ"],["28:28","أَيَّمَا"],["28:28","ٱلۡأَجَلَيۡنِ"]]],["l",[["28:28","قَضَيۡتُ"],["28:28","فَلَا"],["28:28","عُدۡوَٰنَ"],["28:28","عَلَيَّۖ"],["28:28","وَٱللَّهُ"],["28:28","عَلَىٰ"],["28:28","مَا"],["28:28","نَقُولُ"],["28:28","وَكِيلࣱ"],["28:28","۝٢٨",1]]]],"a":[[28,22,"وَلَمَّا تَوَجَّهَ تِلۡقَاۤءَ مَدۡیَنَ قَالَ عَسَىٰ رَبِّیۤ أَن یَهۡدِیَنِی سَوَاۤءَ ٱلسَّبِیلِ"],[28,23,"وَلَمَّا وَرَدَ مَاۤءَ مَدۡیَنَ وَجَدَ عَلَیۡهِ أُمَّةࣰ مِّنَ ٱلنَّاسِ یَسۡقُونَ وَوَجَدَ مِن دُونِهِمُ ٱمۡرَأَتَیۡنِ تَذُودَانِۖ قَالَ مَا خَطۡبُكُمَاۖ قَالَتَا لَا نَسۡقِی حَتَّىٰ یُصۡدِرَ ٱلرِّعَاۤءُۖ وَأَبُونَا شَیۡخࣱ كَبِیرࣱ"],[28,24,"فَسَقَىٰ لَهُمَا ثُمَّ تَوَلَّىٰۤ إِلَى ٱلظِّلِّ فَقَالَ رَبِّ إِنِّی لِمَاۤ أَنزَلۡتَ إِلَیَّ مِنۡ خَیۡرࣲ فَقِیرࣱ"],[28,25,"فَجَاۤءَتۡهُ إِحۡدَىٰهُمَا تَمۡشِی عَلَى ٱسۡتِحۡیَاۤءࣲ قَالَتۡ إِنَّ أَبِی یَدۡعُوكَ لِیَجۡزِیَكَ أَجۡرَ مَا سَقَیۡتَ لَنَاۚ فَلَمَّا جَاۤءَهُۥ وَقَصَّ عَلَیۡهِ ٱلۡقَصَصَ قَالَ لَا تَخَفۡۖ نَجَوۡتَ مِنَ ٱلۡقَوۡمِ ٱلظَّـٰلِمِینَ"],[28,26,"قَالَتۡ إِحۡدَىٰهُمَا یَـٰۤأَبَتِ ٱسۡتَءۡجِرۡهُۖ إِنَّ خَیۡرَ مَنِ ٱسۡتَءۡجَرۡتَ ٱلۡقَوِیُّ ٱلۡأَمِینُ"],[28,27,"قَالَ إِنِّیۤ أُرِیدُ أَنۡ أُنكِحَكَ إِحۡدَى ٱبۡنَتَیَّ هَـٰتَیۡنِ عَلَىٰۤ أَن تَأۡجُرَنِی ثَمَـٰنِیَ حِجَجࣲۖ فَإِنۡ أَتۡمَمۡتَ عَشۡرࣰا فَمِنۡ عِندِكَۖ وَمَاۤ أُرِیدُ أَنۡ أَشُقَّ عَلَیۡكَۚ سَتَجِدُنِیۤ إِن شَاۤءَ ٱللَّهُ مِنَ ٱلصَّـٰلِحِینَ"],[28,28,"قَالَ ذَٰلِكَ بَیۡنِی وَبَیۡنَكَۖ أَیَّمَا ٱلۡأَجَلَیۡنِ قَضَیۡتُ فَلَا عُدۡوَٰنَ عَلَیَّۖ وَٱللَّهُ عَلَىٰ مَا نَقُولُ وَكِیلࣱ"]]}