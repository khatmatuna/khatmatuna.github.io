"5:29","مِنۡ"],["5:29","أَصۡحَٰبِ"],["5:29","ٱلنَّارِۚ"],["5:29","وَذَٰلِكَ"],["5:29","جَزَٰٓؤُاْ"],["5:29","ٱلظَّٰلِمِينَ"],["5:29","۝٢٩",1],["5:30","فَطَوَّعَتۡ"]]],["l",[["5:30","لَهُۥ"],["5:30","نَفۡسُهُۥ"],["5:30","قَتۡلَ"],["5:30","أَخِيهِ"],["5:30","فَقَتَلَهُۥ"],["5:30","فَأَصۡبَحَ"],["5:30","مِنَ"],["5:30","ٱلۡخَٰسِرِينَ"],["5:30","۝٣٠",1]]],["l",[["5:31","فَبَعَثَ"],["5:31","ٱللَّهُ"],["5:31","غُرَابࣰا"],["5:31","يَبۡحَثُ"],["5:31","فِي"],["5:31","ٱلۡأَرۡضِ"],["5:31","لِيُرِيَهُۥ"],["5:31","كَيۡفَ"],["5:31","يُوَٰرِي"]]],["l",[["5:31","سَوۡءَةَ"],["5:31","أَخِيهِۚ"],["5:31","قَالَ"],["5:31","يَٰوَيۡلَتَىٰٓ"],["5:31","أَعَجَزۡتُ"],["5:31","أَنۡ"],["5:31","أَكُونَ"],["5:31","مِثۡلَ"],["5:31","هَٰذَا"]]],["l",[["5:31","ٱلۡغُرَابِ"],["5:31","فَأُوَٰرِيَ"],["5:31","سَوۡءَةَ"],["5:31","أَخِيۖ"],["5:31","فَأَصۡبَحَ"],["5:31","مِنَ"],["5:31","ٱلنَّٰدِمِينَ"],["5:31","۝٣١",1]]]],"a":[[5,24,"قَالُوا۟ یَـٰمُوسَىٰۤ إِنَّا لَن نَّدۡخُلَهَاۤ أَبَدࣰا مَّا دَامُوا۟ فِیهَا فَٱذۡهَبۡ أَنتَ وَرَبُّكَ فَقَـٰتِلَاۤ إِنَّا هَـٰهُنَا قَـٰعِدُونَ"],[5,25,"قَالَ رَبِّ إِنِّی لَاۤ أَمۡلِكُ إِلَّا نَفۡسِی وَأَخِیۖ فَٱفۡرُقۡ بَیۡنَنَا وَبَیۡنَ ٱلۡقَوۡمِ ٱلۡفَـٰسِقِینَ"],[5,26,"قَالَ فَإِنَّهَا مُحَرَّمَةٌ عَلَیۡهِمۡۛ أَرۡبَعِینَ سَنَةࣰۛ یَتِیهُونَ فِی ٱلۡأَرۡضِۚ فَلَا تَأۡسَ عَلَى ٱلۡقَوۡمِ ٱلۡفَـٰسِقِینَ"],[5,27,"۞ وَٱتۡلُ عَلَیۡهِمۡ نَبَأَ ٱبۡنَیۡ ءَادَمَ بِٱلۡحَقِّ إِذۡ قَرَّبَا قُرۡبَانࣰا فَتُقُبِّلَ مِنۡ أَحَدِهِمَا وَلَمۡ یُتَقَبَّلۡ مِنَ ٱلۡءَاخَرِ قَالَ لَأَقۡتُلَنَّكَۖ قَالَ إِنَّمَا یَتَقَبَّلُ ٱللَّهُ مِنَ ٱلۡمُتَّقِینَ"],[5,28,"لَئِنۢ بَسَطتَ إِلَیَّ یَدَكَ لِتَقۡتُلَنِی مَاۤ أَنَا۠ بِبَاسِطࣲ یَدِیَ إِلَیۡكَ لِأَقۡتُلَكَۖ إِنِّیۤ أَخَافُ ٱللَّهَ رَبَّ ٱلۡعَـٰلَمِینَ"],[5,29,"إِنِّیۤ أُرِیدُ أَن تَبُوۤأَ بِإِثۡمِی وَإِثۡمِكَ فَتَكُونَ مِنۡ أَصۡحَـٰبِ ٱلنَّارِۚ وَذَٰلِكَ جَزَٰۤؤُا۟ ٱلظَّـٰلِمِینَ"],[5,30,"فَطَوَّعَتۡ لَهُۥ نَفۡسُهُۥ قَتۡلَ أَخِیهِ فَقَتَلَهُۥ فَأَصۡبَحَ مِنَ ٱلۡخَـٰسِرِینَ"],[5,31,"فَبَعَثَ ٱللَّهُ غُرَابࣰا یَبۡحَثُ فِی ٱلۡأَرۡضِ لِیُرِیَهُۥ كَیۡفَ یُوَٰرِی سَوۡءَةَ أَخِیهِۚ قَالَ یَـٰوَیۡلَتَىٰۤ أَعَجَزۡتُ أَنۡ أَكُونَ مِثۡلَ هَـٰذَا ٱلۡغُرَابِ فَأُوَٰرِیَ سَوۡءَةَ أَخِیۖ فَأَصۡبَحَ مِنَ ٱلنَّـٰدِمِینَ"]]}