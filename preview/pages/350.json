ن"],["24:6","لَّهُمۡ"],["24:6","شُهَدَآءُ"],["24:6","إِلَّآ"],["24:6","أَنفُسُهُمۡ"],["24:6","فَشَهَٰدَةُ"],["24:6","أَحَدِهِمۡ"],["24:6","أَرۡبَعُ"]]],["l",[["24:6","شَهَٰدَٰتِۭ"],["24:6","بِٱللَّهِ"],["24:6","إِنَّهُۥ"],["24:6","لَمِنَ"],["24:6","ٱلصَّٰدِقِينَ"],["24:6","۝٦",1],["24:7","وَٱلۡخَٰمِسَةُ"],["24:7","أَنَّ"],["24:7","لَعۡنَتَ"],["24:7","ٱللَّهِ"],["24:7","عَلَيۡهِ"]]],["l",[["24:7","إِن"],["24:7","كَانَ"],["24:7","مِنَ"],["24:7","ٱلۡكَٰذِبِينَ"],["24:7","۝٧",1],["24:8","وَيَدۡرَؤُاْ"],["24:8","عَنۡهَا"],["24:8","ٱلۡعَذَابَ"],["24:8","أَن"],["24:8","تَشۡهَدَ"],["24:8","أَرۡبَعَ"],["24:8","شَهَٰدَٰتِۭ"]]],["l",[["24:8","بِٱللَّهِ"],["24:8","إِنَّهُۥ"],["24:8","لَمِنَ"],["24:8","ٱلۡكَٰذِبِينَ"],["24:8","۝٨",1],["24:9","وَٱلۡخَٰمِسَةَ"],["24:9","أَنَّ"],["24:9","غَضَبَ"],["24:9","ٱللَّهِ"],["24:9","عَلَيۡهَآ"],["24:9","إِن"],["24:9","كَانَ"],["24:9","مِنَ"]]],["l",[["24:9","ٱلصَّٰدِقِينَ"],["24:9","۝٩",1],["24:10","وَلَوۡلَا"],["24:10","فَضۡلُ"],["24:10","ٱللَّهِ"],["24:10","عَلَيۡكُمۡ"],["24:10","وَرَحۡمَتُهُۥ"],["24:10","وَأَنَّ"],["24:10","ٱللَّهَ"],["24:10","تَوَّابٌ"],["24:10","حَكِيمٌ"],["24:10","۝١٠",1]]]],"a":[[24,1,"۞ سُورَةٌ أَنزَلۡنَـٰهَا وَفَرَضۡنَـٰهَا وَأَنزَلۡنَا فِیهَاۤ ءَایَـٰتِۭ بَیِّنَـٰتࣲ لَّعَلَّكُمۡ تَذَكَّرُونَ"],[24,2,"ٱلزَّانِیَةُ وَٱلزَّانِی فَٱجۡلِدُوا۟ كُلَّ وَٰحِدࣲ مِّنۡهُمَا مِا۟ئَةَ جَلۡدَةࣲۖ وَلَا تَأۡخُذۡكُم بِهِمَا رَأۡفَةࣱ فِی دِینِ ٱللَّهِ إِن كُنتُمۡ تُؤۡمِنُونَ بِٱللَّهِ وَٱلۡیَوۡمِ ٱلۡءَاخِرِۖ وَلۡیَشۡهَدۡ عَذَابَهُمَا طَاۤئِفَةࣱ مِّنَ ٱلۡمُؤۡمِنِینَ"],[24,3,"ٱلزَّانِی لَا یَنكِحُ إِلَّا زَانِیَةً أَوۡ مُشۡرِكَةࣰ وَٱلزَّانِیَةُ لَا یَنكِحُهَاۤ إِلَّا زَانٍ أَوۡ مُشۡرِكࣱۚ وَحُرِّمَ ذَٰلِكَ عَلَى ٱلۡمُؤۡمِنِینَ"],[24,4,"وَٱلَّذِینَ یَرۡمُونَ ٱلۡمُحۡصَنَـٰتِ ثُمَّ لَمۡ یَأۡتُوا۟ بِأَرۡبَعَةِ شُهَدَاۤءَ فَٱجۡلِدُوهُمۡ ثَمَـٰنِینَ جَلۡدَةࣰ وَلَا تَقۡبَلُوا۟ لَهُمۡ شَهَـٰدَةً أَبَدࣰاۚ وَأُو۟لَـٰۤئِكَ هُمُ ٱلۡفَـٰسِقُونَ"],[24,5,"إِلَّا ٱلَّذِینَ تَابُوا۟ مِنۢ بَعۡدِ ذَٰلِكَ وَأَصۡلَحُوا۟ فَإِنَّ ٱللَّهَ غَفُورࣱ رَّحِیمࣱ"],[24,6,"وَٱلَّذِینَ یَرۡمُونَ أَزۡوَٰجَهُمۡ وَلَمۡ یَكُن لَّهُمۡ شُهَدَاۤءُ إِلَّاۤ أَنفُسُهُمۡ فَشَهَـٰدَةُ أَحَدِهِمۡ أَرۡبَعُ شَهَـٰدَٰتِۭ بِٱللَّهِ إِنَّهُۥ لَمِنَ ٱلصَّـٰدِقِینَ"],[24,7,"وَٱلۡخَـٰمِسَةُ أَنَّ لَعۡنَتَ ٱللَّهِ عَلَیۡهِ إِن كَانَ مِنَ ٱلۡكَـٰذِبِینَ"],[24,8,"وَیَدۡرَؤُا۟ عَنۡهَا ٱلۡعَذَابَ أَن تَشۡهَدَ أَرۡبَعَ شَهَـٰدَٰتِۭ بِٱللَّهِ إِنَّهُۥ لَمِنَ ٱلۡكَـٰذِبِینَ"],[24,9,"وَٱلۡخَـٰمِسَةَ أَنَّ غَضَبَ ٱللَّهِ عَلَیۡهَاۤ إِن كَانَ مِنَ ٱلصَّـٰدِقِینَ"],[24,10,"وَلَوۡلَا فَضۡلُ ٱللَّهِ عَلَیۡكُمۡ وَرَحۡمَتُهُۥ وَأَنَّ ٱللَّهَ تَوَّابٌ حَكِیمٌ"]]}