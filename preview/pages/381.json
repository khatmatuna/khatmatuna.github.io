"],["27:52","ظَلَمُوٓاْۚ"],["27:52","إِنَّ"]]],["l",[["27:52","فِي"],["27:52","ذَٰلِكَ"],["27:52","لَأٓيَةࣰ"],["27:52","لِّقَوۡمࣲ"],["27:52","يَعۡلَمُونَ"],["27:52","۝٥٢",1],["27:53","وَأَنجَيۡنَا"],["27:53","ٱلَّذِينَ"],["27:53","ءَامَنُواْ"]]],["l",[["27:53","وَكَانُواْ"],["27:53","يَتَّقُونَ"],["27:53","۝٥٣",1],["27:54","وَلُوطًا"],["27:54","إِذۡ"],["27:54","قَالَ"],["27:54","لِقَوۡمِهِۦٓ"],["27:54","أَتَأۡتُونَ"]]],["l",[["27:54","ٱلۡفَٰحِشَةَ"],["27:54","وَأَنتُمۡ"],["27:54","تُبۡصِرُونَ"],["27:54","۝٥٤",1],["27:55","أَئِنَّكُمۡ"],["27:55","لَتَأۡتُونَ"],["27:55","ٱلرِّجَالَ"]]],["l",[["27:55","شَهۡوَةࣰ"],["27:55","مِّن"],["27:55","دُونِ"],["27:55","ٱلنِّسَآءِۚ"],["27:55","بَلۡ"],["27:55","أَنتُمۡ"],["27:55","قَوۡمࣱ"],["27:55","تَجۡهَلُونَ"],["27:55","۝٥٥",1]]]],"a":[[27,45,"وَلَقَدۡ أَرۡسَلۡنَاۤ إِلَىٰ ثَمُودَ أَخَاهُمۡ صَـٰلِحًا أَنِ ٱعۡبُدُوا۟ ٱللَّهَ فَإِذَا هُمۡ فَرِیقَانِ یَخۡتَصِمُونَ"],[27,46,"قَالَ یَـٰقَوۡمِ لِمَ تَسۡتَعۡجِلُونَ بِٱلسَّیِّئَةِ قَبۡلَ ٱلۡحَسَنَةِۖ لَوۡلَا تَسۡتَغۡفِرُونَ ٱللَّهَ لَعَلَّكُمۡ تُرۡحَمُونَ"],[27,47,"قَالُوا۟ ٱطَّیَّرۡنَا بِكَ وَبِمَن مَّعَكَۚ قَالَ طَـٰۤئِرُكُمۡ عِندَ ٱللَّهِۖ بَلۡ أَنتُمۡ قَوۡمࣱ تُفۡتَنُونَ"],[27,48,"وَكَانَ فِی ٱلۡمَدِینَةِ تِسۡعَةُ رَهۡطࣲ یُفۡسِدُونَ فِی ٱلۡأَرۡضِ وَلَا یُصۡلِحُونَ"],[27,49,"قَالُوا۟ تَقَاسَمُوا۟ بِٱللَّهِ لَنُبَیِّتَنَّهُۥ وَأَهۡلَهُۥ ثُمَّ لَنَقُولَنَّ لِوَلِیِّهِۦ مَا شَهِدۡنَا مَهۡلِكَ أَهۡلِهِۦ وَإِنَّا لَصَـٰدِقُونَ"],[27,50,"وَمَكَرُوا۟ مَكۡرࣰا وَمَكَرۡنَا مَكۡرࣰا وَهُمۡ لَا یَشۡعُرُونَ"],[27,51,"فَٱنظُرۡ كَیۡفَ كَانَ عَـٰقِبَةُ مَكۡرِهِمۡ أَنَّا دَمَّرۡنَـٰهُمۡ وَقَوۡمَهُمۡ أَجۡمَعِینَ"],[27,52,"فَتِلۡكَ بُیُوتُهُمۡ خَاوِیَةَۢ بِمَا ظَلَمُوۤا۟ۚ إِنَّ فِی ذَٰلِكَ لَءَایَةࣰ لِّقَوۡمࣲ یَعۡلَمُونَ"],[27,53,"وَأَنجَیۡنَا ٱلَّذِینَ ءَامَنُوا۟ وَكَانُوا۟ یَتَّقُونَ"],[27,54,"وَلُوطًا إِذۡ قَالَ لِقَوۡمِهِۦۤ أَتَأۡتُونَ ٱلۡفَـٰحِشَةَ وَأَنتُمۡ تُبۡصِرُونَ"],[27,55,"أَئِنَّكُمۡ لَتَأۡتُونَ ٱلرِّجَالَ شَهۡوَةࣰ مِّن دُونِ ٱلنِّسَاۤءِۚ بَلۡ أَنتُمۡ قَوۡمࣱ تَجۡهَلُونَ"]]}