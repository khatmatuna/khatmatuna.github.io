["34:6","ٱلَّذِيٓ"],["34:6","أُنزِلَ"],["34:6","إِلَيۡكَ"],["34:6","مِن"],["34:6","رَّبِّكَ"],["34:6","هُوَ"],["34:6","ٱلۡحَقَّ"],["34:6","وَيَهۡدِيٓ"],["34:6","إِلَىٰ"],["34:6","صِرَٰطِ"]]],["l",[["34:6","ٱلۡعَزِيزِ"],["34:6","ٱلۡحَمِيدِ"],["34:6","۝٦",1],["34:7","وَقَالَ"],["34:7","ٱلَّذِينَ"],["34:7","كَفَرُواْ"],["34:7","هَلۡ"],["34:7","نَدُلُّكُمۡ"],["34:7","عَلَىٰ"],["34:7","رَجُلࣲ"]]],["l",[["34:7","يُنَبِّئُكُمۡ"],["34:7","إِذَا"],["34:7","مُزِّقۡتُمۡ"],["34:7","كُلَّ"],["34:7","مُمَزَّقٍ"],["34:7","إِنَّكُمۡ"],["34:7","لَفِي"],["34:7","خَلۡقࣲ"],["34:7","جَدِيدٍ"],["34:7","۝٧",1]]]],"a":[[34,1,"ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِی لَهُۥ مَا فِی ٱلسَّمَـٰوَٰتِ وَمَا فِی ٱلۡأَرۡضِ وَلَهُ ٱلۡحَمۡدُ فِی ٱلۡءَاخِرَةِۚ وَهُوَ ٱلۡحَكِیمُ ٱلۡخَبِیرُ"],[34,2,"یَعۡلَمُ مَا یَلِجُ فِی ٱلۡأَرۡضِ وَمَا یَخۡرُجُ مِنۡهَا وَمَا یَنزِلُ مِنَ ٱلسَّمَاۤءِ وَمَا یَعۡرُجُ فِیهَاۚ وَهُوَ ٱلرَّحِیمُ ٱلۡغَفُورُ"],[34,3,"وَقَالَ ٱلَّذِینَ كَفَرُوا۟ لَا تَأۡتِینَا ٱلسَّاعَةُۖ قُلۡ بَلَىٰ وَرَبِّی لَتَأۡتِیَنَّكُمۡ عَـٰلِمِ ٱلۡغَیۡبِۖ لَا یَعۡزُبُ عَنۡهُ مِثۡقَالُ ذَرَّةࣲ فِی ٱلسَّمَـٰوَٰتِ وَلَا فِی ٱلۡأَرۡضِ وَلَاۤ أَصۡغَرُ مِن ذَٰلِكَ وَلَاۤ أَكۡبَرُ إِلَّا فِی كِتَـٰبࣲ مُّبِینࣲ"],[34,4,"لِّیَجۡزِیَ ٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِۚ أُو۟لَـٰۤئِكَ لَهُم مَّغۡفِرَةࣱ وَرِزۡقࣱ كَرِیمࣱ"],[34,5,"وَٱلَّذِینَ سَعَوۡ فِیۤ ءَایَـٰتِنَا مُعَـٰجِزِینَ أُو۟لَـٰۤئِكَ لَهُمۡ عَذَابࣱ مِّن رِّجۡزٍ أَلِیمࣱ"],[34,6,"وَیَرَى ٱلَّذِینَ أُوتُوا۟ ٱلۡعِلۡمَ ٱلَّذِیۤ أُنزِلَ إِلَیۡكَ مِن رَّبِّكَ هُوَ ٱلۡحَقَّ وَیَهۡدِیۤ إِلَىٰ صِرَٰطِ ٱلۡعَزِیزِ ٱلۡحَمِیدِ"],[34,7,"وَقَالَ ٱلَّذِینَ كَفَرُوا۟ هَلۡ نَدُلُّكُمۡ عَلَىٰ رَجُلࣲ یُنَبِّئُكُمۡ إِذَا مُزِّقۡتُمۡ كُلَّ مُمَزَّقٍ إِنَّكُمۡ لَفِی خَلۡقࣲ جَدِیدٍ"]]}