2:10","إِن"],["12:10","كُنتُمۡ"],["12:10","فَٰعِلِينَ"],["12:10","۝١٠",1],["12:11","قَالُواْ"],["12:11","يَٰٓأَبَانَا"],["12:11","مَا"],["12:11","لَكَ"],["12:11","لَا"],["12:11","تَأۡمَ۬نَّا"],["12:11","عَلَىٰ"]]],["l",[["12:11","يُوسُفَ"],["12:11","وَإِنَّا"],["12:11","لَهُۥ"],["12:11","لَنَٰصِحُونَ"],["12:11","۝١١",1],["12:12","أَرۡسِلۡهُ"],["12:12","مَعَنَا"],["12:12","غَدࣰا"],["12:12","يَرۡتَعۡ"],["12:12","وَيَلۡعَبۡ"]]],["l",[["12:12","وَإِنَّا"],["12:12","لَهُۥ"],["12:12","لَحَٰفِظُونَ"],["12:12","۝١٢",1],["12:13","قَالَ"],["12:13","إِنِّي"],["12:13","لَيَحۡزُنُنِيٓ"],["12:13","أَن"],["12:13","تَذۡهَبُواْ"],["12:13","بِهِۦ"],["12:13","وَأَخَافُ"]]],["l",[["12:13","أَن"],["12:13","يَأۡكُلَهُ"],["12:13","ٱلذِّئۡبُ"],["12:13","وَأَنتُمۡ"],["12:13","عَنۡهُ"],["12:13","غَٰفِلُونَ"],["12:13","۝١٣",1],["12:14","قَالُواْ"],["12:14","لَئِنۡ"]]],["l",[["12:14","أَكَلَهُ"],["12:14","ٱلذِّئۡبُ"],["12:14","وَنَحۡنُ"],["12:14","عُصۡبَةٌ"],["12:14","إِنَّآ"],["12:14","إِذࣰا"],["12:14","لَّخَٰسِرُونَ"],["12:14","۝١٤",1]]]],"a":[[12,5,"قَالَ یَـٰبُنَیَّ لَا تَقۡصُصۡ رُءۡیَاكَ عَلَىٰۤ إِخۡوَتِكَ فَیَكِیدُوا۟ لَكَ كَیۡدًاۖ إِنَّ ٱلشَّیۡطَـٰنَ لِلۡإِنسَـٰنِ عَدُوࣱّ مُّبِینࣱ"],[12,6,"وَكَذَٰلِكَ یَجۡتَبِیكَ رَبُّكَ وَیُعَلِّمُكَ مِن تَأۡوِیلِ ٱلۡأَحَادِیثِ وَیُتِمُّ نِعۡمَتَهُۥ عَلَیۡكَ وَعَلَىٰۤ ءَالِ یَعۡقُوبَ كَمَاۤ أَتَمَّهَا عَلَىٰۤ أَبَوَیۡكَ مِن قَبۡلُ إِبۡرَٰهِیمَ وَإِسۡحَـٰقَۚ إِنَّ رَبَّكَ عَلِیمٌ حَكِیمࣱ"],[12,7,"۞ لَّقَدۡ كَانَ فِی یُوسُفَ وَإِخۡوَتِهِۦۤ ءَایَـٰتࣱ لِّلسَّاۤئِلِینَ"],[12,8,"إِذۡ قَالُوا۟ لَیُوسُفُ وَأَخُوهُ أَحَبُّ إِلَىٰۤ أَبِینَا مِنَّا وَنَحۡنُ عُصۡبَةٌ إِنَّ أَبَانَا لَفِی ضَلَـٰلࣲ مُّبِینٍ"],[12,9,"ٱقۡتُلُوا۟ یُوسُفَ أَوِ ٱطۡرَحُوهُ أَرۡضࣰا یَخۡلُ لَكُمۡ وَجۡهُ أَبِیكُمۡ وَتَكُونُوا۟ مِنۢ بَعۡدِهِۦ قَوۡمࣰا صَـٰلِحِینَ"],[12,10,"قَالَ قَاۤئِلࣱ مِّنۡهُمۡ لَا تَقۡتُلُوا۟ یُوسُفَ وَأَلۡقُوهُ فِی غَیَـٰبَتِ ٱلۡجُبِّ یَلۡتَقِطۡهُ بَعۡضُ ٱلسَّیَّارَةِ إِن كُنتُمۡ فَـٰعِلِینَ"],[12,11,"قَالُوا۟ یَـٰۤأَبَانَا مَالَكَ لَا تَأۡمَـ۫نَّا عَلَىٰ یُوسُفَ وَإِنَّا لَهُۥ لَنَـٰصِحُونَ"],[12,12,"أَرۡسِلۡهُ مَعَنَا غَدࣰا یَرۡتَعۡ وَیَلۡعَبۡ وَإِنَّا لَهُۥ لَحَـٰفِظُونَ"],[12,13,"قَالَ إِنِّی لَیَحۡزُنُنِیۤ أَن تَذۡهَبُوا۟ بِهِۦ وَأَخَافُ أَن یَأۡكُلَهُ ٱلذِّئۡبُ وَأَنتُمۡ عَنۡهُ غَـٰفِلُونَ"],[12,14,"قَالُوا۟ لَئِنۡ أَكَلَهُ ٱلذِّئۡبُ وَنَحۡنُ عُصۡبَةٌ إِنَّاۤ إِذࣰا لَّخَـٰسِرُونَ"]]}