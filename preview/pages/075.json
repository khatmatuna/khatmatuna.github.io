","إِنَّكَ"],["3:192","مَن"],["3:192","تُدۡخِلِ"],["3:192","ٱلنَّارَ"],["3:192","فَقَدۡ"],["3:192","أَخۡزَيۡتَهُۥۖ"],["3:192","وَمَا"],["3:192","لِلظَّٰلِمِينَ"],["3:192","مِنۡ"]]],["l",[["3:192","أَنصَارࣲ"],["3:192","۝١٩٢",1],["3:193","رَّبَّنَآ"],["3:193","إِنَّنَا"],["3:193","سَمِعۡنَا"],["3:193","مُنَادِيࣰا"],["3:193","يُنَادِي"],["3:193","لِلۡإِيمَٰنِ"],["3:193","أَنۡ"]]],["l",[["3:193","ءَامِنُواْ"],["3:193","بِرَبِّكُمۡ"],["3:193","فَـَٔامَنَّاۚ"],["3:193","رَبَّنَا"],["3:193","فَٱغۡفِرۡ"],["3:193","لَنَا"],["3:193","ذُنُوبَنَا"],["3:193","وَكَفِّرۡ"],["3:193","عَنَّا"]]],["l",[["3:193","سَيِّـَٔاتِنَا"],["3:193","وَتَوَفَّنَا"],["3:193","مَعَ"],["3:193","ٱلۡأَبۡرَارِ"],["3:193","۝١٩٣",1],["3:194","رَبَّنَا"],["3:194","وَءَاتِنَا"],["3:194","مَا"],["3:194","وَعَدتَّنَا"],["3:194","عَلَىٰ"]]],["l",[["3:194","رُسُلِكَ"],["3:194","وَلَا"],["3:194","تُخۡزِنَا"],["3:194","يَوۡمَ"],["3:194","ٱلۡقِيَٰمَةِۖ"],["3:194","إِنَّكَ"],["3:194","لَا"],["3:194","تُخۡلِفُ"],["3:194","ٱلۡمِيعَادَ"],["3:194","۝١٩٤",1]]]],"a":[[3,187,"وَإِذۡ أَخَذَ ٱللَّهُ مِیثَـٰقَ ٱلَّذِینَ أُوتُوا۟ ٱلۡكِتَـٰبَ لَتُبَیِّنُنَّهُۥ لِلنَّاسِ وَلَا تَكۡتُمُونَهُۥ فَنَبَذُوهُ وَرَاۤءَ ظُهُورِهِمۡ وَٱشۡتَرَوۡا۟ بِهِۦ ثَمَنࣰا قَلِیلࣰاۖ فَبِئۡسَ مَا یَشۡتَرُونَ"],[3,188,"لَا تَحۡسَبَنَّ ٱلَّذِینَ یَفۡرَحُونَ بِمَاۤ أَتَوا۟ وَّیُحِبُّونَ أَن یُحۡمَدُوا۟ بِمَا لَمۡ یَفۡعَلُوا۟ فَلَا تَحۡسَبَنَّهُم بِمَفَازَةࣲ مِّنَ ٱلۡعَذَابِۖ وَلَهُمۡ عَذَابٌ أَلِیمࣱ"],[3,189,"وَلِلَّهِ مُلۡكُ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِۗ وَٱللَّهُ عَلَىٰ كُلِّ شَیۡءࣲ قَدِیرٌ"],[3,190,"إِنَّ فِی خَلۡقِ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِ وَٱخۡتِلَـٰفِ ٱلَّیۡلِ وَٱلنَّهَارِ لَءَایَـٰتࣲ لِّأُو۟لِی ٱلۡأَلۡبَـٰبِ"],[3,191,"ٱلَّذِینَ یَذۡكُرُونَ ٱللَّهَ قِیَـٰمࣰا وَقُعُودࣰا وَعَلَىٰ جُنُوبِهِمۡ وَیَتَفَكَّرُونَ فِی خَلۡقِ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِ رَبَّنَا مَا خَلَقۡتَ هَـٰذَا بَـٰطِلࣰا سُبۡحَـٰنَكَ فَقِنَا عَذَابَ ٱلنَّارِ"],[3,192,"رَبَّنَاۤ إِنَّكَ مَن تُدۡخِلِ ٱلنَّارَ فَقَدۡ أَخۡزَیۡتَهُۥۖ وَمَا لِلظَّـٰلِمِینَ مِنۡ أَنصَارࣲ"],[3,193,"رَّبَّنَاۤ إِنَّنَا سَمِعۡنَا مُنَادِیࣰا یُنَادِی لِلۡإِیمَـٰنِ أَنۡ ءَامِنُوا۟ بِرَبِّكُمۡ فَءَامَنَّاۚ رَبَّنَا فَٱغۡفِرۡ لَنَا ذُنُوبَنَا وَكَفِّرۡ عَنَّا سَیِّءَاتِنَا وَتَوَفَّنَا مَعَ ٱلۡأَبۡرَارِ"],[3,194,"رَبَّنَا وَءَاتِنَا مَا وَعَدتَّنَا عَلَىٰ رُسُلِكَ وَلَا تُخۡزِنَا یَوۡمَ ٱلۡقِیَـٰمَةِۖ إِنَّكَ لَا تُخۡلِفُ ٱلۡمِیعَادَ"]]}