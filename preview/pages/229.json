:68","بُعۡدࣰا"],["11:68","لِّثَمُودَ"],["11:68","۝٦٨",1],["11:69","وَلَقَدۡ"],["11:69","جَآءَتۡ"],["11:69","رُسُلُنَآ"],["11:69","إِبۡرَٰهِيمَ"],["11:69","بِٱلۡبُشۡرَىٰ"],["11:69","قَالُواْ"]]],["l",[["11:69","سَلَٰمࣰاۖ"],["11:69","قَالَ"],["11:69","سَلَٰمࣱۖ"],["11:69","فَمَا"],["11:69","لَبِثَ"],["11:69","أَن"],["11:69","جَآءَ"],["11:69","بِعِجۡلٍ"],["11:69","حَنِيذࣲ"],["11:69","۝٦٩",1],["11:70","فَلَمَّا"],["11:70","رَءَآ"]]],["l",[["11:70","أَيۡدِيَهُمۡ"],["11:70","لَا"],["11:70","تَصِلُ"],["11:70","إِلَيۡهِ"],["11:70","نَكِرَهُمۡ"],["11:70","وَأَوۡجَسَ"],["11:70","مِنۡهُمۡ"],["11:70","خِيفَةࣰۚ"]]],["l",[["11:70","قَالُواْ"],["11:70","لَا"],["11:70","تَخَفۡ"],["11:70","إِنَّآ"],["11:70","أُرۡسِلۡنَآ"],["11:70","إِلَىٰ"],["11:70","قَوۡمِ"],["11:70","لُوطࣲ"],["11:70","۝٧٠",1],["11:71","وَٱمۡرَأَتُهُۥ"],["11:71","قَآئِمَةࣱ"]]],["l",[["11:71","فَضَحِكَتۡ"],["11:71","فَبَشَّرۡنَٰهَا"],["11:71","بِإِسۡحَٰقَ"],["11:71","وَمِن"],["11:71","وَرَآءِ"],["11:71","إِسۡحَٰقَ"],["11:71","يَعۡقُوبَ"],["11:71","۝٧١",1]]]],"a":[[11,63,"قَالَ یَـٰقَوۡمِ أَرَءَیۡتُمۡ إِن كُنتُ عَلَىٰ بَیِّنَةࣲ مِّن رَّبِّی وَءَاتَىٰنِی مِنۡهُ رَحۡمَةࣰ فَمَن یَنصُرُنِی مِنَ ٱللَّهِ إِنۡ عَصَیۡتُهُۥۖ فَمَا تَزِیدُونَنِی غَیۡرَ تَخۡسِیرࣲ"],[11,64,"وَیَـٰقَوۡمِ هَـٰذِهِۦ نَاقَةُ ٱللَّهِ لَكُمۡ ءَایَةࣰۖ فَذَرُوهَا تَأۡكُلۡ فِیۤ أَرۡضِ ٱللَّهِۖ وَلَا تَمَسُّوهَا بِسُوۤءࣲ فَیَأۡخُذَكُمۡ عَذَابࣱ قَرِیبࣱ"],[11,65,"فَعَقَرُوهَا فَقَالَ تَمَتَّعُوا۟ فِی دَارِكُمۡ ثَلَـٰثَةَ أَیَّامࣲۖ ذَٰلِكَ وَعۡدٌ غَیۡرُ مَكۡذُوبࣲ"],[11,66,"فَلَمَّا جَاۤءَ أَمۡرُنَا نَجَّیۡنَا صَـٰلِحࣰا وَٱلَّذِینَ ءَامَنُوا۟ مَعَهُۥ بِرَحۡمَةࣲ مِّنَّا وَمِنۡ خِزۡیِ یَوۡمِئِذٍۚ إِنَّ رَبَّكَ هُوَ ٱلۡقَوِیُّ ٱلۡعَزِیزُ"],[11,67,"وَأَخَذَ ٱلَّذِینَ ظَلَمُوا۟ ٱلصَّیۡحَةُ فَأَصۡبَحُوا۟ فِی دِیَـٰرِهِمۡ جَـٰثِمِینَ"],[11,68,"كَأَن لَّمۡ یَغۡنَوۡا۟ فِیهَاۤۗ أَلَاۤ إِنَّ ثَمُودَا۟ كَفَرُوا۟ رَبَّهُمۡۗ أَلَا بُعۡدࣰا لِّثَمُودَ"],[11,69,"وَلَقَدۡ جَاۤءَتۡ رُسُلُنَاۤ إِبۡرَٰهِیمَ بِٱلۡبُشۡرَىٰ قَالُوا۟ سَلَـٰمࣰاۖ قَالَ سَلَـٰمࣱۖ فَمَا لَبِثَ أَن جَاۤءَ بِعِجۡلٍ حَنِیذࣲ"],[11,70,"فَلَمَّا رَءَاۤ أَیۡدِیَهُمۡ لَا تَصِلُ إِلَیۡهِ نَكِرَهُمۡ وَأَوۡجَسَ مِنۡهُمۡ خِیفَةࣰۚ قَالُوا۟ لَا تَخَفۡ إِنَّاۤ أُرۡسِلۡنَاۤ إِلَىٰ قَوۡمِ لُوطࣲ"],[11,71,"وَٱمۡرَأَتُهُۥ قَاۤئِمَةࣱ فَضَحِكَتۡ فَبَشَّرۡنَـٰهَا بِإِسۡحَـٰقَ وَمِن وَرَاۤءِ إِسۡحَـٰقَ یَعۡقُوبَ"]]}