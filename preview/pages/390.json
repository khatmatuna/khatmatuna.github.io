"أَئِمَّةࣰ"],["28:41","يَدۡعُونَ"],["28:41","إِلَى"],["28:41","ٱلنَّارِۖ"],["28:41","وَيَوۡمَ"],["28:41","ٱلۡقِيَٰمَةِ"]]],["l",[["28:41","لَا"],["28:41","يُنصَرُونَ"],["28:41","۝٤١",1],["28:42","وَأَتۡبَعۡنَٰهُمۡ"],["28:42","فِي"],["28:42","هَٰذِهِ"],["28:42","ٱلدُّنۡيَا"],["28:42","لَعۡنَةࣰۖ"]]],["l",[["28:42","وَيَوۡمَ"],["28:42","ٱلۡقِيَٰمَةِ"],["28:42","هُم"],["28:42","مِّنَ"],["28:42","ٱلۡمَقۡبُوحِينَ"],["28:42","۝٤٢",1],["28:43","وَلَقَدۡ"],["28:43","ءَاتَيۡنَا"]]],["l",[["28:43","مُوسَى"],["28:43","ٱلۡكِتَٰبَ"],["28:43","مِنۢ"],["28:43","بَعۡدِ"],["28:43","مَآ"],["28:43","أَهۡلَكۡنَا"],["28:43","ٱلۡقُرُونَ"],["28:43","ٱلۡأُولَىٰ"]]],["l",[["28:43","بَصَآئِرَ"],["28:43","لِلنَّاسِ"],["28:43","وَهُدࣰى"],["28:43","وَرَحۡمَةࣰ"],["28:43","لَّعَلَّهُمۡ"],["28:43","يَتَذَكَّرُونَ"],["28:43","۝٤٣",1]]]],"a":[[28,36,"فَلَمَّا جَاۤءَهُم مُّوسَىٰ بِءَایَـٰتِنَا بَیِّنَـٰتࣲ قَالُوا۟ مَا هَـٰذَاۤ إِلَّا سِحۡرࣱ مُّفۡتَرࣰى وَمَا سَمِعۡنَا بِهَـٰذَا فِیۤ ءَابَاۤئِنَا ٱلۡأَوَّلِینَ"],[28,37,"وَقَالَ مُوسَىٰ رَبِّیۤ أَعۡلَمُ بِمَن جَاۤءَ بِٱلۡهُدَىٰ مِنۡ عِندِهِۦ وَمَن تَكُونُ لَهُۥ عَـٰقِبَةُ ٱلدَّارِۚ إِنَّهُۥ لَا یُفۡلِحُ ٱلظَّـٰلِمُونَ"],[28,38,"وَقَالَ فِرۡعَوۡنُ یَـٰۤأَیُّهَا ٱلۡمَلَأُ مَا عَلِمۡتُ لَكُم مِّنۡ إِلَـٰهٍ غَیۡرِی فَأَوۡقِدۡ لِی یَـٰهَـٰمَـٰنُ عَلَى ٱلطِّینِ فَٱجۡعَل لِّی صَرۡحࣰا لَّعَلِّیۤ أَطَّلِعُ إِلَىٰۤ إِلَـٰهِ مُوسَىٰ وَإِنِّی لَأَظُنُّهُۥ مِنَ ٱلۡكَـٰذِبِینَ"],[28,39,"وَٱسۡتَكۡبَرَ هُوَ وَجُنُودُهُۥ فِی ٱلۡأَرۡضِ بِغَیۡرِ ٱلۡحَقِّ وَظَنُّوۤا۟ أَنَّهُمۡ إِلَیۡنَا لَا یُرۡجَعُونَ"],[28,40,"فَأَخَذۡنَـٰهُ وَجُنُودَهُۥ فَنَبَذۡنَـٰهُمۡ فِی ٱلۡیَمِّۖ فَٱنظُرۡ كَیۡفَ كَانَ عَـٰقِبَةُ ٱلظَّـٰلِمِینَ"],[28,41,"وَجَعَلۡنَـٰهُمۡ أَئِمَّةࣰ یَدۡعُونَ إِلَى ٱلنَّارِۖ وَیَوۡمَ ٱلۡقِیَـٰمَةِ لَا یُنصَرُونَ"],[28,42,"وَأَتۡبَعۡنَـٰهُمۡ فِی هَـٰذِهِ ٱلدُّنۡیَا لَعۡنَةࣰۖ وَیَوۡمَ ٱلۡقِیَـٰمَةِ هُم مِّنَ ٱلۡمَقۡبُوحِینَ"],[28,43,"وَلَقَدۡ ءَاتَیۡنَا مُوسَى ٱلۡكِتَـٰبَ مِنۢ بَعۡدِ مَاۤ أَهۡلَكۡنَا ٱلۡقُرُونَ ٱلۡأُولَىٰ بَصَاۤئِرَ لِلنَّاسِ وَهُدࣰى وَرَحۡمَةࣰ لَّعَلَّهُمۡ یَتَذَكَّرُونَ"]]}