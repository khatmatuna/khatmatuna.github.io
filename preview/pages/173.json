7:176","أَخۡلَدَ"],["7:176","إِلَى"],["7:176","ٱلۡأَرۡضِ"],["7:176","وَٱتَّبَعَ"],["7:176","هَوَىٰهُۚ"],["7:176","فَمَثَلُهُۥ"]]],["l",[["7:176","كَمَثَلِ"],["7:176","ٱلۡكَلۡبِ"],["7:176","إِن"],["7:176","تَحۡمِلۡ"],["7:176","عَلَيۡهِ"],["7:176","يَلۡهَثۡ"],["7:176","أَوۡ"],["7:176","تَتۡرُكۡهُ"]]],["l",[["7:176","يَلۡهَثۚ"],["7:176","ذَّٰلِكَ"],["7:176","مَثَلُ"],["7:176","ٱلۡقَوۡمِ"],["7:176","ٱلَّذِينَ"],["7:176","كَذَّبُواْ"],["7:176","بِـَٔايَٰتِنَاۚ"],["7:176","فَٱقۡصُصِ"]]],["l",[["7:176","ٱلۡقَصَصَ"],["7:176","لَعَلَّهُمۡ"],["7:176","يَتَفَكَّرُونَ"],["7:176","۝١٧٦",1],["7:177","سَآءَ"],["7:177","مَثَلًا"],["7:177","ٱلۡقَوۡمُ"],["7:177","ٱلَّذِينَ"]]],["l",[["7:177","كَذَّبُواْ"],["7:177","بِـَٔايَٰتِنَا"],["7:177","وَأَنفُسَهُمۡ"],["7:177","كَانُواْ"],["7:177","يَظۡلِمُونَ"],["7:177","۝١٧٧",1],["7:178","مَن"],["7:178","يَهۡدِ"],["7:178","ٱللَّهُ"]]],["l",[["7:178","فَهُوَ"],["7:178","ٱلۡمُهۡتَدِيۖ"],["7:178","وَمَن"],["7:178","يُضۡلِلۡ"],["7:178","فَأُوْلَٰٓئِكَ"],["7:178","هُمُ"],["7:178","ٱلۡخَٰسِرُونَ"],["7:178","۝١٧٨",1]]]],"a":[[7,171,"۞ وَإِذۡ نَتَقۡنَا ٱلۡجَبَلَ فَوۡقَهُمۡ كَأَنَّهُۥ ظُلَّةࣱ وَظَنُّوۤا۟ أَنَّهُۥ وَاقِعُۢ بِهِمۡ خُذُوا۟ مَاۤ ءَاتَیۡنَـٰكُم بِقُوَّةࣲ وَٱذۡكُرُوا۟ مَا فِیهِ لَعَلَّكُمۡ تَتَّقُونَ"],[7,172,"وَإِذۡ أَخَذَ رَبُّكَ مِنۢ بَنِیۤ ءَادَمَ مِن ظُهُورِهِمۡ ذُرِّیَّتَهُمۡ وَأَشۡهَدَهُمۡ عَلَىٰۤ أَنفُسِهِمۡ أَلَسۡتُ بِرَبِّكُمۡۖ قَالُوا۟ بَلَىٰ شَهِدۡنَاۤۚ أَن تَقُولُوا۟ یَوۡمَ ٱلۡقِیَـٰمَةِ إِنَّا كُنَّا عَنۡ هَـٰذَا غَـٰفِلِینَ"],[7,173,"أَوۡ تَقُولُوۤا۟ إِنَّمَاۤ أَشۡرَكَ ءَابَاۤؤُنَا مِن قَبۡلُ وَكُنَّا ذُرِّیَّةࣰ مِّنۢ بَعۡدِهِمۡۖ أَفَتُهۡلِكُنَا بِمَا فَعَلَ ٱلۡمُبۡطِلُونَ"],[7,174,"وَكَذَٰلِكَ نُفَصِّلُ ٱلۡءَایَـٰتِ وَلَعَلَّهُمۡ یَرۡجِعُونَ"],[7,175,"وَٱتۡلُ عَلَیۡهِمۡ نَبَأَ ٱلَّذِیۤ ءَاتَیۡنَـٰهُ ءَایَـٰتِنَا فَٱنسَلَخَ مِنۡهَا فَأَتۡبَعَهُ ٱلشَّیۡطَـٰنُ فَكَانَ مِنَ ٱلۡغَاوِینَ"],[7,176,"وَلَوۡ شِئۡنَا لَرَفَعۡنَـٰهُ بِهَا وَلَـٰكِنَّهُۥۤ أَخۡلَدَ إِلَى ٱلۡأَرۡضِ وَٱتَّبَعَ هَوَىٰهُۚ فَمَثَلُهُۥ كَمَثَلِ ٱلۡكَلۡبِ إِن تَحۡمِلۡ عَلَیۡهِ یَلۡهَثۡ أَوۡ تَتۡرُكۡهُ یَلۡهَثۚ ذَّٰلِكَ مَثَلُ ٱلۡقَوۡمِ ٱلَّذِینَ كَذَّبُوا۟ بِءَایَـٰتِنَاۚ فَٱقۡصُصِ ٱلۡقَصَصَ لَعَلَّهُمۡ یَتَفَكَّرُونَ"],[7,177,"سَاۤءَ مَثَلًا ٱلۡقَوۡمُ ٱلَّذِینَ كَذَّبُوا۟ بِءَایَـٰتِنَا وَأَنفُسَهُمۡ كَانُوا۟ یَظۡلِمُونَ"],[7,178,"مَن یَهۡدِ ٱللَّهُ فَهُوَ ٱلۡمُهۡتَدِیۖ وَمَن یُضۡلِلۡ فَأُو۟لَـٰۤئِكَ هُمُ ٱلۡخَـٰسِرُونَ"]]}