ِ"]]],["l",[["7:42","لَا"],["7:42","نُكَلِّفُ"],["7:42","نَفۡسًا"],["7:42","إِلَّا"],["7:42","وُسۡعَهَآ"],["7:42","أُوْلَٰٓئِكَ"],["7:42","أَصۡحَٰبُ"],["7:42","ٱلۡجَنَّةِۖ"],["7:42","هُمۡ"]]],["l",[["7:42","فِيهَا"],["7:42","خَٰلِدُونَ"],["7:42","۝٤٢",1],["7:43","وَنَزَعۡنَا"],["7:43","مَا"],["7:43","فِي"],["7:43","صُدُورِهِم"],["7:43","مِّنۡ"],["7:43","غِلࣲّ"],["7:43","تَجۡرِي"]]],["l",[["7:43","مِن"],["7:43","تَحۡتِهِمُ"],["7:43","ٱلۡأَنۡهَٰرُۖ"],["7:43","وَقَالُواْ"],["7:43","ٱلۡحَمۡدُ"],["7:43","لِلَّهِ"],["7:43","ٱلَّذِي"],["7:43","هَدَىٰنَا"],["7:43","لِهَٰذَا"],["7:43","وَمَا"],["7:43","كُنَّا"]]],["l",[["7:43","لِنَهۡتَدِيَ"],["7:43","لَوۡلَآ"],["7:43","أَنۡ"],["7:43","هَدَىٰنَا"],["7:43","ٱللَّهُۖ"],["7:43","لَقَدۡ"],["7:43","جَآءَتۡ"],["7:43","رُسُلُ"],["7:43","رَبِّنَا"],["7:43","بِٱلۡحَقِّۖ"]]],["l",[["7:43","وَنُودُوٓاْ"],["7:43","أَن"],["7:43","تِلۡكُمُ"],["7:43","ٱلۡجَنَّةُ"],["7:43","أُورِثۡتُمُوهَا"],["7:43","بِمَا"],["7:43","كُنتُمۡ"],["7:43","تَعۡمَلُونَ"],["7:43","۝٤٣",1]]]],"a":[[7,38,"قَالَ ٱدۡخُلُوا۟ فِیۤ أُمَمࣲ قَدۡ خَلَتۡ مِن قَبۡلِكُم مِّنَ ٱلۡجِنِّ وَٱلۡإِنسِ فِی ٱلنَّارِۖ كُلَّمَا دَخَلَتۡ أُمَّةࣱ لَّعَنَتۡ أُخۡتَهَاۖ حَتَّىٰۤ إِذَا ٱدَّارَكُوا۟ فِیهَا جَمِیعࣰا قَالَتۡ أُخۡرَىٰهُمۡ لِأُولَىٰهُمۡ رَبَّنَا هَـٰۤؤُلَاۤءِ أَضَلُّونَا فَءَاتِهِمۡ عَذَابࣰا ضِعۡفࣰا مِّنَ ٱلنَّارِۖ قَالَ لِكُلࣲّ ضِعۡفࣱ وَلَـٰكِن لَّا تَعۡلَمُونَ"],[7,39,"وَقَالَتۡ أُولَىٰهُمۡ لِأُخۡرَىٰهُمۡ فَمَا كَانَ لَكُمۡ عَلَیۡنَا مِن فَضۡلࣲ فَذُوقُوا۟ ٱلۡعَذَابَ بِمَا كُنتُمۡ تَكۡسِبُونَ"],[7,40,"إِنَّ ٱلَّذِینَ كَذَّبُوا۟ بِءَایَـٰتِنَا وَٱسۡتَكۡبَرُوا۟ عَنۡهَا لَا تُفَتَّحُ لَهُمۡ أَبۡوَٰبُ ٱلسَّمَاۤءِ وَلَا یَدۡخُلُونَ ٱلۡجَنَّةَ حَتَّىٰ یَلِجَ ٱلۡجَمَلُ فِی سَمِّ ٱلۡخِیَاطِۚ وَكَذَٰلِكَ نَجۡزِی ٱلۡمُجۡرِمِینَ"],[7,41,"لَهُم مِّن جَهَنَّمَ مِهَادࣱ وَمِن فَوۡقِهِمۡ غَوَاشࣲۚ وَكَذَٰلِكَ نَجۡزِی ٱلظَّـٰلِمِینَ"],[7,42,"وَٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَا نُكَلِّفُ نَفۡسًا إِلَّا وُسۡعَهَاۤ أُو۟لَـٰۤئِكَ أَصۡحَـٰبُ ٱلۡجَنَّةِۖ هُمۡ فِیهَا خَـٰلِدُونَ"],[7,43,"وَنَزَعۡنَا مَا فِی صُدُورِهِم مِّنۡ غِلࣲّ تَجۡرِی مِن تَحۡتِهِمُ ٱلۡأَنۡهَـٰرُۖ وَقَالُوا۟ ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِی هَدَىٰنَا لِهَـٰذَا وَمَا كُنَّا لِنَهۡتَدِیَ لَوۡلَاۤ أَنۡ هَدَىٰنَا ٱللَّهُۖ لَقَدۡ جَاۤءَتۡ رُسُلُ رَبِّنَا بِٱلۡحَقِّۖ وَنُودُوۤا۟ أَن تِلۡكُمُ ٱلۡجَنَّةُ أُورِثۡتُمُوهَا بِمَا كُنتُمۡ تَعۡمَلُونَ"]]}