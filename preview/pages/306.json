","وَلِنَجۡعَلَهُۥٓ"],["19:21","ءَايَةࣰ"],["19:21","لِّلنَّاسِ"],["19:21","وَرَحۡمَةࣰ"]]],["l",[["19:21","مِّنَّاۚ"],["19:21","وَكَانَ"],["19:21","أَمۡرࣰا"],["19:21","مَّقۡضِيࣰّا"],["19:21","۝٢١",1],["19:22","۞",2],["19:22","فَحَمَلَتۡهُ"],["19:22","فَٱنتَبَذَتۡ"],["19:22","بِهِۦ"]]],["l",[["19:22","مَكَانࣰا"],["19:22","قَصِيࣰّا"],["19:22","۝٢٢",1],["19:23","فَأَجَآءَهَا"],["19:23","ٱلۡمَخَاضُ"],["19:23","إِلَىٰ"],["19:23","جِذۡعِ"],["19:23","ٱلنَّخۡلَةِ"]]],["l",[["19:23","قَالَتۡ"],["19:23","يَٰلَيۡتَنِي"],["19:23","مِتُّ"],["19:23","قَبۡلَ"],["19:23","هَٰذَا"],["19:23","وَكُنتُ"],["19:23","نَسۡيࣰا"],["19:23","مَّنسِيࣰّا"],["19:23","۝٢٣",1]]],["l",[["19:24","فَنَادَىٰهَا"],["19:24","مِن"],["19:24","تَحۡتِهَآ"],["19:24","أَلَّا"],["19:24","تَحۡزَنِي"],["19:24","قَدۡ"],["19:24","جَعَلَ"],["19:24","رَبُّكِ"],["19:24","تَحۡتَكِ"],["19:24","سَرِيࣰّا"],["19:24","۝٢٤",1]]],["l",[["19:25","وَهُزِّيٓ"],["19:25","إِلَيۡكِ"],["19:25","بِجِذۡعِ"],["19:25","ٱلنَّخۡلَةِ"],["19:25","تُسَٰقِطۡ"],["19:25","عَلَيۡكِ"],["19:25","رُطَبࣰا"],["19:25","جَنِيࣰّا"],["19:25","۝٢٥",1]]]],"a":[[19,12,"یَـٰیَحۡیَىٰ خُذِ ٱلۡكِتَـٰبَ بِقُوَّةࣲۖ وَءَاتَیۡنَـٰهُ ٱلۡحُكۡمَ صَبِیࣰّا"],[19,13,"وَحَنَانࣰا مِّن لَّدُنَّا وَزَكَوٰةࣰۖ وَكَانَ تَقِیࣰّا"],[19,14,"وَبَرَّۢا بِوَٰلِدَیۡهِ وَلَمۡ یَكُن جَبَّارًا عَصِیࣰّا"],[19,15,"وَسَلَـٰمٌ عَلَیۡهِ یَوۡمَ وُلِدَ وَیَوۡمَ یَمُوتُ وَیَوۡمَ یُبۡعَثُ حَیࣰّا"],[19,16,"وَٱذۡكُرۡ فِی ٱلۡكِتَـٰبِ مَرۡیَمَ إِذِ ٱنتَبَذَتۡ مِنۡ أَهۡلِهَا مَكَانࣰا شَرۡقِیࣰّا"],[19,17,"فَٱتَّخَذَتۡ مِن دُونِهِمۡ حِجَابࣰا فَأَرۡسَلۡنَاۤ إِلَیۡهَا رُوحَنَا فَتَمَثَّلَ لَهَا بَشَرࣰا سَوِیࣰّا"],[19,18,"قَالَتۡ إِنِّیۤ أَعُوذُ بِٱلرَّحۡمَـٰنِ مِنكَ إِن كُنتَ تَقِیࣰّا"],[19,19,"قَالَ إِنَّمَاۤ أَنَا۠ رَسُولُ رَبِّكِ لِأَهَبَ لَكِ غُلَـٰمࣰا زَكِیࣰّا"],[19,20,"قَالَتۡ أَنَّىٰ یَكُونُ لِی غُلَـٰمࣱ وَلَمۡ یَمۡسَسۡنِی بَشَرࣱ وَلَمۡ أَكُ بَغِیࣰّا"],[19,21,"قَالَ كَذَٰلِكِ قَالَ رَبُّكِ هُوَ عَلَیَّ هَیِّنࣱۖ وَلِنَجۡعَلَهُۥۤ ءَایَةࣰ لِّلنَّاسِ وَرَحۡمَةࣰ مِّنَّاۚ وَكَانَ أَمۡرࣰا مَّقۡضِیࣰّا"],[19,22,"۞ فَحَمَلَتۡهُ فَٱنتَبَذَتۡ بِهِۦ مَكَانࣰا قَصِیࣰّا"],[19,23,"فَأَجَاۤءَهَا ٱلۡمَخَاضُ إِلَىٰ جِذۡعِ ٱلنَّخۡلَةِ قَالَتۡ یَـٰلَیۡتَنِی مِتُّ قَبۡلَ هَـٰذَا وَكُنتُ نَسۡیࣰا مَّنسِیࣰّا"],[19,24,"فَنَادَىٰهَا مِن تَحۡتِهَاۤ أَلَّا تَحۡزَنِی قَدۡ جَعَلَ رَبُّكِ تَحۡتَكِ سَرِیࣰّا"],[19,25,"وَهُزِّیۤ إِلَیۡكِ بِجِذۡعِ ٱلنَّخۡلَةِ تُسَـٰقِطۡ عَلَیۡكِ رُطَبࣰا جَنِیࣰّا"]]}