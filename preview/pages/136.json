","ٱلۡعَٰلَمِينَ"],["6:71","۝٧١",1],["6:72","وَأَنۡ"]]],["l",[["6:72","أَقِيمُواْ"],["6:72","ٱلصَّلَوٰةَ"],["6:72","وَٱتَّقُوهُۚ"],["6:72","وَهُوَ"],["6:72","ٱلَّذِيٓ"],["6:72","إِلَيۡهِ"],["6:72","تُحۡشَرُونَ"],["6:72","۝٧٢",1],["6:73","وَهُوَ"]]],["l",[["6:73","ٱلَّذِي"],["6:73","خَلَقَ"],["6:73","ٱلسَّمَٰوَٰتِ"],["6:73","وَٱلۡأَرۡضَ"],["6:73","بِٱلۡحَقِّۖ"],["6:73","وَيَوۡمَ"],["6:73","يَقُولُ"],["6:73","كُن"]]],["l",[["6:73","فَيَكُونُۚ"],["6:73","قَوۡلُهُ"],["6:73","ٱلۡحَقُّۚ"],["6:73","وَلَهُ"],["6:73","ٱلۡمُلۡكُ"],["6:73","يَوۡمَ"],["6:73","يُنفَخُ"],["6:73","فِي"],["6:73","ٱلصُّورِۚ"]]],["l",[["6:73","عَٰلِمُ"],["6:73","ٱلۡغَيۡبِ"],["6:73","وَٱلشَّهَٰدَةِۚ"],["6:73","وَهُوَ"],["6:73","ٱلۡحَكِيمُ"],["6:73","ٱلۡخَبِيرُ"],["6:73","۝٧٣",1]]]],"a":[[6,69,"وَمَا عَلَى ٱلَّذِینَ یَتَّقُونَ مِنۡ حِسَابِهِم مِّن شَیۡءࣲ وَلَـٰكِن ذِكۡرَىٰ لَعَلَّهُمۡ یَتَّقُونَ"],[6,70,"وَذَرِ ٱلَّذِینَ ٱتَّخَذُوا۟ دِینَهُمۡ لَعِبࣰا وَلَهۡوࣰا وَغَرَّتۡهُمُ ٱلۡحَیَوٰةُ ٱلدُّنۡیَاۚ وَذَكِّرۡ بِهِۦۤ أَن تُبۡسَلَ نَفۡسُۢ بِمَا كَسَبَتۡ لَیۡسَ لَهَا مِن دُونِ ٱللَّهِ وَلِیࣱّ وَلَا شَفِیعࣱ وَإِن تَعۡدِلۡ كُلَّ عَدۡلࣲ لَّا یُؤۡخَذۡ مِنۡهَاۤۗ أُو۟لَـٰۤئِكَ ٱلَّذِینَ أُبۡسِلُوا۟ بِمَا كَسَبُوا۟ۖ لَهُمۡ شَرَابࣱ مِّنۡ حَمِیمࣲ وَعَذَابٌ أَلِیمُۢ بِمَا كَانُوا۟ یَكۡفُرُونَ"],[6,71,"قُلۡ أَنَدۡعُوا۟ مِن دُونِ ٱللَّهِ مَا لَا یَنفَعُنَا وَلَا یَضُرُّنَا وَنُرَدُّ عَلَىٰۤ أَعۡقَابِنَا بَعۡدَ إِذۡ هَدَىٰنَا ٱللَّهُ كَٱلَّذِی ٱسۡتَهۡوَتۡهُ ٱلشَّیَـٰطِینُ فِی ٱلۡأَرۡضِ حَیۡرَانَ لَهُۥۤ أَصۡحَـٰبࣱ یَدۡعُونَهُۥۤ إِلَى ٱلۡهُدَى ٱئۡتِنَاۗ قُلۡ إِنَّ هُدَى ٱللَّهِ هُوَ ٱلۡهُدَىٰۖ وَأُمِرۡنَا لِنُسۡلِمَ لِرَبِّ ٱلۡعَـٰلَمِینَ"],[6,72,"وَأَنۡ أَقِیمُوا۟ ٱلصَّلَوٰةَ وَٱتَّقُوهُۚ وَهُوَ ٱلَّذِیۤ إِلَیۡهِ تُحۡشَرُونَ"],[6,73,"وَهُوَ ٱلَّذِی خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضَ بِٱلۡحَقِّۖ وَیَوۡمَ یَقُولُ كُن فَیَكُونُۚ قَوۡلُهُ ٱلۡحَقُّۚ وَلَهُ ٱلۡمُلۡكُ یَوۡمَ یُنفَخُ فِی ٱلصُّورِۚ عَـٰلِمُ ٱلۡغَیۡبِ وَٱلشَّهَـٰدَةِۚ وَهُوَ ٱلۡحَكِیمُ ٱلۡخَبِیرُ"]]}