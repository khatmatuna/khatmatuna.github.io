3","مِّنۡهُمۡ"],["33:13","يَٰٓأَهۡلَ"],["33:13","يَثۡرِبَ"],["33:13","لَا"],["33:13","مُقَامَ"],["33:13","لَكُمۡ"],["33:13","فَٱرۡجِعُواْۚ"],["33:13","وَيَسۡتَـٔۡذِنُ"],["33:13","فَرِيقࣱ"]]],["l",[["33:13","مِّنۡهُمُ"],["33:13","ٱلنَّبِيَّ"],["33:13","يَقُولُونَ"],["33:13","إِنَّ"],["33:13","بُيُوتَنَا"],["33:13","عَوۡرَةࣱ"],["33:13","وَمَا"],["33:13","هِيَ"],["33:13","بِعَوۡرَةٍۖ"],["33:13","إِن"],["33:13","يُرِيدُونَ"]]],["l",[["33:13","إِلَّا"],["33:13","فِرَارࣰا"],["33:13","۝١٣",1],["33:14","وَلَوۡ"],["33:14","دُخِلَتۡ"],["33:14","عَلَيۡهِم"],["33:14","مِّنۡ"],["33:14","أَقۡطَارِهَا"],["33:14","ثُمَّ"],["33:14","سُئِلُواْ"],["33:14","ٱلۡفِتۡنَةَ"]]],["l",[["33:14","لَأٓتَوۡهَا"],["33:14","وَمَا"],["33:14","تَلَبَّثُواْ"],["33:14","بِهَآ"],["33:14","إِلَّا"],["33:14","يَسِيرࣰا"],["33:14","۝١٤",1],["33:15","وَلَقَدۡ"],["33:15","كَانُواْ"],["33:15","عَٰهَدُواْ"]]],["l",[["33:15","ٱللَّهَ"],["33:15","مِن"],["33:15","قَبۡلُ"],["33:15","لَا"],["33:15","يُوَلُّونَ"],["33:15","ٱلۡأَدۡبَٰرَۚ"],["33:15","وَكَانَ"],["33:15","عَهۡدُ"],["33:15","ٱللَّهِ"],["33:15","مَسۡـُٔولࣰا"],["33:15","۝١٥",1]]]],"a":[[33,7,"وَإِذۡ أَخَذۡنَا مِنَ ٱلنَّبِیِّـۧنَ مِیثَـٰقَهُمۡ وَمِنكَ وَمِن نُّوحࣲ وَإِبۡرَٰهِیمَ وَمُوسَىٰ وَعِیسَى ٱبۡنِ مَرۡیَمَۖ وَأَخَذۡنَا مِنۡهُم مِّیثَـٰقًا غَلِیظࣰا"],[33,8,"لِّیَسۡءَلَ ٱلصَّـٰدِقِینَ عَن صِدۡقِهِمۡۚ وَأَعَدَّ لِلۡكَـٰفِرِینَ عَذَابًا أَلِیمࣰا"],[33,9,"یَـٰۤأَیُّهَا ٱلَّذِینَ ءَامَنُوا۟ ٱذۡكُرُوا۟ نِعۡمَةَ ٱللَّهِ عَلَیۡكُمۡ إِذۡ جَاۤءَتۡكُمۡ جُنُودࣱ فَأَرۡسَلۡنَا عَلَیۡهِمۡ رِیحࣰا وَجُنُودࣰا لَّمۡ تَرَوۡهَاۚ وَكَانَ ٱللَّهُ بِمَا تَعۡمَلُونَ بَصِیرًا"],[33,10,"إِذۡ جَاۤءُوكُم مِّن فَوۡقِكُمۡ وَمِنۡ أَسۡفَلَ مِنكُمۡ وَإِذۡ زَاغَتِ ٱلۡأَبۡصَـٰرُ وَبَلَغَتِ ٱلۡقُلُوبُ ٱلۡحَنَاجِرَ وَتَظُنُّونَ بِٱللَّهِ ٱلظُّنُونَا۠"],[33,11,"هُنَالِكَ ٱبۡتُلِیَ ٱلۡمُؤۡمِنُونَ وَزُلۡزِلُوا۟ زِلۡزَالࣰا شَدِیدࣰا"],[33,12,"وَإِذۡ یَقُولُ ٱلۡمُنَـٰفِقُونَ وَٱلَّذِینَ فِی قُلُوبِهِم مَّرَضࣱ مَّا وَعَدَنَا ٱللَّهُ وَرَسُولُهُۥۤ إِلَّا غُرُورࣰا"],[33,13,"وَإِذۡ قَالَت طَّاۤئِفَةࣱ مِّنۡهُمۡ یَـٰۤأَهۡلَ یَثۡرِبَ لَا مُقَامَ لَكُمۡ فَٱرۡجِعُوا۟ۚ وَیَسۡتَءۡذِنُ فَرِیقࣱ مِّنۡهُمُ ٱلنَّبِیَّ یَقُولُونَ إِنَّ بُیُوتَنَا عَوۡرَةࣱ وَمَا هِیَ بِعَوۡرَةٍۖ إِن یُرِیدُونَ إِلَّا فِرَارࣰا"],[33,14,"وَلَوۡ دُخِلَتۡ عَلَیۡهِم مِّنۡ أَقۡطَارِهَا ثُمَّ سُئِلُوا۟ ٱلۡفِتۡنَةَ لَءَاتَوۡهَا وَمَا تَلَبَّثُوا۟ بِهَاۤ إِلَّا یَسِیرࣰا"],[33,15,"وَلَقَدۡ كَانُوا۟ عَـٰهَدُوا۟ ٱللَّهَ مِن قَبۡلُ لَا یُوَلُّونَ ٱلۡأَدۡبَـٰرَۚ وَكَانَ عَهۡدُ ٱللَّهِ مَسۡءُولࣰا"]]}