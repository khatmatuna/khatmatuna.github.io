{"p":161,"juz":8,"rows":[["l",[["7:82","وَمَا"],["7:82","كَانَ"],["7:82","جَوَابَ"],["7:82","قَوۡمِهِۦٓ"],["7:82","إِلَّآ"],["7:82","أَن"],["7:82","قَالُوٓاْ"],["7:82","أَخۡرِجُوهُم"],["7:82","مِّن"]]],["l",[["7:82","قَرۡيَتِكُمۡۖ"],["7:82","إِنَّهُمۡ"],["7:82","أُنَاسࣱ"],["7:82","يَتَطَهَّرُونَ"],["7:82","۝٨٢",1],["7:83","فَأَنجَيۡنَٰهُ"]]],["l",[["7:83","وَأَهۡلَهُۥٓ"],["7:83","إِلَّا"],["7:83","ٱمۡرَأَتَهُۥ"],["7:83","كَانَتۡ"],["7:83","مِنَ"],["7:83","ٱلۡغَٰبِرِينَ"],["7:83","۝٨٣",1],["7:84","وَأَمۡطَرۡنَا"]]],["l",[["7:84","عَلَيۡهِم"],["7:84","مَّطَرࣰاۖ"],["7:84","فَٱنظُرۡ"],["7:84","كَيۡفَ"],["7:84","كَانَ"],["7:84","عَٰقِبَةُ"],["7:84","ٱلۡمُجۡرِمِينَ"],["7:84","۝٨٤",1]]],["l",[["7:85","وَإِلَىٰ"],["7:85","مَدۡيَنَ"],["7:85","أَخَاهُمۡ"],["7:85","شُعَيۡبࣰاۚ"],["7:85","قَالَ"],["7:85","يَٰقَوۡمِ"],["7:85","ٱعۡبُدُواْ"],["7:85","ٱللَّهَ"]]],["l",[["7:85","مَا"],["7:85","لَكُم"],["7:85","مِّنۡ"],["7:85","إِلَٰهٍ"],["7:85","غَيۡرُهُۥۖ"],["7:85","قَدۡ"],["7:85","جَآءَتۡكُم"],["7:85","بَيِّنَةࣱ"],["7:85","مِّن"],["7:85","رَّبِّكُمۡۖ"]]],["l",[["7:85","فَأَوۡفُواْ"],["7:85","ٱلۡكَيۡلَ"],["7:85","وَٱلۡمِيزَانَ"],["7:85","وَلَا"],["7:85","تَبۡخَسُواْ"],["7:85","ٱلنَّاسَ"]]],["l",[["7:85","أَشۡيَآءَهُمۡ"],["7:85","وَلَا"],["7:85","تُفۡسِدُواْ"],["7:85","فِي"],["7:85","ٱلۡأَرۡضِ"],["7:85","بَعۡدَ"],["7:85","إِصۡلَٰحِهَاۚ"]]],["l",[["7:85","ذَٰلِكُمۡ"],["7:85","خَيۡرࣱ"],["7:85","لَّكُمۡ"],["7:85","إِن"],["7:85","كُنتُم"],["7:85","مُّؤۡمِنِينَ"],["7:85","۝٨٥",1],["7:86","وَلَا"]]],["l",[["7:86","تَقۡعُدُواْ"],["7:86","بِكُلِّ"],["7:86","صِرَٰطࣲ"],["7:86","تُوعِدُونَ"],["7:86","وَتَصُدُّونَ"],["7:86","عَن"]]],["l",[["7:86","سَبِيلِ"],["7:86","ٱللَّهِ"],["7:86","مَنۡ"],["7:86","ءَامَنَ"],["7:86","بِهِۦ"],["7:86","وَتَبۡغُونَهَا"],["7:86","عِوَجࣰاۚ"],["7:86","وَٱذۡكُرُوٓاْ"]]],["l",[["7:86","إِذۡ"],["7:86","كُنتُمۡ"],["7:86","قَلِيلࣰا"],["7:86","فَكَثَّرَكُمۡۖ"],["7:86","وَٱنظُرُواْ"],["7:86","كَيۡفَ"],["7:86","كَانَ"]]],["l",[["7:86","عَٰقِبَةُ"],["7:86","ٱلۡمُفۡسِدِينَ"],["7:86","۝٨٦",1],["7:87","وَإِن"],["7:87","كَانَ"],["7:87","طَآئِفَةࣱ"],["7:87","مِّنكُمۡ"]]],["l",[["7:87","ءَامَنُواْ"],["7:87","بِٱلَّذِيٓ"],["7:87","أُرۡسِلۡتُ"],["7:87","بِهِۦ"],["7:87","وَطَآئِفَةࣱ"],["7:87","لَّمۡ"],["7:87","يُؤۡمِنُواْ"],["7:87","فَٱصۡبِرُواْ"]]],["l",[["7:87","حَتَّىٰ"],["7:87","يَحۡكُمَ"],["7:87","ٱللَّهُ"],["7:87","بَيۡنَنَاۚ"],["7:87","وَهُوَ"],["7:87","خَيۡرُ"],["7:87","ٱلۡحَٰكِمِينَ"],["7:87","۝٨٧",1]]]],"a":[[7,82,"وَمَا كَانَ جَوَابَ قَوۡمِهِۦۤ إِلَّاۤ أَن قَالُوۤا۟ أَخۡرِجُوهُم مِّن قَرۡیَتِكُمۡۖ إِنَّهُمۡ أُنَاسࣱ یَتَطَهَّرُونَ"],[7,83,"فَأَنجَیۡنَـٰهُ وَأَهۡلَهُۥۤ إِلَّا ٱمۡرَأَتَهُۥ كَانَتۡ مِنَ ٱلۡغَـٰبِرِینَ"],[7,84,"وَأَمۡطَرۡنَا عَلَیۡهِم مَّطَرࣰاۖ فَٱنظُرۡ كَیۡفَ كَانَ عَـٰقِبَةُ ٱلۡمُجۡرِمِینَ"],[7,85,"وَإِلَىٰ مَدۡیَنَ أَخَاهُمۡ شُعَیۡبࣰاۚ قَالَ یَـٰقَوۡمِ ٱعۡبُدُوا۟ ٱللَّهَ مَا لَكُم مِّنۡ إِلَـٰهٍ غَیۡرُهُۥۖ قَدۡ جَاۤءَتۡكُم بَیِّنَةࣱ مِّن رَّبِّكُمۡۖ فَأَوۡفُوا۟ ٱلۡكَیۡلَ وَٱلۡمِیزَانَ وَلَا تَبۡخَسُوا۟ ٱلنَّاسَ أَشۡیَاۤءَهُمۡ وَلَا تُفۡسِدُوا۟ فِی ٱلۡأَرۡضِ بَعۡدَ إِصۡلَـٰحِهَاۚ ذَٰلِكُمۡ خَیۡرࣱ لَّكُمۡ إِن كُنتُم مُّؤۡمِنِینَ"],[7,86,"وَلَا تَقۡعُدُوا۟ بِكُلِّ صِرَٰطࣲ تُوعِدُونَ وَتَصُدُّونَ عَن سَبِیلِ ٱللَّهِ مَنۡ ءَامَنَ بِهِۦ وَتَبۡغُونَهَا عِوَجࣰاۚ وَٱذۡكُرُوۤا۟ إِذۡ كُنتُمۡ قَلِیلࣰا فَكَثَّرَكُمۡۖ وَٱنظُرُوا۟ كَیۡفَ كَانَ عَـٰقِبَةُ ٱلۡمُفۡسِدِینَ"],[7,87,"وَإِن كَانَ طَاۤئِفَةࣱ مِّنكُمۡ ءَامَنُوا۟ بِٱلَّذِیۤ أُرۡسِلۡتُ بِهِۦ وَطَاۤئِفَةࣱ لَّمۡ یُؤۡمِنُوا۟ فَٱصۡبِرُوا۟ حَتَّىٰ یَحۡكُمَ ٱللَّهُ بَیۡنَنَاۚ وَهُوَ خَیۡرُ ٱلۡحَـٰكِمِینَ"]]}