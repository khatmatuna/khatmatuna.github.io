"قُلۡ"],["6:15","إِنِّيٓ"],["6:15","أَخَافُ"],["6:15","إِنۡ"],["6:15","عَصَيۡتُ"]]],["l",[["6:15","رَبِّي"],["6:15","عَذَابَ"],["6:15","يَوۡمٍ"],["6:15","عَظِيمࣲ"],["6:15","۝١٥",1],["6:16","مَّن"],["6:16","يُصۡرَفۡ"],["6:16","عَنۡهُ"],["6:16","يَوۡمَئِذࣲ"],["6:16","فَقَدۡ"],["6:16","رَحِمَهُۥۚ"]]],["l",[["6:16","وَذَٰلِكَ"],["6:16","ٱلۡفَوۡزُ"],["6:16","ٱلۡمُبِينُ"],["6:16","۝١٦",1],["6:17","وَإِن"],["6:17","يَمۡسَسۡكَ"],["6:17","ٱللَّهُ"],["6:17","بِضُرࣲّ"],["6:17","فَلَا"],["6:17","كَاشِفَ"]]],["l",[["6:17","لَهُۥٓ"],["6:17","إِلَّا"],["6:17","هُوَۖ"],["6:17","وَإِن"],["6:17","يَمۡسَسۡكَ"],["6:17","بِخَيۡرࣲ"],["6:17","فَهُوَ"],["6:17","عَلَىٰ"],["6:17","كُلِّ"],["6:17","شَيۡءࣲ"],["6:17","قَدِيرࣱ"],["6:17","۝١٧",1]]],["l",[["6:18","وَهُوَ"],["6:18","ٱلۡقَاهِرُ"],["6:18","فَوۡقَ"],["6:18","عِبَادِهِۦۚ"],["6:18","وَهُوَ"],["6:18","ٱلۡحَكِيمُ"],["6:18","ٱلۡخَبِيرُ"],["6:18","۝١٨",1]]]],"a":[[6,9,"وَلَوۡ جَعَلۡنَـٰهُ مَلَكࣰا لَّجَعَلۡنَـٰهُ رَجُلࣰا وَلَلَبَسۡنَا عَلَیۡهِم مَّا یَلۡبِسُونَ"],[6,10,"وَلَقَدِ ٱسۡتُهۡزِئَ بِرُسُلࣲ مِّن قَبۡلِكَ فَحَاقَ بِٱلَّذِینَ سَخِرُوا۟ مِنۡهُم مَّا كَانُوا۟ بِهِۦ یَسۡتَهۡزِءُونَ"],[6,11,"قُلۡ سِیرُوا۟ فِی ٱلۡأَرۡضِ ثُمَّ ٱنظُرُوا۟ كَیۡفَ كَانَ عَـٰقِبَةُ ٱلۡمُكَذِّبِینَ"],[6,12,"قُل لِّمَن مَّا فِی ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِۖ قُل لِّلَّهِۚ كَتَبَ عَلَىٰ نَفۡسِهِ ٱلرَّحۡمَةَۚ لَیَجۡمَعَنَّكُمۡ إِلَىٰ یَوۡمِ ٱلۡقِیَـٰمَةِ لَا رَیۡبَ فِیهِۚ ٱلَّذِینَ خَسِرُوۤا۟ أَنفُسَهُمۡ فَهُمۡ لَا یُؤۡمِنُونَ"],[6,13,"۞ وَلَهُۥ مَا سَكَنَ فِی ٱلَّیۡلِ وَٱلنَّهَارِۚ وَهُوَ ٱلسَّمِیعُ ٱلۡعَلِیمُ"],[6,14,"قُلۡ أَغَیۡرَ ٱللَّهِ أَتَّخِذُ وَلِیࣰّا فَاطِرِ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِ وَهُوَ یُطۡعِمُ وَلَا یُطۡعَمُۗ قُلۡ إِنِّیۤ أُمِرۡتُ أَنۡ أَكُونَ أَوَّلَ مَنۡ أَسۡلَمَۖ وَلَا تَكُونَنَّ مِنَ ٱلۡمُشۡرِكِینَ"],[6,15,"قُلۡ إِنِّیۤ أَخَافُ إِنۡ عَصَیۡتُ رَبِّی عَذَابَ یَوۡمٍ عَظِیمࣲ"],[6,16,"مَّن یُصۡرَفۡ عَنۡهُ یَوۡمَئِذࣲ فَقَدۡ رَحِمَهُۥۚ وَذَٰلِكَ ٱلۡفَوۡزُ ٱلۡمُبِینُ"],[6,17,"وَإِن یَمۡسَسۡكَ ٱللَّهُ بِضُرࣲّ فَلَا كَاشِفَ لَهُۥۤ إِلَّا هُوَۖ وَإِن یَمۡسَسۡكَ بِخَیۡرࣲ فَهُوَ عَلَىٰ كُلِّ شَیۡءࣲ قَدِیرࣱ"],[6,18,"وَهُوَ ٱلۡقَاهِرُ فَوۡقَ عِبَادِهِۦۚ وَهُوَ ٱلۡحَكِیمُ ٱلۡخَبِیرُ"]]}