","وَجۡهَكَ"],["30:30","لِلدِّينِ"],["30:30","حَنِيفࣰاۚ"],["30:30","فِطۡرَتَ"],["30:30","ٱللَّهِ"],["30:30","ٱلَّتِي"],["30:30","فَطَرَ"],["30:30","ٱلنَّاسَ"],["30:30","عَلَيۡهَاۚ"]]],["l",[["30:30","لَا"],["30:30","تَبۡدِيلَ"],["30:30","لِخَلۡقِ"],["30:30","ٱللَّهِۚ"],["30:30","ذَٰلِكَ"],["30:30","ٱلدِّينُ"],["30:30","ٱلۡقَيِّمُ"],["30:30","وَلَٰكِنَّ"],["30:30","أَكۡثَرَ"]]],["l",[["30:30","ٱلنَّاسِ"],["30:30","لَا"],["30:30","يَعۡلَمُونَ"],["30:30","۝٣٠",1],["30:31","۞",2],["30:31","مُنِيبِينَ"],["30:31","إِلَيۡهِ"],["30:31","وَٱتَّقُوهُ"],["30:31","وَأَقِيمُواْ"]]],["l",[["30:31","ٱلصَّلَوٰةَ"],["30:31","وَلَا"],["30:31","تَكُونُواْ"],["30:31","مِنَ"],["30:31","ٱلۡمُشۡرِكِينَ"],["30:31","۝٣١",1],["30:32","مِنَ"],["30:32","ٱلَّذِينَ"],["30:32","فَرَّقُواْ"]]],["l",[["30:32","دِينَهُمۡ"],["30:32","وَكَانُواْ"],["30:32","شِيَعࣰاۖ"],["30:32","كُلُّ"],["30:32","حِزۡبِۭ"],["30:32","بِمَا"],["30:32","لَدَيۡهِمۡ"],["30:32","فَرِحُونَ"],["30:32","۝٣٢",1]]]],"a":[[30,25,"وَمِنۡ ءَایَـٰتِهِۦۤ أَن تَقُومَ ٱلسَّمَاۤءُ وَٱلۡأَرۡضُ بِأَمۡرِهِۦۚ ثُمَّ إِذَا دَعَاكُمۡ دَعۡوَةࣰ مِّنَ ٱلۡأَرۡضِ إِذَاۤ أَنتُمۡ تَخۡرُجُونَ"],[30,26,"وَلَهُۥ مَن فِی ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِۖ كُلࣱّ لَّهُۥ قَـٰنِتُونَ"],[30,27,"وَهُوَ ٱلَّذِی یَبۡدَؤُا۟ ٱلۡخَلۡقَ ثُمَّ یُعِیدُهُۥ وَهُوَ أَهۡوَنُ عَلَیۡهِۚ وَلَهُ ٱلۡمَثَلُ ٱلۡأَعۡلَىٰ فِی ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِۚ وَهُوَ ٱلۡعَزِیزُ ٱلۡحَكِیمُ"],[30,28,"ضَرَبَ لَكُم مَّثَلࣰا مِّنۡ أَنفُسِكُمۡۖ هَل لَّكُم مِّن مَّا مَلَكَتۡ أَیۡمَـٰنُكُم مِّن شُرَكَاۤءَ فِی مَا رَزَقۡنَـٰكُمۡ فَأَنتُمۡ فِیهِ سَوَاۤءࣱ تَخَافُونَهُمۡ كَخِیفَتِكُمۡ أَنفُسَكُمۡۚ كَذَٰلِكَ نُفَصِّلُ ٱلۡءَایَـٰتِ لِقَوۡمࣲ یَعۡقِلُونَ"],[30,29,"بَلِ ٱتَّبَعَ ٱلَّذِینَ ظَلَمُوۤا۟ أَهۡوَاۤءَهُم بِغَیۡرِ عِلۡمࣲۖ فَمَن یَهۡدِی مَنۡ أَضَلَّ ٱللَّهُۖ وَمَا لَهُم مِّن نَّـٰصِرِینَ"],[30,30,"فَأَقِمۡ وَجۡهَكَ لِلدِّینِ حَنِیفࣰاۚ فِطۡرَتَ ٱللَّهِ ٱلَّتِی فَطَرَ ٱلنَّاسَ عَلَیۡهَاۚ لَا تَبۡدِیلَ لِخَلۡقِ ٱللَّهِۚ ذَٰلِكَ ٱلدِّینُ ٱلۡقَیِّمُ وَلَـٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا یَعۡلَمُونَ"],[30,31,"۞ مُنِیبِینَ إِلَیۡهِ وَٱتَّقُوهُ وَأَقِیمُوا۟ ٱلصَّلَوٰةَ وَلَا تَكُونُوا۟ مِنَ ٱلۡمُشۡرِكِینَ"],[30,32,"مِنَ ٱلَّذِینَ فَرَّقُوا۟ دِینَهُمۡ وَكَانُوا۟ شِیَعࣰاۖ كُلُّ حِزۡبِۭ بِمَا لَدَیۡهِمۡ فَرِحُونَ"]]}