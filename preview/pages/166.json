136","فِي"],["7:136","ٱلۡيَمِّ"],["7:136","بِأَنَّهُمۡ"],["7:136","كَذَّبُواْ"],["7:136","بِـَٔايَٰتِنَا"],["7:136","وَكَانُواْ"],["7:136","عَنۡهَا"]]],["l",[["7:136","غَٰفِلِينَ"],["7:136","۝١٣٦",1],["7:137","وَأَوۡرَثۡنَا"],["7:137","ٱلۡقَوۡمَ"],["7:137","ٱلَّذِينَ"],["7:137","كَانُواْ"],["7:137","يُسۡتَضۡعَفُونَ"]]],["l",[["7:137","مَشَٰرِقَ"],["7:137","ٱلۡأَرۡضِ"],["7:137","وَمَغَٰرِبَهَا"],["7:137","ٱلَّتِي"],["7:137","بَٰرَكۡنَا"],["7:137","فِيهَاۖ"],["7:137","وَتَمَّتۡ"],["7:137","كَلِمَتُ"]]],["l",[["7:137","رَبِّكَ"],["7:137","ٱلۡحُسۡنَىٰ"],["7:137","عَلَىٰ"],["7:137","بَنِيٓ"],["7:137","إِسۡرَٰٓءِيلَ"],["7:137","بِمَا"],["7:137","صَبَرُواْۖ"],["7:137","وَدَمَّرۡنَا"]]],["l",[["7:137","مَا"],["7:137","كَانَ"],["7:137","يَصۡنَعُ"],["7:137","فِرۡعَوۡنُ"],["7:137","وَقَوۡمُهُۥ"],["7:137","وَمَا"],["7:137","كَانُواْ"],["7:137","يَعۡرِشُونَ"],["7:137","۝١٣٧",1]]]],"a":[[7,131,"فَإِذَا جَاۤءَتۡهُمُ ٱلۡحَسَنَةُ قَالُوا۟ لَنَا هَـٰذِهِۦۖ وَإِن تُصِبۡهُمۡ سَیِّئَةࣱ یَطَّیَّرُوا۟ بِمُوسَىٰ وَمَن مَّعَهُۥۤۗ أَلَاۤ إِنَّمَا طَـٰۤئِرُهُمۡ عِندَ ٱللَّهِ وَلَـٰكِنَّ أَكۡثَرَهُمۡ لَا یَعۡلَمُونَ"],[7,132,"وَقَالُوا۟ مَهۡمَا تَأۡتِنَا بِهِۦ مِنۡ ءَایَةࣲ لِّتَسۡحَرَنَا بِهَا فَمَا نَحۡنُ لَكَ بِمُؤۡمِنِینَ"],[7,133,"فَأَرۡسَلۡنَا عَلَیۡهِمُ ٱلطُّوفَانَ وَٱلۡجَرَادَ وَٱلۡقُمَّلَ وَٱلضَّفَادِعَ وَٱلدَّمَ ءَایَـٰتࣲ مُّفَصَّلَـٰتࣲ فَٱسۡتَكۡبَرُوا۟ وَكَانُوا۟ قَوۡمࣰا مُّجۡرِمِینَ"],[7,134,"وَلَمَّا وَقَعَ عَلَیۡهِمُ ٱلرِّجۡزُ قَالُوا۟ یَـٰمُوسَى ٱدۡعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِندَكَۖ لَئِن كَشَفۡتَ عَنَّا ٱلرِّجۡزَ لَنُؤۡمِنَنَّ لَكَ وَلَنُرۡسِلَنَّ مَعَكَ بَنِیۤ إِسۡرَٰۤءِیلَ"],[7,135,"فَلَمَّا كَشَفۡنَا عَنۡهُمُ ٱلرِّجۡزَ إِلَىٰۤ أَجَلٍ هُم بَـٰلِغُوهُ إِذَا هُمۡ یَنكُثُونَ"],[7,136,"فَٱنتَقَمۡنَا مِنۡهُمۡ فَأَغۡرَقۡنَـٰهُمۡ فِی ٱلۡیَمِّ بِأَنَّهُمۡ كَذَّبُوا۟ بِءَایَـٰتِنَا وَكَانُوا۟ عَنۡهَا غَـٰفِلِینَ"],[7,137,"وَأَوۡرَثۡنَا ٱلۡقَوۡمَ ٱلَّذِینَ كَانُوا۟ یُسۡتَضۡعَفُونَ مَشَـٰرِقَ ٱلۡأَرۡضِ وَمَغَـٰرِبَهَا ٱلَّتِی بَـٰرَكۡنَا فِیهَاۖ وَتَمَّتۡ كَلِمَتُ رَبِّكَ ٱلۡحُسۡنَىٰ عَلَىٰ بَنِیۤ إِسۡرَٰۤءِیلَ بِمَا صَبَرُوا۟ۖ وَدَمَّرۡنَا مَا كَانَ یَصۡنَعُ فِرۡعَوۡنُ وَقَوۡمُهُۥ وَمَا كَانُوا۟ یَعۡرِشُونَ"]]}