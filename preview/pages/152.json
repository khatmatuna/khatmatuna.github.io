7:20","فَوَسۡوَسَ"]]],["l",[["7:20","لَهُمَا"],["7:20","ٱلشَّيۡطَٰنُ"],["7:20","لِيُبۡدِيَ"],["7:20","لَهُمَا"],["7:20","مَا"],["7:20","وُۥرِيَ"],["7:20","عَنۡهُمَا"],["7:20","مِن"],["7:20","سَوۡءَٰتِهِمَا"],["7:20","وَقَالَ"]]],["l",[["7:20","مَا"],["7:20","نَهَىٰكُمَا"],["7:20","رَبُّكُمَا"],["7:20","عَنۡ"],["7:20","هَٰذِهِ"],["7:20","ٱلشَّجَرَةِ"],["7:20","إِلَّآ"],["7:20","أَن"],["7:20","تَكُونَا"],["7:20","مَلَكَيۡنِ"]]],["l",[["7:20","أَوۡ"],["7:20","تَكُونَا"],["7:20","مِنَ"],["7:20","ٱلۡخَٰلِدِينَ"],["7:20","۝٢٠",1],["7:21","وَقَاسَمَهُمَآ"],["7:21","إِنِّي"],["7:21","لَكُمَا"],["7:21","لَمِنَ"],["7:21","ٱلنَّٰصِحِينَ"],["7:21","۝٢١",1]]],["l",[["7:22","فَدَلَّىٰهُمَا"],["7:22","بِغُرُورࣲۚ"],["7:22","فَلَمَّا"],["7:22","ذَاقَا"],["7:22","ٱلشَّجَرَةَ"],["7:22","بَدَتۡ"],["7:22","لَهُمَا"],["7:22","سَوۡءَٰتُهُمَا"],["7:22","وَطَفِقَا"]]],["l",[["7:22","يَخۡصِفَانِ"],["7:22","عَلَيۡهِمَا"],["7:22","مِن"],["7:22","وَرَقِ"],["7:22","ٱلۡجَنَّةِۖ"],["7:22","وَنَادَىٰهُمَا"],["7:22","رَبُّهُمَآ"],["7:22","أَلَمۡ"],["7:22","أَنۡهَكُمَا"],["7:22","عَن"]]],["l",[["7:22","تِلۡكُمَا"],["7:22","ٱلشَّجَرَةِ"],["7:22","وَأَقُل"],["7:22","لَّكُمَآ"],["7:22","إِنَّ"],["7:22","ٱلشَّيۡطَٰنَ"],["7:22","لَكُمَا"],["7:22","عَدُوࣱّ"],["7:22","مُّبِينࣱ"],["7:22","۝٢٢",1]]]],"a":[[7,12,"قَالَ مَا مَنَعَكَ أَلَّا تَسۡجُدَ إِذۡ أَمَرۡتُكَۖ قَالَ أَنَا۠ خَیۡرࣱ مِّنۡهُ خَلَقۡتَنِی مِن نَّارࣲ وَخَلَقۡتَهُۥ مِن طِینࣲ"],[7,13,"قَالَ فَٱهۡبِطۡ مِنۡهَا فَمَا یَكُونُ لَكَ أَن تَتَكَبَّرَ فِیهَا فَٱخۡرُجۡ إِنَّكَ مِنَ ٱلصَّـٰغِرِینَ"],[7,14,"قَالَ أَنظِرۡنِیۤ إِلَىٰ یَوۡمِ یُبۡعَثُونَ"],[7,15,"قَالَ إِنَّكَ مِنَ ٱلۡمُنظَرِینَ"],[7,16,"قَالَ فَبِمَاۤ أَغۡوَیۡتَنِی لَأَقۡعُدَنَّ لَهُمۡ صِرَٰطَكَ ٱلۡمُسۡتَقِیمَ"],[7,17,"ثُمَّ لَءَاتِیَنَّهُم مِّنۢ بَیۡنِ أَیۡدِیهِمۡ وَمِنۡ خَلۡفِهِمۡ وَعَنۡ أَیۡمَـٰنِهِمۡ وَعَن شَمَاۤئِلِهِمۡۖ وَلَا تَجِدُ أَكۡثَرَهُمۡ شَـٰكِرِینَ"],[7,18,"قَالَ ٱخۡرُجۡ مِنۡهَا مَذۡءُومࣰا مَّدۡحُورࣰاۖ لَّمَن تَبِعَكَ مِنۡهُمۡ لَأَمۡلَأَنَّ جَهَنَّمَ مِنكُمۡ أَجۡمَعِینَ"],[7,19,"وَیَـٰۤءَادَمُ ٱسۡكُنۡ أَنتَ وَزَوۡجُكَ ٱلۡجَنَّةَ فَكُلَا مِنۡ حَیۡثُ شِئۡتُمَا وَلَا تَقۡرَبَا هَـٰذِهِ ٱلشَّجَرَةَ فَتَكُونَا مِنَ ٱلظَّـٰلِمِینَ"],[7,20,"فَوَسۡوَسَ لَهُمَا ٱلشَّیۡطَـٰنُ لِیُبۡدِیَ لَهُمَا مَا وُۥرِیَ عَنۡهُمَا مِن سَوۡءَٰتِهِمَا وَقَالَ مَا نَهَىٰكُمَا رَبُّكُمَا عَنۡ هَـٰذِهِ ٱلشَّجَرَةِ إِلَّاۤ أَن تَكُونَا مَلَكَیۡنِ أَوۡ تَكُونَا مِنَ ٱلۡخَـٰلِدِینَ"],[7,21,"وَقَاسَمَهُمَاۤ إِنِّی لَكُمَا لَمِنَ ٱلنَّـٰصِحِینَ"],[7,22,"فَدَلَّىٰهُمَا بِغُرُورࣲۚ فَلَمَّا ذَاقَا ٱلشَّجَرَةَ بَدَتۡ لَهُمَا سَوۡءَٰتُهُمَا وَطَفِقَا یَخۡصِفَانِ عَلَیۡهِمَا مِن وَرَقِ ٱلۡجَنَّةِۖ وَنَادَىٰهُمَا رَبُّهُمَاۤ أَلَمۡ أَنۡهَكُمَا عَن تِلۡكُمَا ٱلشَّجَرَةِ وَأَقُل لَّكُمَاۤ إِنَّ ٱلشَّیۡطَـٰنَ لَكُمَا عَدُوࣱّ مُّبِینࣱ"]]}