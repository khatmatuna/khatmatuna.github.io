:22","بِمَآ"],["14:22","أَشۡرَكۡتُمُونِ"],["14:22","مِن"],["14:22","قَبۡلُۗ"],["14:22","إِنَّ"],["14:22","ٱلظَّٰلِمِينَ"],["14:22","لَهُمۡ"],["14:22","عَذَابٌ"]]],["l",[["14:22","أَلِيمࣱ"],["14:22","۝٢٢",1],["14:23","وَأُدۡخِلَ"],["14:23","ٱلَّذِينَ"],["14:23","ءَامَنُواْ"],["14:23","وَعَمِلُواْ"],["14:23","ٱلصَّٰلِحَٰتِ"],["14:23","جَنَّٰتࣲ"]]],["l",[["14:23","تَجۡرِي"],["14:23","مِن"],["14:23","تَحۡتِهَا"],["14:23","ٱلۡأَنۡهَٰرُ"],["14:23","خَٰلِدِينَ"],["14:23","فِيهَا"],["14:23","بِإِذۡنِ"],["14:23","رَبِّهِمۡۖ"],["14:23","تَحِيَّتُهُمۡ"]]],["l",[["14:23","فِيهَا"],["14:23","سَلَٰمٌ"],["14:23","۝٢٣",1],["14:24","أَلَمۡ"],["14:24","تَرَ"],["14:24","كَيۡفَ"],["14:24","ضَرَبَ"],["14:24","ٱللَّهُ"],["14:24","مَثَلࣰا"],["14:24","كَلِمَةࣰ"],["14:24","طَيِّبَةࣰ"]]],["l",[["14:24","كَشَجَرَةࣲ"],["14:24","طَيِّبَةٍ"],["14:24","أَصۡلُهَا"],["14:24","ثَابِتࣱ"],["14:24","وَفَرۡعُهَا"],["14:24","فِي"],["14:24","ٱلسَّمَآءِ"],["14:24","۝٢٤",1]]]],"a":[[14,19,"أَلَمۡ تَرَ أَنَّ ٱللَّهَ خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضَ بِٱلۡحَقِّۚ إِن یَشَأۡ یُذۡهِبۡكُمۡ وَیَأۡتِ بِخَلۡقࣲ جَدِیدࣲ"],[14,20,"وَمَا ذَٰلِكَ عَلَى ٱللَّهِ بِعَزِیزࣲ"],[14,21,"وَبَرَزُوا۟ لِلَّهِ جَمِیعࣰا فَقَالَ ٱلضُّعَفَـٰۤؤُا۟ لِلَّذِینَ ٱسۡتَكۡبَرُوۤا۟ إِنَّا كُنَّا لَكُمۡ تَبَعࣰا فَهَلۡ أَنتُم مُّغۡنُونَ عَنَّا مِنۡ عَذَابِ ٱللَّهِ مِن شَیۡءࣲۚ قَالُوا۟ لَوۡ هَدَىٰنَا ٱللَّهُ لَهَدَیۡنَـٰكُمۡۖ سَوَاۤءٌ عَلَیۡنَاۤ أَجَزِعۡنَاۤ أَمۡ صَبَرۡنَا مَا لَنَا مِن مَّحِیصࣲ"],[14,22,"وَقَالَ ٱلشَّیۡطَـٰنُ لَمَّا قُضِیَ ٱلۡأَمۡرُ إِنَّ ٱللَّهَ وَعَدَكُمۡ وَعۡدَ ٱلۡحَقِّ وَوَعَدتُّكُمۡ فَأَخۡلَفۡتُكُمۡۖ وَمَا كَانَ لِیَ عَلَیۡكُم مِّن سُلۡطَـٰنٍ إِلَّاۤ أَن دَعَوۡتُكُمۡ فَٱسۡتَجَبۡتُمۡ لِیۖ فَلَا تَلُومُونِی وَلُومُوۤا۟ أَنفُسَكُمۖ مَّاۤ أَنَا۠ بِمُصۡرِخِكُمۡ وَمَاۤ أَنتُم بِمُصۡرِخِیَّ إِنِّی كَفَرۡتُ بِمَاۤ أَشۡرَكۡتُمُونِ مِن قَبۡلُۗ إِنَّ ٱلظَّـٰلِمِینَ لَهُمۡ عَذَابٌ أَلِیمࣱ"],[14,23,"وَأُدۡخِلَ ٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ جَنَّـٰتࣲ تَجۡرِی مِن تَحۡتِهَا ٱلۡأَنۡهَـٰرُ خَـٰلِدِینَ فِیهَا بِإِذۡنِ رَبِّهِمۡۖ تَحِیَّتُهُمۡ فِیهَا سَلَـٰمٌ"],[14,24,"أَلَمۡ تَرَ كَیۡفَ ضَرَبَ ٱللَّهُ مَثَلࣰا كَلِمَةࣰ طَیِّبَةࣰ كَشَجَرَةࣲ طَیِّبَةٍ أَصۡلُهَا ثَابِتࣱ وَفَرۡعُهَا فِی ٱلسَّمَاۤءِ"]]}