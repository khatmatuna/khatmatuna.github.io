["17:14","بِنَفۡسِكَ"],["17:14","ٱلۡيَوۡمَ"],["17:14","عَلَيۡكَ"],["17:14","حَسِيبࣰا"],["17:14","۝١٤",1]]],["l",[["17:15","مَّنِ"],["17:15","ٱهۡتَدَىٰ"],["17:15","فَإِنَّمَا"],["17:15","يَهۡتَدِي"],["17:15","لِنَفۡسِهِۦۖ"],["17:15","وَمَن"],["17:15","ضَلَّ"],["17:15","فَإِنَّمَا"],["17:15","يَضِلُّ"]]],["l",[["17:15","عَلَيۡهَاۚ"],["17:15","وَلَا"],["17:15","تَزِرُ"],["17:15","وَازِرَةࣱ"],["17:15","وِزۡرَ"],["17:15","أُخۡرَىٰۗ"],["17:15","وَمَا"],["17:15","كُنَّا"],["17:15","مُعَذِّبِينَ"],["17:15","حَتَّىٰ"],["17:15","نَبۡعَثَ"]]],["l",[["17:15","رَسُولࣰا"],["17:15","۝١٥",1],["17:16","وَإِذَآ"],["17:16","أَرَدۡنَآ"],["17:16","أَن"],["17:16","نُّهۡلِكَ"],["17:16","قَرۡيَةً"],["17:16","أَمَرۡنَا"],["17:16","مُتۡرَفِيهَا"],["17:16","فَفَسَقُواْ"],["17:16","فِيهَا"]]],["l",[["17:16","فَحَقَّ"],["17:16","عَلَيۡهَا"],["17:16","ٱلۡقَوۡلُ"],["17:16","فَدَمَّرۡنَٰهَا"],["17:16","تَدۡمِيرࣰا"],["17:16","۝١٦",1],["17:17","وَكَمۡ"],["17:17","أَهۡلَكۡنَا"],["17:17","مِنَ"],["17:17","ٱلۡقُرُونِ"]]],["l",[["17:17","مِنۢ"],["17:17","بَعۡدِ"],["17:17","نُوحࣲۗ"],["17:17","وَكَفَىٰ"],["17:17","بِرَبِّكَ"],["17:17","بِذُنُوبِ"],["17:17","عِبَادِهِۦ"],["17:17","خَبِيرَۢا"],["17:17","بَصِيرࣰا"],["17:17","۝١٧",1]]]],"a":[[17,8,"عَسَىٰ رَبُّكُمۡ أَن یَرۡحَمَكُمۡۚ وَإِنۡ عُدتُّمۡ عُدۡنَاۚ وَجَعَلۡنَا جَهَنَّمَ لِلۡكَـٰفِرِینَ حَصِیرًا"],[17,9,"إِنَّ هَـٰذَا ٱلۡقُرۡءَانَ یَهۡدِی لِلَّتِی هِیَ أَقۡوَمُ وَیُبَشِّرُ ٱلۡمُؤۡمِنِینَ ٱلَّذِینَ یَعۡمَلُونَ ٱلصَّـٰلِحَـٰتِ أَنَّ لَهُمۡ أَجۡرࣰا كَبِیرࣰا"],[17,10,"وَأَنَّ ٱلَّذِینَ لَا یُؤۡمِنُونَ بِٱلۡءَاخِرَةِ أَعۡتَدۡنَا لَهُمۡ عَذَابًا أَلِیمࣰا"],[17,11,"وَیَدۡعُ ٱلۡإِنسَـٰنُ بِٱلشَّرِّ دُعَاۤءَهُۥ بِٱلۡخَیۡرِۖ وَكَانَ ٱلۡإِنسَـٰنُ عَجُولࣰا"],[17,12,"وَجَعَلۡنَا ٱلَّیۡلَ وَٱلنَّهَارَ ءَایَتَیۡنِۖ فَمَحَوۡنَاۤ ءَایَةَ ٱلَّیۡلِ وَجَعَلۡنَاۤ ءَایَةَ ٱلنَّهَارِ مُبۡصِرَةࣰ لِّتَبۡتَغُوا۟ فَضۡلࣰا مِّن رَّبِّكُمۡ وَلِتَعۡلَمُوا۟ عَدَدَ ٱلسِّنِینَ وَٱلۡحِسَابَۚ وَكُلَّ شَیۡءࣲ فَصَّلۡنَـٰهُ تَفۡصِیلࣰا"],[17,13,"وَكُلَّ إِنسَـٰنٍ أَلۡزَمۡنَـٰهُ طَـٰۤئِرَهُۥ فِی عُنُقِهِۦۖ وَنُخۡرِجُ لَهُۥ یَوۡمَ ٱلۡقِیَـٰمَةِ كِتَـٰبࣰا یَلۡقَىٰهُ مَنشُورًا"],[17,14,"ٱقۡرَأۡ كِتَـٰبَكَ كَفَىٰ بِنَفۡسِكَ ٱلۡیَوۡمَ عَلَیۡكَ حَسِیبࣰا"],[17,15,"مَّنِ ٱهۡتَدَىٰ فَإِنَّمَا یَهۡتَدِی لِنَفۡسِهِۦۖ وَمَن ضَلَّ فَإِنَّمَا یَضِلُّ عَلَیۡهَاۚ وَلَا تَزِرُ وَازِرَةࣱ وِزۡرَ أُخۡرَىٰۗ وَمَا كُنَّا مُعَذِّبِینَ حَتَّىٰ نَبۡعَثَ رَسُولࣰا"],[17,16,"وَإِذَاۤ أَرَدۡنَاۤ أَن نُّهۡلِكَ قَرۡیَةً أَمَرۡنَا مُتۡرَفِیهَا فَفَسَقُوا۟ فِیهَا فَحَقَّ عَلَیۡهَا ٱلۡقَوۡلُ فَدَمَّرۡنَـٰهَا تَدۡمِیرࣰا"],[17,17,"وَكَمۡ أَهۡلَكۡنَا مِنَ ٱلۡقُرُونِ مِنۢ بَعۡدِ نُوحࣲۗ وَكَفَىٰ بِرَبِّكَ بِذُنُوبِ عِبَادِهِۦ خَبِیرَۢا بَصِیرࣰا"]]}