","وَلۡنَحۡمِلۡ"],["29:12","خَطَٰيَٰكُمۡ"],["29:12","وَمَا"],["29:12","هُم"],["29:12","بِحَٰمِلِينَ"],["29:12","مِنۡ"],["29:12","خَطَٰيَٰهُم"],["29:12","مِّن"]]],["l",[["29:12","شَيۡءٍۖ"],["29:12","إِنَّهُمۡ"],["29:12","لَكَٰذِبُونَ"],["29:12","۝١٢",1],["29:13","وَلَيَحۡمِلُنَّ"],["29:13","أَثۡقَالَهُمۡ"],["29:13","وَأَثۡقَالࣰا"],["29:13","مَّعَ"]]],["l",[["29:13","أَثۡقَالِهِمۡۖ"],["29:13","وَلَيُسۡـَٔلُنَّ"],["29:13","يَوۡمَ"],["29:13","ٱلۡقِيَٰمَةِ"],["29:13","عَمَّا"],["29:13","كَانُواْ"],["29:13","يَفۡتَرُونَ"],["29:13","۝١٣",1]]],["l",[["29:14","وَلَقَدۡ"],["29:14","أَرۡسَلۡنَا"],["29:14","نُوحًا"],["29:14","إِلَىٰ"],["29:14","قَوۡمِهِۦ"],["29:14","فَلَبِثَ"],["29:14","فِيهِمۡ"],["29:14","أَلۡفَ"],["29:14","سَنَةٍ"]]],["l",[["29:14","إِلَّا"],["29:14","خَمۡسِينَ"],["29:14","عَامࣰا"],["29:14","فَأَخَذَهُمُ"],["29:14","ٱلطُّوفَانُ"],["29:14","وَهُمۡ"],["29:14","ظَٰلِمُونَ"],["29:14","۝١٤",1]]]],"a":[[29,7,"وَٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَنُكَفِّرَنَّ عَنۡهُمۡ سَیِّءَاتِهِمۡ وَلَنَجۡزِیَنَّهُمۡ أَحۡسَنَ ٱلَّذِی كَانُوا۟ یَعۡمَلُونَ"],[29,8,"وَوَصَّیۡنَا ٱلۡإِنسَـٰنَ بِوَٰلِدَیۡهِ حُسۡنࣰاۖ وَإِن جَـٰهَدَٰكَ لِتُشۡرِكَ بِی مَا لَیۡسَ لَكَ بِهِۦ عِلۡمࣱ فَلَا تُطِعۡهُمَاۤۚ إِلَیَّ مَرۡجِعُكُمۡ فَأُنَبِّئُكُم بِمَا كُنتُمۡ تَعۡمَلُونَ"],[29,9,"وَٱلَّذِینَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَنُدۡخِلَنَّهُمۡ فِی ٱلصَّـٰلِحِینَ"],[29,10,"وَمِنَ ٱلنَّاسِ مَن یَقُولُ ءَامَنَّا بِٱللَّهِ فَإِذَاۤ أُوذِیَ فِی ٱللَّهِ جَعَلَ فِتۡنَةَ ٱلنَّاسِ كَعَذَابِ ٱللَّهِۖ وَلَئِن جَاۤءَ نَصۡرࣱ مِّن رَّبِّكَ لَیَقُولُنَّ إِنَّا كُنَّا مَعَكُمۡۚ أَوَ لَیۡسَ ٱللَّهُ بِأَعۡلَمَ بِمَا فِی صُدُورِ ٱلۡعَـٰلَمِینَ"],[29,11,"وَلَیَعۡلَمَنَّ ٱللَّهُ ٱلَّذِینَ ءَامَنُوا۟ وَلَیَعۡلَمَنَّ ٱلۡمُنَـٰفِقِینَ"],[29,12,"وَقَالَ ٱلَّذِینَ كَفَرُوا۟ لِلَّذِینَ ءَامَنُوا۟ ٱتَّبِعُوا۟ سَبِیلَنَا وَلۡنَحۡمِلۡ خَطَـٰیَـٰكُمۡ وَمَا هُم بِحَـٰمِلِینَ مِنۡ خَطَـٰیَـٰهُم مِّن شَیۡءٍۖ إِنَّهُمۡ لَكَـٰذِبُونَ"],[29,13,"وَلَیَحۡمِلُنَّ أَثۡقَالَهُمۡ وَأَثۡقَالࣰا مَّعَ أَثۡقَالِهِمۡۖ وَلَیُسۡءَلُنَّ یَوۡمَ ٱلۡقِیَـٰمَةِ عَمَّا كَانُوا۟ یَفۡتَرُونَ"],[29,14,"وَلَقَدۡ أَرۡسَلۡنَا نُوحًا إِلَىٰ قَوۡمِهِۦ فَلَبِثَ فِیهِمۡ أَلۡفَ سَنَةٍ إِلَّا خَمۡسِینَ عَامࣰا فَأَخَذَهُمُ ٱلطُّوفَانُ وَهُمۡ ظَـٰلِمُونَ"]]}