,["58:5","يُحَآدُّونَ"],["58:5","ٱللَّهَ"],["58:5","وَرَسُولَهُۥ"]]],["l",[["58:5","كُبِتُواْ"],["58:5","كَمَا"],["58:5","كُبِتَ"],["58:5","ٱلَّذِينَ"],["58:5","مِن"],["58:5","قَبۡلِهِمۡۚ"],["58:5","وَقَدۡ"],["58:5","أَنزَلۡنَآ"],["58:5","ءَايَٰتِۭ"],["58:5","بَيِّنَٰتࣲۚ"]]],["l",[["58:5","وَلِلۡكَٰفِرِينَ"],["58:5","عَذَابࣱ"],["58:5","مُّهِينࣱ"],["58:5","۝٥",1],["58:6","يَوۡمَ"],["58:6","يَبۡعَثُهُمُ"],["58:6","ٱللَّهُ"],["58:6","جَمِيعࣰا"],["58:6","فَيُنَبِّئُهُم"]]],["l",[["58:6","بِمَا"],["58:6","عَمِلُوٓاْۚ"],["58:6","أَحۡصَىٰهُ"],["58:6","ٱللَّهُ"],["58:6","وَنَسُوهُۚ"],["58:6","وَٱللَّهُ"],["58:6","عَلَىٰ"],["58:6","كُلِّ"],["58:6","شَيۡءࣲ"],["58:6","شَهِيدٌ"],["58:6","۝٦",1]]]],"a":[[58,1,"۞ قَدۡ سَمِعَ ٱللَّهُ قَوۡلَ ٱلَّتِی تُجَـٰدِلُكَ فِی زَوۡجِهَا وَتَشۡتَكِیۤ إِلَى ٱللَّهِ وَٱللَّهُ یَسۡمَعُ تَحَاوُرَكُمَاۤۚ إِنَّ ٱللَّهَ سَمِیعُۢ بَصِیرٌ"],[58,2,"ٱلَّذِینَ یُظَـٰهِرُونَ مِنكُم مِّن نِّسَاۤئِهِم مَّا هُنَّ أُمَّهَـٰتِهِمۡۖ إِنۡ أُمَّهَـٰتُهُمۡ إِلَّا ٱلَّـٰۤءِی وَلَدۡنَهُمۡۚ وَإِنَّهُمۡ لَیَقُولُونَ مُنكَرࣰا مِّنَ ٱلۡقَوۡلِ وَزُورࣰاۚ وَإِنَّ ٱللَّهَ لَعَفُوٌّ غَفُورࣱ"],[58,3,"وَٱلَّذِینَ یُظَـٰهِرُونَ مِن نِّسَاۤئِهِمۡ ثُمَّ یَعُودُونَ لِمَا قَالُوا۟ فَتَحۡرِیرُ رَقَبَةࣲ مِّن قَبۡلِ أَن یَتَمَاۤسَّاۚ ذَٰلِكُمۡ تُوعَظُونَ بِهِۦۚ وَٱللَّهُ بِمَا تَعۡمَلُونَ خَبِیرࣱ"],[58,4,"فَمَن لَّمۡ یَجِدۡ فَصِیَامُ شَهۡرَیۡنِ مُتَتَابِعَیۡنِ مِن قَبۡلِ أَن یَتَمَاۤسَّاۖ فَمَن لَّمۡ یَسۡتَطِعۡ فَإِطۡعَامُ سِتِّینَ مِسۡكِینࣰاۚ ذَٰلِكَ لِتُؤۡمِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦۚ وَتِلۡكَ حُدُودُ ٱللَّهِۗ وَلِلۡكَـٰفِرِینَ عَذَابٌ أَلِیمٌ"],[58,5,"إِنَّ ٱلَّذِینَ یُحَاۤدُّونَ ٱللَّهَ وَرَسُولَهُۥ كُبِتُوا۟ كَمَا كُبِتَ ٱلَّذِینَ مِن قَبۡلِهِمۡۚ وَقَدۡ أَنزَلۡنَاۤ ءَایَـٰتِۭ بَیِّنَـٰتࣲۚ وَلِلۡكَـٰفِرِینَ عَذَابࣱ مُّهِینࣱ"],[58,6,"یَوۡمَ یَبۡعَثُهُمُ ٱللَّهُ جَمِیعࣰا فَیُنَبِّئُهُم بِمَا عَمِلُوۤا۟ۚ أَحۡصَىٰهُ ٱللَّهُ وَنَسُوهُۚ وَٱللَّهُ عَلَىٰ كُلِّ شَیۡءࣲ شَهِیدٌ"]]}