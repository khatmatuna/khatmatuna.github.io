151","تَعَالَوۡاْ"],["6:151","أَتۡلُ"],["6:151","مَا"],["6:151","حَرَّمَ"],["6:151","رَبُّكُمۡ"],["6:151","عَلَيۡكُمۡۖ"],["6:151","أَلَّا"],["6:151","تُشۡرِكُواْ"]]],["l",[["6:151","بِهِۦ"],["6:151","شَيۡـࣰٔاۖ"],["6:151","وَبِٱلۡوَٰلِدَيۡنِ"],["6:151","إِحۡسَٰنࣰاۖ"],["6:151","وَلَا"],["6:151","تَقۡتُلُوٓاْ"],["6:151","أَوۡلَٰدَكُم"]]],["l",[["6:151","مِّنۡ"],["6:151","إِمۡلَٰقࣲ"],["6:151","نَّحۡنُ"],["6:151","نَرۡزُقُكُمۡ"],["6:151","وَإِيَّاهُمۡۖ"],["6:151","وَلَا"],["6:151","تَقۡرَبُواْ"],["6:151","ٱلۡفَوَٰحِشَ"]]],["l",[["6:151","مَا"],["6:151","ظَهَرَ"],["6:151","مِنۡهَا"],["6:151","وَمَا"],["6:151","بَطَنَۖ"],["6:151","وَلَا"],["6:151","تَقۡتُلُواْ"],["6:151","ٱلنَّفۡسَ"],["6:151","ٱلَّتِي"],["6:151","حَرَّمَ"],["6:151","ٱللَّهُ"]]],["l",[["6:151","إِلَّا"],["6:151","بِٱلۡحَقِّۚ"],["6:151","ذَٰلِكُمۡ"],["6:151","وَصَّىٰكُم"],["6:151","بِهِۦ"],["6:151","لَعَلَّكُمۡ"],["6:151","تَعۡقِلُونَ"],["6:151","۝١٥١",1]]]],"a":[[6,147,"فَإِن كَذَّبُوكَ فَقُل رَّبُّكُمۡ ذُو رَحۡمَةࣲ وَٰسِعَةࣲ وَلَا یُرَدُّ بَأۡسُهُۥ عَنِ ٱلۡقَوۡمِ ٱلۡمُجۡرِمِینَ"],[6,148,"سَیَقُولُ ٱلَّذِینَ أَشۡرَكُوا۟ لَوۡ شَاۤءَ ٱللَّهُ مَاۤ أَشۡرَكۡنَا وَلَاۤ ءَابَاۤؤُنَا وَلَا حَرَّمۡنَا مِن شَیۡءࣲۚ كَذَٰلِكَ كَذَّبَ ٱلَّذِینَ مِن قَبۡلِهِمۡ حَتَّىٰ ذَاقُوا۟ بَأۡسَنَاۗ قُلۡ هَلۡ عِندَكُم مِّنۡ عِلۡمࣲ فَتُخۡرِجُوهُ لَنَاۤۖ إِن تَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَإِنۡ أَنتُمۡ إِلَّا تَخۡرُصُونَ"],[6,149,"قُلۡ فَلِلَّهِ ٱلۡحُجَّةُ ٱلۡبَـٰلِغَةُۖ فَلَوۡ شَاۤءَ لَهَدَىٰكُمۡ أَجۡمَعِینَ"],[6,150,"قُلۡ هَلُمَّ شُهَدَاۤءَكُمُ ٱلَّذِینَ یَشۡهَدُونَ أَنَّ ٱللَّهَ حَرَّمَ هَـٰذَاۖ فَإِن شَهِدُوا۟ فَلَا تَشۡهَدۡ مَعَهُمۡۚ وَلَا تَتَّبِعۡ أَهۡوَاۤءَ ٱلَّذِینَ كَذَّبُوا۟ بِءَایَـٰتِنَا وَٱلَّذِینَ لَا یُؤۡمِنُونَ بِٱلۡءَاخِرَةِ وَهُم بِرَبِّهِمۡ یَعۡدِلُونَ"],[6,151,"۞ قُلۡ تَعَالَوۡا۟ أَتۡلُ مَا حَرَّمَ رَبُّكُمۡ عَلَیۡكُمۡۖ أَلَّا تُشۡرِكُوا۟ بِهِۦ شَیۡءࣰاۖ وَبِٱلۡوَٰلِدَیۡنِ إِحۡسَـٰنࣰاۖ وَلَا تَقۡتُلُوۤا۟ أَوۡلَـٰدَكُم مِّنۡ إِمۡلَـٰقࣲ نَّحۡنُ نَرۡزُقُكُمۡ وَإِیَّاهُمۡۖ وَلَا تَقۡرَبُوا۟ ٱلۡفَوَٰحِشَ مَا ظَهَرَ مِنۡهَا وَمَا بَطَنَۖ وَلَا تَقۡتُلُوا۟ ٱلنَّفۡسَ ٱلَّتِی حَرَّمَ ٱللَّهُ إِلَّا بِٱلۡحَقِّۚ ذَٰلِكُمۡ وَصَّىٰكُم بِهِۦ لَعَلَّكُمۡ تَعۡقِلُونَ"]]}