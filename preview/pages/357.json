"24:58","لِيَسۡتَـٔۡذِنكُمُ"],["24:58","ٱلَّذِينَ"],["24:58","مَلَكَتۡ"],["24:58","أَيۡمَٰنُكُمۡ"],["24:58","وَٱلَّذِينَ"],["24:58","لَمۡ"],["24:58","يَبۡلُغُواْ"],["24:58","ٱلۡحُلُمَ"],["24:58","مِنكُمۡ"]]],["l",[["24:58","ثَلَٰثَ"],["24:58","مَرَّٰتࣲۚ"],["24:58","مِّن"],["24:58","قَبۡلِ"],["24:58","صَلَوٰةِ"],["24:58","ٱلۡفَجۡرِ"],["24:58","وَحِينَ"],["24:58","تَضَعُونَ"],["24:58","ثِيَابَكُم"],["24:58","مِّنَ"]]],["l",[["24:58","ٱلظَّهِيرَةِ"],["24:58","وَمِنۢ"],["24:58","بَعۡدِ"],["24:58","صَلَوٰةِ"],["24:58","ٱلۡعِشَآءِۚ"],["24:58","ثَلَٰثُ"],["24:58","عَوۡرَٰتࣲ"],["24:58","لَّكُمۡۚ"],["24:58","لَيۡسَ"],["24:58","عَلَيۡكُمۡ"]]],["l",[["24:58","وَلَا"],["24:58","عَلَيۡهِمۡ"],["24:58","جُنَاحُۢ"],["24:58","بَعۡدَهُنَّۚ"],["24:58","طَوَّٰفُونَ"],["24:58","عَلَيۡكُم"],["24:58","بَعۡضُكُمۡ"],["24:58","عَلَىٰ"],["24:58","بَعۡضࣲۚ"]]],["l",[["24:58","كَذَٰلِكَ"],["24:58","يُبَيِّنُ"],["24:58","ٱللَّهُ"],["24:58","لَكُمُ"],["24:58","ٱلۡأٓيَٰتِۗ"],["24:58","وَٱللَّهُ"],["24:58","عَلِيمٌ"],["24:58","حَكِيمࣱ"],["24:58","۝٥٨",1]]]],"a":[[24,54,"قُلۡ أَطِیعُوا۟ ٱللَّهَ وَأَطِیعُوا۟ ٱلرَّسُولَۖ فَإِن تَوَلَّوۡا۟ فَإِنَّمَا عَلَیۡهِ مَا حُمِّلَ وَعَلَیۡكُم مَّا حُمِّلۡتُمۡۖ وَإِن تُطِیعُوهُ تَهۡتَدُوا۟ۚ وَمَا عَلَى ٱلرَّسُولِ إِلَّا ٱلۡبَلَـٰغُ ٱلۡمُبِینُ"],[24,55,"وَعَدَ ٱللَّهُ ٱلَّذِینَ ءَامَنُوا۟ مِنكُمۡ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَیَسۡتَخۡلِفَنَّهُمۡ فِی ٱلۡأَرۡضِ كَمَا ٱسۡتَخۡلَفَ ٱلَّذِینَ مِن قَبۡلِهِمۡ وَلَیُمَكِّنَنَّ لَهُمۡ دِینَهُمُ ٱلَّذِی ٱرۡتَضَىٰ لَهُمۡ وَلَیُبَدِّلَنَّهُم مِّنۢ بَعۡدِ خَوۡفِهِمۡ أَمۡنࣰاۚ یَعۡبُدُونَنِی لَا یُشۡرِكُونَ بِی شَیۡءࣰاۚ وَمَن كَفَرَ بَعۡدَ ذَٰلِكَ فَأُو۟لَـٰۤئِكَ هُمُ ٱلۡفَـٰسِقُونَ"],[24,56,"وَأَقِیمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَطِیعُوا۟ ٱلرَّسُولَ لَعَلَّكُمۡ تُرۡحَمُونَ"],[24,57,"لَا تَحۡسَبَنَّ ٱلَّذِینَ كَفَرُوا۟ مُعۡجِزِینَ فِی ٱلۡأَرۡضِۚ وَمَأۡوَىٰهُمُ ٱلنَّارُۖ وَلَبِئۡسَ ٱلۡمَصِیرُ"],[24,58,"یَـٰۤأَیُّهَا ٱلَّذِینَ ءَامَنُوا۟ لِیَسۡتَءۡذِنكُمُ ٱلَّذِینَ مَلَكَتۡ أَیۡمَـٰنُكُمۡ وَٱلَّذِینَ لَمۡ یَبۡلُغُوا۟ ٱلۡحُلُمَ مِنكُمۡ ثَلَـٰثَ مَرَّٰتࣲۚ مِّن قَبۡلِ صَلَوٰةِ ٱلۡفَجۡرِ وَحِینَ تَضَعُونَ ثِیَابَكُم مِّنَ ٱلظَّهِیرَةِ وَمِنۢ بَعۡدِ صَلَوٰةِ ٱلۡعِشَاۤءِۚ ثَلَـٰثُ عَوۡرَٰتࣲ لَّكُمۡۚ لَیۡسَ عَلَیۡكُمۡ وَلَا عَلَیۡهِمۡ جُنَاحُۢ بَعۡدَهُنَّۚ طَوَّٰفُونَ عَلَیۡكُم بَعۡضُكُمۡ عَلَىٰ بَعۡضࣲۚ كَذَٰلِكَ یُبَیِّنُ ٱللَّهُ لَكُمُ ٱلۡءَایَـٰتِۗ وَٱللَّهُ عَلِیمٌ حَكِیمࣱ"]]}