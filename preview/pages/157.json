"7:56","ٱلۡأَرۡضِ"],["7:56","بَعۡدَ"],["7:56","إِصۡلَٰحِهَا"],["7:56","وَٱدۡعُوهُ"],["7:56","خَوۡفࣰا"],["7:56","وَطَمَعًاۚ"]]],["l",[["7:56","إِنَّ"],["7:56","رَحۡمَتَ"],["7:56","ٱللَّهِ"],["7:56","قَرِيبࣱ"],["7:56","مِّنَ"],["7:56","ٱلۡمُحۡسِنِينَ"],["7:56","۝٥٦",1],["7:57","وَهُوَ"],["7:57","ٱلَّذِي"],["7:57","يُرۡسِلُ"]]],["l",[["7:57","ٱلرِّيَٰحَ"],["7:57","بُشۡرَۢا"],["7:57","بَيۡنَ"],["7:57","يَدَيۡ"],["7:57","رَحۡمَتِهِۦۖ"],["7:57","حَتَّىٰٓ"],["7:57","إِذَآ"],["7:57","أَقَلَّتۡ"],["7:57","سَحَابࣰا"],["7:57","ثِقَالࣰا"]]],["l",[["7:57","سُقۡنَٰهُ"],["7:57","لِبَلَدࣲ"],["7:57","مَّيِّتࣲ"],["7:57","فَأَنزَلۡنَا"],["7:57","بِهِ"],["7:57","ٱلۡمَآءَ"],["7:57","فَأَخۡرَجۡنَا"],["7:57","بِهِۦ"],["7:57","مِن"],["7:57","كُلِّ"]]],["l",[["7:57","ٱلثَّمَرَٰتِۚ"],["7:57","كَذَٰلِكَ"],["7:57","نُخۡرِجُ"],["7:57","ٱلۡمَوۡتَىٰ"],["7:57","لَعَلَّكُمۡ"],["7:57","تَذَكَّرُونَ"],["7:57","۝٥٧",1]]]],"a":[[7,52,"وَلَقَدۡ جِئۡنَـٰهُم بِكِتَـٰبࣲ فَصَّلۡنَـٰهُ عَلَىٰ عِلۡمٍ هُدࣰى وَرَحۡمَةࣰ لِّقَوۡمࣲ یُؤۡمِنُونَ"],[7,53,"هَلۡ یَنظُرُونَ إِلَّا تَأۡوِیلَهُۥۚ یَوۡمَ یَأۡتِی تَأۡوِیلُهُۥ یَقُولُ ٱلَّذِینَ نَسُوهُ مِن قَبۡلُ قَدۡ جَاۤءَتۡ رُسُلُ رَبِّنَا بِٱلۡحَقِّ فَهَل لَّنَا مِن شُفَعَاۤءَ فَیَشۡفَعُوا۟ لَنَاۤ أَوۡ نُرَدُّ فَنَعۡمَلَ غَیۡرَ ٱلَّذِی كُنَّا نَعۡمَلُۚ قَدۡ خَسِرُوۤا۟ أَنفُسَهُمۡ وَضَلَّ عَنۡهُم مَّا كَانُوا۟ یَفۡتَرُونَ"],[7,54,"إِنَّ رَبَّكُمُ ٱللَّهُ ٱلَّذِی خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضَ فِی سِتَّةِ أَیَّامࣲ ثُمَّ ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِۖ یُغۡشِی ٱلَّیۡلَ ٱلنَّهَارَ یَطۡلُبُهُۥ حَثِیثࣰا وَٱلشَّمۡسَ وَٱلۡقَمَرَ وَٱلنُّجُومَ مُسَخَّرَٰتِۭ بِأَمۡرِهِۦۤۗ أَلَا لَهُ ٱلۡخَلۡقُ وَٱلۡأَمۡرُۗ تَبَارَكَ ٱللَّهُ رَبُّ ٱلۡعَـٰلَمِینَ"],[7,55,"ٱدۡعُوا۟ رَبَّكُمۡ تَضَرُّعࣰا وَخُفۡیَةًۚ إِنَّهُۥ لَا یُحِبُّ ٱلۡمُعۡتَدِینَ"],[7,56,"وَلَا تُفۡسِدُوا۟ فِی ٱلۡأَرۡضِ بَعۡدَ إِصۡلَـٰحِهَا وَٱدۡعُوهُ خَوۡفࣰا وَطَمَعًاۚ إِنَّ رَحۡمَتَ ٱللَّهِ قَرِیبࣱ مِّنَ ٱلۡمُحۡسِنِینَ"],[7,57,"وَهُوَ ٱلَّذِی یُرۡسِلُ ٱلرِّیَـٰحَ بُشۡرَۢا بَیۡنَ یَدَیۡ رَحۡمَتِهِۦۖ حَتَّىٰۤ إِذَاۤ أَقَلَّتۡ سَحَابࣰا ثِقَالࣰا سُقۡنَـٰهُ لِبَلَدࣲ مَّیِّتࣲ فَأَنزَلۡنَا بِهِ ٱلۡمَاۤءَ فَأَخۡرَجۡنَا بِهِۦ مِن كُلِّ ٱلثَّمَرَٰتِۚ كَذَٰلِكَ نُخۡرِجُ ٱلۡمَوۡتَىٰ لَعَلَّكُمۡ تَذَكَّرُونَ"]]}