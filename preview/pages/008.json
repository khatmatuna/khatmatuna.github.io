"2:55","لَكَ"],["2:55","حَتَّىٰ"],["2:55","نَرَى"],["2:55","ٱللَّهَ"]]],["l",[["2:55","جَهۡرَةࣰ"],["2:55","فَأَخَذَتۡكُمُ"],["2:55","ٱلصَّٰعِقَةُ"],["2:55","وَأَنتُمۡ"],["2:55","تَنظُرُونَ"],["2:55","۝٥٥",1],["2:56","ثُمَّ"],["2:56","بَعَثۡنَٰكُم"]]],["l",[["2:56","مِّنۢ"],["2:56","بَعۡدِ"],["2:56","مَوۡتِكُمۡ"],["2:56","لَعَلَّكُمۡ"],["2:56","تَشۡكُرُونَ"],["2:56","۝٥٦",1],["2:57","وَظَلَّلۡنَا"],["2:57","عَلَيۡكُمُ"]]],["l",[["2:57","ٱلۡغَمَامَ"],["2:57","وَأَنزَلۡنَا"],["2:57","عَلَيۡكُمُ"],["2:57","ٱلۡمَنَّ"],["2:57","وَٱلسَّلۡوَىٰۖ"],["2:57","كُلُواْ"],["2:57","مِن"],["2:57","طَيِّبَٰتِ"]]],["l",[["2:57","مَا"],["2:57","رَزَقۡنَٰكُمۡۚ"],["2:57","وَمَا"],["2:57","ظَلَمُونَا"],["2:57","وَلَٰكِن"],["2:57","كَانُوٓاْ"],["2:57","أَنفُسَهُمۡ"],["2:57","يَظۡلِمُونَ"],["2:57","۝٥٧",1]]]],"a":[[2,49,"وَإِذۡ نَجَّیۡنَـٰكُم مِّنۡ ءَالِ فِرۡعَوۡنَ یَسُومُونَكُمۡ سُوۤءَ ٱلۡعَذَابِ یُذَبِّحُونَ أَبۡنَاۤءَكُمۡ وَیَسۡتَحۡیُونَ نِسَاۤءَكُمۡۚ وَفِی ذَٰلِكُم بَلَاۤءࣱ مِّن رَّبِّكُمۡ عَظِیمࣱ"],[2,50,"وَإِذۡ فَرَقۡنَا بِكُمُ ٱلۡبَحۡرَ فَأَنجَیۡنَـٰكُمۡ وَأَغۡرَقۡنَاۤ ءَالَ فِرۡعَوۡنَ وَأَنتُمۡ تَنظُرُونَ"],[2,51,"وَإِذۡ وَٰعَدۡنَا مُوسَىٰۤ أَرۡبَعِینَ لَیۡلَةࣰ ثُمَّ ٱتَّخَذۡتُمُ ٱلۡعِجۡلَ مِنۢ بَعۡدِهِۦ وَأَنتُمۡ ظَـٰلِمُونَ"],[2,52,"ثُمَّ عَفَوۡنَا عَنكُم مِّنۢ بَعۡدِ ذَٰلِكَ لَعَلَّكُمۡ تَشۡكُرُونَ"],[2,53,"وَإِذۡ ءَاتَیۡنَا مُوسَى ٱلۡكِتَـٰبَ وَٱلۡفُرۡقَانَ لَعَلَّكُمۡ تَهۡتَدُونَ"],[2,54,"وَإِذۡ قَالَ مُوسَىٰ لِقَوۡمِهِۦ یَـٰقَوۡمِ إِنَّكُمۡ ظَلَمۡتُمۡ أَنفُسَكُم بِٱتِّخَاذِكُمُ ٱلۡعِجۡلَ فَتُوبُوۤا۟ إِلَىٰ بَارِئِكُمۡ فَٱقۡتُلُوۤا۟ أَنفُسَكُمۡ ذَٰلِكُمۡ خَیۡرࣱ لَّكُمۡ عِندَ بَارِئِكُمۡ فَتَابَ عَلَیۡكُمۡۚ إِنَّهُۥ هُوَ ٱلتَّوَّابُ ٱلرَّحِیمُ"],[2,55,"وَإِذۡ قُلۡتُمۡ یَـٰمُوسَىٰ لَن نُّؤۡمِنَ لَكَ حَتَّىٰ نَرَى ٱللَّهَ جَهۡرَةࣰ فَأَخَذَتۡكُمُ ٱلصَّـٰعِقَةُ وَأَنتُمۡ تَنظُرُونَ"],[2,56,"ثُمَّ بَعَثۡنَـٰكُم مِّنۢ بَعۡدِ مَوۡتِكُمۡ لَعَلَّكُمۡ تَشۡكُرُونَ"],[2,57,"وَظَلَّلۡنَا عَلَیۡكُمُ ٱلۡغَمَامَ وَأَنزَلۡنَا عَلَیۡكُمُ ٱلۡمَنَّ وَٱلسَّلۡوَىٰۖ كُلُوا۟ مِن طَیِّبَـٰتِ مَا رَزَقۡنَـٰكُمۡۚ وَمَا ظَلَمُونَا وَلَـٰكِن كَانُوۤا۟ أَنفُسَهُمۡ یَظۡلِمُونَ"]]}