]]],["l",[["3:21","إِنَّ"],["3:21","ٱلَّذِينَ"],["3:21","يَكۡفُرُونَ"],["3:21","بِـَٔايَٰتِ"],["3:21","ٱللَّهِ"],["3:21","وَيَقۡتُلُونَ"],["3:21","ٱلنَّبِيِّـۧنَ"]]],["l",[["3:21","بِغَيۡرِ"],["3:21","حَقࣲّ"],["3:21","وَيَقۡتُلُونَ"],["3:21","ٱلَّذِينَ"],["3:21","يَأۡمُرُونَ"],["3:21","بِٱلۡقِسۡطِ"],["3:21","مِنَ"]]],["l",[["3:21","ٱلنَّاسِ"],["3:21","فَبَشِّرۡهُم"],["3:21","بِعَذَابٍ"],["3:21","أَلِيمٍ"],["3:21","۝٢١",1],["3:22","أُوْلَٰٓئِكَ"],["3:22","ٱلَّذِينَ"],["3:22","حَبِطَتۡ"]]],["l",[["3:22","أَعۡمَٰلُهُمۡ"],["3:22","فِي"],["3:22","ٱلدُّنۡيَا"],["3:22","وَٱلۡأٓخِرَةِ"],["3:22","وَمَا"],["3:22","لَهُم"],["3:22","مِّن"],["3:22","نَّٰصِرِينَ"],["3:22","۝٢٢",1]]]],"a":[[3,16,"ٱلَّذِینَ یَقُولُونَ رَبَّنَاۤ إِنَّنَاۤ ءَامَنَّا فَٱغۡفِرۡ لَنَا ذُنُوبَنَا وَقِنَا عَذَابَ ٱلنَّارِ"],[3,17,"ٱلصَّـٰبِرِینَ وَٱلصَّـٰدِقِینَ وَٱلۡقَـٰنِتِینَ وَٱلۡمُنفِقِینَ وَٱلۡمُسۡتَغۡفِرِینَ بِٱلۡأَسۡحَارِ"],[3,18,"شَهِدَ ٱللَّهُ أَنَّهُۥ لَاۤ إِلَـٰهَ إِلَّا هُوَ وَٱلۡمَلَـٰۤئِكَةُ وَأُو۟لُوا۟ ٱلۡعِلۡمِ قَاۤئِمَۢا بِٱلۡقِسۡطِۚ لَاۤ إِلَـٰهَ إِلَّا هُوَ ٱلۡعَزِیزُ ٱلۡحَكِیمُ"],[3,19,"إِنَّ ٱلدِّینَ عِندَ ٱللَّهِ ٱلۡإِسۡلَـٰمُۗ وَمَا ٱخۡتَلَفَ ٱلَّذِینَ أُوتُوا۟ ٱلۡكِتَـٰبَ إِلَّا مِنۢ بَعۡدِ مَا جَاۤءَهُمُ ٱلۡعِلۡمُ بَغۡیَۢا بَیۡنَهُمۡۗ وَمَن یَكۡفُرۡ بِءَایَـٰتِ ٱللَّهِ فَإِنَّ ٱللَّهَ سَرِیعُ ٱلۡحِسَابِ"],[3,20,"فَإِنۡ حَاۤجُّوكَ فَقُلۡ أَسۡلَمۡتُ وَجۡهِیَ لِلَّهِ وَمَنِ ٱتَّبَعَنِۗ وَقُل لِّلَّذِینَ أُوتُوا۟ ٱلۡكِتَـٰبَ وَٱلۡأُمِّیِّـۧنَ ءَأَسۡلَمۡتُمۡۚ فَإِنۡ أَسۡلَمُوا۟ فَقَدِ ٱهۡتَدَوا۟ۖ وَّإِن تَوَلَّوۡا۟ فَإِنَّمَا عَلَیۡكَ ٱلۡبَلَـٰغُۗ وَٱللَّهُ بَصِیرُۢ بِٱلۡعِبَادِ"],[3,21,"إِنَّ ٱلَّذِینَ یَكۡفُرُونَ بِءَایَـٰتِ ٱللَّهِ وَیَقۡتُلُونَ ٱلنَّبِیِّـۧنَ بِغَیۡرِ حَقࣲّ وَیَقۡتُلُونَ ٱلَّذِینَ یَأۡمُرُونَ بِٱلۡقِسۡطِ مِنَ ٱلنَّاسِ فَبَشِّرۡهُم بِعَذَابٍ أَلِیمٍ"],[3,22,"أُو۟لَـٰۤئِكَ ٱلَّذِینَ حَبِطَتۡ أَعۡمَـٰلُهُمۡ فِی ٱلدُّنۡیَا وَٱلۡءَاخِرَةِ وَمَا لَهُم مِّن نَّـٰصِرِینَ"]]}