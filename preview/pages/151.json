,["7:10","مَعَٰيِشَۗ"],["7:10","قَلِيلࣰا"],["7:10","مَّا"],["7:10","تَشۡكُرُونَ"],["7:10","۝١٠",1]]],["l",[["7:11","وَلَقَدۡ"],["7:11","خَلَقۡنَٰكُمۡ"],["7:11","ثُمَّ"],["7:11","صَوَّرۡنَٰكُمۡ"],["7:11","ثُمَّ"],["7:11","قُلۡنَا"],["7:11","لِلۡمَلَٰٓئِكَةِ"]]],["l",[["7:11","ٱسۡجُدُواْ"],["7:11","لِأٓدَمَ"],["7:11","فَسَجَدُوٓاْ"],["7:11","إِلَّآ"],["7:11","إِبۡلِيسَ"],["7:11","لَمۡ"],["7:11","يَكُن"],["7:11","مِّنَ"],["7:11","ٱلسَّٰجِدِينَ"],["7:11","۝١١",1]]]],"a":[[7,1,"۞ الۤمۤصۤ"],[7,2,"كِتَـٰبٌ أُنزِلَ إِلَیۡكَ فَلَا یَكُن فِی صَدۡرِكَ حَرَجࣱ مِّنۡهُ لِتُنذِرَ بِهِۦ وَذِكۡرَىٰ لِلۡمُؤۡمِنِینَ"],[7,3,"ٱتَّبِعُوا۟ مَاۤ أُنزِلَ إِلَیۡكُم مِّن رَّبِّكُمۡ وَلَا تَتَّبِعُوا۟ مِن دُونِهِۦۤ أَوۡلِیَاۤءَۗ قَلِیلࣰا مَّا تَذَكَّرُونَ"],[7,4,"وَكَم مِّن قَرۡیَةٍ أَهۡلَكۡنَـٰهَا فَجَاۤءَهَا بَأۡسُنَا بَیَـٰتًا أَوۡ هُمۡ قَاۤئِلُونَ"],[7,5,"فَمَا كَانَ دَعۡوَىٰهُمۡ إِذۡ جَاۤءَهُم بَأۡسُنَاۤ إِلَّاۤ أَن قَالُوۤا۟ إِنَّا كُنَّا ظَـٰلِمِینَ"],[7,6,"فَلَنَسۡءَلَنَّ ٱلَّذِینَ أُرۡسِلَ إِلَیۡهِمۡ وَلَنَسۡءَلَنَّ ٱلۡمُرۡسَلِینَ"],[7,7,"فَلَنَقُصَّنَّ عَلَیۡهِم بِعِلۡمࣲۖ وَمَا كُنَّا غَاۤئِبِینَ"],[7,8,"وَٱلۡوَزۡنُ یَوۡمَئِذٍ ٱلۡحَقُّۚ فَمَن ثَقُلَتۡ مَوَٰزِینُهُۥ فَأُو۟لَـٰۤئِكَ هُمُ ٱلۡمُفۡلِحُونَ"],[7,9,"وَمَنۡ خَفَّتۡ مَوَٰزِینُهُۥ فَأُو۟لَـٰۤئِكَ ٱلَّذِینَ خَسِرُوۤا۟ أَنفُسَهُم بِمَا كَانُوا۟ بِءَایَـٰتِنَا یَظۡلِمُونَ"],[7,10,"وَلَقَدۡ مَكَّنَّـٰكُمۡ فِی ٱلۡأَرۡضِ وَجَعَلۡنَا لَكُمۡ فِیهَا مَعَـٰیِشَۗ قَلِیلࣰا مَّا تَشۡكُرُونَ"],[7,11,"وَلَقَدۡ خَلَقۡنَـٰكُمۡ ثُمَّ صَوَّرۡنَـٰكُمۡ ثُمَّ قُلۡنَا لِلۡمَلَـٰۤئِكَةِ ٱسۡجُدُوا۟ لِءَادَمَ فَسَجَدُوۤا۟ إِلَّاۤ إِبۡلِیسَ لَمۡ یَكُن مِّنَ ٱلسَّـٰجِدِینَ"]]}