"7:169","خَلۡفࣱ"],["7:169","وَرِثُواْ"],["7:169","ٱلۡكِتَٰبَ"]]],["l",[["7:169","يَأۡخُذُونَ"],["7:169","عَرَضَ"],["7:169","هَٰذَا"],["7:169","ٱلۡأَدۡنَىٰ"],["7:169","وَيَقُولُونَ"],["7:169","سَيُغۡفَرُ"],["7:169","لَنَا"],["7:169","وَإِن"]]],["l",[["7:169","يَأۡتِهِمۡ"],["7:169","عَرَضࣱ"],["7:169","مِّثۡلُهُۥ"],["7:169","يَأۡخُذُوهُۚ"],["7:169","أَلَمۡ"],["7:169","يُؤۡخَذۡ"],["7:169","عَلَيۡهِم"],["7:169","مِّيثَٰقُ"],["7:169","ٱلۡكِتَٰبِ"]]],["l",[["7:169","أَن"],["7:169","لَّا"],["7:169","يَقُولُواْ"],["7:169","عَلَى"],["7:169","ٱللَّهِ"],["7:169","إِلَّا"],["7:169","ٱلۡحَقَّ"],["7:169","وَدَرَسُواْ"],["7:169","مَا"],["7:169","فِيهِۗ"],["7:169","وَٱلدَّارُ"],["7:169","ٱلۡأٓخِرَةُ"]]],["l",[["7:169","خَيۡرࣱ"],["7:169","لِّلَّذِينَ"],["7:169","يَتَّقُونَۚ"],["7:169","أَفَلَا"],["7:169","تَعۡقِلُونَ"],["7:169","۝١٦٩",1],["7:170","وَٱلَّذِينَ"],["7:170","يُمَسِّكُونَ"]]],["l",[["7:170","بِٱلۡكِتَٰبِ"],["7:170","وَأَقَامُواْ"],["7:170","ٱلصَّلَوٰةَ"],["7:170","إِنَّا"],["7:170","لَا"],["7:170","نُضِيعُ"],["7:170","أَجۡرَ"],["7:170","ٱلۡمُصۡلِحِينَ"],["7:170","۝١٧٠",1]]]],"a":[[7,164,"وَإِذۡ قَالَتۡ أُمَّةࣱ مِّنۡهُمۡ لِمَ تَعِظُونَ قَوۡمًا ٱللَّهُ مُهۡلِكُهُمۡ أَوۡ مُعَذِّبُهُمۡ عَذَابࣰا شَدِیدࣰاۖ قَالُوا۟ مَعۡذِرَةً إِلَىٰ رَبِّكُمۡ وَلَعَلَّهُمۡ یَتَّقُونَ"],[7,165,"فَلَمَّا نَسُوا۟ مَا ذُكِّرُوا۟ بِهِۦۤ أَنجَیۡنَا ٱلَّذِینَ یَنۡهَوۡنَ عَنِ ٱلسُّوۤءِ وَأَخَذۡنَا ٱلَّذِینَ ظَلَمُوا۟ بِعَذَابِۭ بَءِیسِۭ بِمَا كَانُوا۟ یَفۡسُقُونَ"],[7,166,"فَلَمَّا عَتَوۡا۟ عَن مَّا نُهُوا۟ عَنۡهُ قُلۡنَا لَهُمۡ كُونُوا۟ قِرَدَةً خَـٰسِءِینَ"],[7,167,"وَإِذۡ تَأَذَّنَ رَبُّكَ لَیَبۡعَثَنَّ عَلَیۡهِمۡ إِلَىٰ یَوۡمِ ٱلۡقِیَـٰمَةِ مَن یَسُومُهُمۡ سُوۤءَ ٱلۡعَذَابِۗ إِنَّ رَبَّكَ لَسَرِیعُ ٱلۡعِقَابِ وَإِنَّهُۥ لَغَفُورࣱ رَّحِیمࣱ"],[7,168,"وَقَطَّعۡنَـٰهُمۡ فِی ٱلۡأَرۡضِ أُمَمࣰاۖ مِّنۡهُمُ ٱلصَّـٰلِحُونَ وَمِنۡهُمۡ دُونَ ذَٰلِكَۖ وَبَلَوۡنَـٰهُم بِٱلۡحَسَنَـٰتِ وَٱلسَّیِّءَاتِ لَعَلَّهُمۡ یَرۡجِعُونَ"],[7,169,"فَخَلَفَ مِنۢ بَعۡدِهِمۡ خَلۡفࣱ وَرِثُوا۟ ٱلۡكِتَـٰبَ یَأۡخُذُونَ عَرَضَ هَـٰذَا ٱلۡأَدۡنَىٰ وَیَقُولُونَ سَیُغۡفَرُ لَنَا وَإِن یَأۡتِهِمۡ عَرَضࣱ مِّثۡلُهُۥ یَأۡخُذُوهُۚ أَلَمۡ یُؤۡخَذۡ عَلَیۡهِم مِّیثَـٰقُ ٱلۡكِتَـٰبِ أَن لَّا یَقُولُوا۟ عَلَى ٱللَّهِ إِلَّا ٱلۡحَقَّ وَدَرَسُوا۟ مَا فِیهِۗ وَٱلدَّارُ ٱلۡءَاخِرَةُ خَیۡرࣱ لِّلَّذِینَ یَتَّقُونَۚ أَفَلَا تَعۡقِلُونَ"],[7,170,"وَٱلَّذِینَ یُمَسِّكُونَ بِٱلۡكِتَـٰبِ وَأَقَامُوا۟ ٱلصَّلَوٰةَ إِنَّا لَا نُضِیعُ أَجۡرَ ٱلۡمُصۡلِحِینَ"]]}