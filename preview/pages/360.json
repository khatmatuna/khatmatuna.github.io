"25:8","مَّسۡحُورًا"],["25:8","۝٨",1],["25:9","ٱنظُرۡ"]]],["l",[["25:9","كَيۡفَ"],["25:9","ضَرَبُواْ"],["25:9","لَكَ"],["25:9","ٱلۡأَمۡثَٰلَ"],["25:9","فَضَلُّواْ"],["25:9","فَلَا"],["25:9","يَسۡتَطِيعُونَ"]]],["l",[["25:9","سَبِيلࣰا"],["25:9","۝٩",1],["25:10","تَبَارَكَ"],["25:10","ٱلَّذِيٓ"],["25:10","إِن"],["25:10","شَآءَ"],["25:10","جَعَلَ"],["25:10","لَكَ"],["25:10","خَيۡرࣰا"],["25:10","مِّن"],["25:10","ذَٰلِكَ"]]],["l",[["25:10","جَنَّٰتࣲ"],["25:10","تَجۡرِي"],["25:10","مِن"],["25:10","تَحۡتِهَا"],["25:10","ٱلۡأَنۡهَٰرُ"],["25:10","وَيَجۡعَل"],["25:10","لَّكَ"],["25:10","قُصُورَۢا"],["25:10","۝١٠",1],["25:11","بَلۡ"]]],["l",[["25:11","كَذَّبُواْ"],["25:11","بِٱلسَّاعَةِۖ"],["25:11","وَأَعۡتَدۡنَا"],["25:11","لِمَن"],["25:11","كَذَّبَ"],["25:11","بِٱلسَّاعَةِ"],["25:11","سَعِيرًا"],["25:11","۝١١",1]]]],"a":[[25,3,"وَٱتَّخَذُوا۟ مِن دُونِهِۦۤ ءَالِهَةࣰ لَّا یَخۡلُقُونَ شَیۡءࣰا وَهُمۡ یُخۡلَقُونَ وَلَا یَمۡلِكُونَ لِأَنفُسِهِمۡ ضَرࣰّا وَلَا نَفۡعࣰا وَلَا یَمۡلِكُونَ مَوۡتࣰا وَلَا حَیَوٰةࣰ وَلَا نُشُورࣰا"],[25,4,"وَقَالَ ٱلَّذِینَ كَفَرُوۤا۟ إِنۡ هَـٰذَاۤ إِلَّاۤ إِفۡكٌ ٱفۡتَرَىٰهُ وَأَعَانَهُۥ عَلَیۡهِ قَوۡمٌ ءَاخَرُونَۖ فَقَدۡ جَاۤءُو ظُلۡمࣰا وَزُورࣰا"],[25,5,"وَقَالُوۤا۟ أَسَـٰطِیرُ ٱلۡأَوَّلِینَ ٱكۡتَتَبَهَا فَهِیَ تُمۡلَىٰ عَلَیۡهِ بُكۡرَةࣰ وَأَصِیلࣰا"],[25,6,"قُلۡ أَنزَلَهُ ٱلَّذِی یَعۡلَمُ ٱلسِّرَّ فِی ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِۚ إِنَّهُۥ كَانَ غَفُورࣰا رَّحِیمࣰا"],[25,7,"وَقَالُوا۟ مَالِ هَـٰذَا ٱلرَّسُولِ یَأۡكُلُ ٱلطَّعَامَ وَیَمۡشِی فِی ٱلۡأَسۡوَاقِ لَوۡلَاۤ أُنزِلَ إِلَیۡهِ مَلَكࣱ فَیَكُونَ مَعَهُۥ نَذِیرًا"],[25,8,"أَوۡ یُلۡقَىٰۤ إِلَیۡهِ كَنزٌ أَوۡ تَكُونُ لَهُۥ جَنَّةࣱ یَأۡكُلُ مِنۡهَاۚ وَقَالَ ٱلظَّـٰلِمُونَ إِن تَتَّبِعُونَ إِلَّا رَجُلࣰا مَّسۡحُورًا"],[25,9,"ٱنظُرۡ كَیۡفَ ضَرَبُوا۟ لَكَ ٱلۡأَمۡثَـٰلَ فَضَلُّوا۟ فَلَا یَسۡتَطِیعُونَ سَبِیلࣰا"],[25,10,"تَبَارَكَ ٱلَّذِیۤ إِن شَاۤءَ جَعَلَ لَكَ خَیۡرࣰا مِّن ذَٰلِكَ جَنَّـٰتࣲ تَجۡرِی مِن تَحۡتِهَا ٱلۡأَنۡهَـٰرُ وَیَجۡعَل لَّكَ قُصُورَۢا"],[25,11,"بَلۡ كَذَّبُوا۟ بِٱلسَّاعَةِۖ وَأَعۡتَدۡنَا لِمَن كَذَّبَ بِٱلسَّاعَةِ سَعِیرًا"]]}