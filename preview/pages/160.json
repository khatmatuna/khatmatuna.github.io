"7:79","لَّا"],["7:79","تُحِبُّونَ"],["7:79","ٱلنَّٰصِحِينَ"],["7:79","۝٧٩",1]]],["l",[["7:80","وَلُوطًا"],["7:80","إِذۡ"],["7:80","قَالَ"],["7:80","لِقَوۡمِهِۦٓ"],["7:80","أَتَأۡتُونَ"],["7:80","ٱلۡفَٰحِشَةَ"],["7:80","مَا"],["7:80","سَبَقَكُم"]]],["l",[["7:80","بِهَا"],["7:80","مِنۡ"],["7:80","أَحَدࣲ"],["7:80","مِّنَ"],["7:80","ٱلۡعَٰلَمِينَ"],["7:80","۝٨٠",1],["7:81","إِنَّكُمۡ"],["7:81","لَتَأۡتُونَ"],["7:81","ٱلرِّجَالَ"]]],["l",[["7:81","شَهۡوَةࣰ"],["7:81","مِّن"],["7:81","دُونِ"],["7:81","ٱلنِّسَآءِۚ"],["7:81","بَلۡ"],["7:81","أَنتُمۡ"],["7:81","قَوۡمࣱ"],["7:81","مُّسۡرِفُونَ"],["7:81","۝٨١",1]]]],"a":[[7,74,"وَٱذۡكُرُوۤا۟ إِذۡ جَعَلَكُمۡ خُلَفَاۤءَ مِنۢ بَعۡدِ عَادࣲ وَبَوَّأَكُمۡ فِی ٱلۡأَرۡضِ تَتَّخِذُونَ مِن سُهُولِهَا قُصُورࣰا وَتَنۡحِتُونَ ٱلۡجِبَالَ بُیُوتࣰاۖ فَٱذۡكُرُوۤا۟ ءَالَاۤءَ ٱللَّهِ وَلَا تَعۡثَوۡا۟ فِی ٱلۡأَرۡضِ مُفۡسِدِینَ"],[7,75,"قَالَ ٱلۡمَلَأُ ٱلَّذِینَ ٱسۡتَكۡبَرُوا۟ مِن قَوۡمِهِۦ لِلَّذِینَ ٱسۡتُضۡعِفُوا۟ لِمَنۡ ءَامَنَ مِنۡهُمۡ أَتَعۡلَمُونَ أَنَّ صَـٰلِحࣰا مُّرۡسَلࣱ مِّن رَّبِّهِۦۚ قَالُوۤا۟ إِنَّا بِمَاۤ أُرۡسِلَ بِهِۦ مُؤۡمِنُونَ"],[7,76,"قَالَ ٱلَّذِینَ ٱسۡتَكۡبَرُوۤا۟ إِنَّا بِٱلَّذِیۤ ءَامَنتُم بِهِۦ كَـٰفِرُونَ"],[7,77,"فَعَقَرُوا۟ ٱلنَّاقَةَ وَعَتَوۡا۟ عَنۡ أَمۡرِ رَبِّهِمۡ وَقَالُوا۟ یَـٰصَـٰلِحُ ٱئۡتِنَا بِمَا تَعِدُنَاۤ إِن كُنتَ مِنَ ٱلۡمُرۡسَلِینَ"],[7,78,"فَأَخَذَتۡهُمُ ٱلرَّجۡفَةُ فَأَصۡبَحُوا۟ فِی دَارِهِمۡ جَـٰثِمِینَ"],[7,79,"فَتَوَلَّىٰ عَنۡهُمۡ وَقَالَ یَـٰقَوۡمِ لَقَدۡ أَبۡلَغۡتُكُمۡ رِسَالَةَ رَبِّی وَنَصَحۡتُ لَكُمۡ وَلَـٰكِن لَّا تُحِبُّونَ ٱلنَّـٰصِحِینَ"],[7,80,"وَلُوطًا إِذۡ قَالَ لِقَوۡمِهِۦۤ أَتَأۡتُونَ ٱلۡفَـٰحِشَةَ مَا سَبَقَكُم بِهَا مِنۡ أَحَدࣲ مِّنَ ٱلۡعَـٰلَمِینَ"],[7,81,"إِنَّكُمۡ لَتَأۡتُونَ ٱلرِّجَالَ شَهۡوَةࣰ مِّن دُونِ ٱلنِّسَاۤءِۚ بَلۡ أَنتُمۡ قَوۡمࣱ مُّسۡرِفُونَ"]]}