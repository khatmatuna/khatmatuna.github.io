]],["l",[["48:7","ٱلسَّمَٰوَٰتِ"],["48:7","وَٱلۡأَرۡضِۚ"],["48:7","وَكَانَ"],["48:7","ٱللَّهُ"],["48:7","عَزِيزًا"],["48:7","حَكِيمًا"],["48:7","۝٧",1],["48:8","إِنَّآ"]]],["l",[["48:8","أَرۡسَلۡنَٰكَ"],["48:8","شَٰهِدࣰا"],["48:8","وَمُبَشِّرࣰا"],["48:8","وَنَذِيرࣰا"],["48:8","۝٨",1],["48:9","لِّتُؤۡمِنُواْ"],["48:9","بِٱللَّهِ"],["48:9","وَرَسُولِهِۦ"]]],["l",[["48:9","وَتُعَزِّرُوهُ"],["48:9","وَتُوَقِّرُوهُۚ"],["48:9","وَتُسَبِّحُوهُ"],["48:9","بُكۡرَةࣰ"],["48:9","وَأَصِيلًا"],["48:9","۝٩",1]]]],"a":[[48,1,"إِنَّا فَتَحۡنَا لَكَ فَتۡحࣰا مُّبِینࣰا"],[48,2,"لِّیَغۡفِرَ لَكَ ٱللَّهُ مَا تَقَدَّمَ مِن ذَنۢبِكَ وَمَا تَأَخَّرَ وَیُتِمَّ نِعۡمَتَهُۥ عَلَیۡكَ وَیَهۡدِیَكَ صِرَٰطࣰا مُّسۡتَقِیمࣰا"],[48,3,"وَیَنصُرَكَ ٱللَّهُ نَصۡرًا عَزِیزًا"],[48,4,"هُوَ ٱلَّذِیۤ أَنزَلَ ٱلسَّكِینَةَ فِی قُلُوبِ ٱلۡمُؤۡمِنِینَ لِیَزۡدَادُوۤا۟ إِیمَـٰنࣰا مَّعَ إِیمَـٰنِهِمۡۗ وَلِلَّهِ جُنُودُ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِۚ وَكَانَ ٱللَّهُ عَلِیمًا حَكِیمࣰا"],[48,5,"لِّیُدۡخِلَ ٱلۡمُؤۡمِنِینَ وَٱلۡمُؤۡمِنَـٰتِ جَنَّـٰتࣲ تَجۡرِی مِن تَحۡتِهَا ٱلۡأَنۡهَـٰرُ خَـٰلِدِینَ فِیهَا وَیُكَفِّرَ عَنۡهُمۡ سَیِّءَاتِهِمۡۚ وَكَانَ ذَٰلِكَ عِندَ ٱللَّهِ فَوۡزًا عَظِیمࣰا"],[48,6,"وَیُعَذِّبَ ٱلۡمُنَـٰفِقِینَ وَٱلۡمُنَـٰفِقَـٰتِ وَٱلۡمُشۡرِكِینَ وَٱلۡمُشۡرِكَـٰتِ ٱلظَّاۤنِّینَ بِٱللَّهِ ظَنَّ ٱلسَّوۡءِۚ عَلَیۡهِمۡ دَاۤئِرَةُ ٱلسَّوۡءِۖ وَغَضِبَ ٱللَّهُ عَلَیۡهِمۡ وَلَعَنَهُمۡ وَأَعَدَّ لَهُمۡ جَهَنَّمَۖ وَسَاۤءَتۡ مَصِیرࣰا"],[48,7,"وَلِلَّهِ جُنُودُ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِۚ وَكَانَ ٱللَّهُ عَزِیزًا حَكِیمًا"],[48,8,"إِنَّاۤ أَرۡسَلۡنَـٰكَ شَـٰهِدࣰا وَمُبَشِّرࣰا وَنَذِیرࣰا"],[48,9,"لِّتُؤۡمِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَتُعَزِّرُوهُ وَتُوَقِّرُوهُۚ وَتُسَبِّحُوهُ بُكۡرَةࣰ وَأَصِیلًا"]]}