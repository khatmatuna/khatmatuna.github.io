],["16:13","فِي"],["16:13","ذَٰلِكَ"],["16:13","لَأٓيَةࣰ"],["16:13","لِّقَوۡمࣲ"],["16:13","يَذَّكَّرُونَ"],["16:13","۝١٣",1]]],["l",[["16:14","وَهُوَ"],["16:14","ٱلَّذِي"],["16:14","سَخَّرَ"],["16:14","ٱلۡبَحۡرَ"],["16:14","لِتَأۡكُلُواْ"],["16:14","مِنۡهُ"],["16:14","لَحۡمࣰا"],["16:14","طَرِيࣰّا"]]],["l",[["16:14","وَتَسۡتَخۡرِجُواْ"],["16:14","مِنۡهُ"],["16:14","حِلۡيَةࣰ"],["16:14","تَلۡبَسُونَهَاۖ"],["16:14","وَتَرَى"],["16:14","ٱلۡفُلۡكَ"],["16:14","مَوَاخِرَ"]]],["l",[["16:14","فِيهِ"],["16:14","وَلِتَبۡتَغُواْ"],["16:14","مِن"],["16:14","فَضۡلِهِۦ"],["16:14","وَلَعَلَّكُمۡ"],["16:14","تَشۡكُرُونَ"],["16:14","۝١٤",1]]]],"a":[[16,7,"وَتَحۡمِلُ أَثۡقَالَكُمۡ إِلَىٰ بَلَدࣲ لَّمۡ تَكُونُوا۟ بَـٰلِغِیهِ إِلَّا بِشِقِّ ٱلۡأَنفُسِۚ إِنَّ رَبَّكُمۡ لَرَءُوفࣱ رَّحِیمࣱ"],[16,8,"وَٱلۡخَیۡلَ وَٱلۡبِغَالَ وَٱلۡحَمِیرَ لِتَرۡكَبُوهَا وَزِینَةࣰۚ وَیَخۡلُقُ مَا لَا تَعۡلَمُونَ"],[16,9,"وَعَلَى ٱللَّهِ قَصۡدُ ٱلسَّبِیلِ وَمِنۡهَا جَاۤئِرࣱۚ وَلَوۡ شَاۤءَ لَهَدَىٰكُمۡ أَجۡمَعِینَ"],[16,10,"هُوَ ٱلَّذِیۤ أَنزَلَ مِنَ ٱلسَّمَاۤءِ مَاۤءࣰۖ لَّكُم مِّنۡهُ شَرَابࣱ وَمِنۡهُ شَجَرࣱ فِیهِ تُسِیمُونَ"],[16,11,"یُنۢبِتُ لَكُم بِهِ ٱلزَّرۡعَ وَٱلزَّیۡتُونَ وَٱلنَّخِیلَ وَٱلۡأَعۡنَـٰبَ وَمِن كُلِّ ٱلثَّمَرَٰتِۚ إِنَّ فِی ذَٰلِكَ لَءَایَةࣰ لِّقَوۡمࣲ یَتَفَكَّرُونَ"],[16,12,"وَسَخَّرَ لَكُمُ ٱلَّیۡلَ وَٱلنَّهَارَ وَٱلشَّمۡسَ وَٱلۡقَمَرَۖ وَٱلنُّجُومُ مُسَخَّرَٰتُۢ بِأَمۡرِهِۦۤۚ إِنَّ فِی ذَٰلِكَ لَءَایَـٰتࣲ لِّقَوۡمࣲ یَعۡقِلُونَ"],[16,13,"وَمَا ذَرَأَ لَكُمۡ فِی ٱلۡأَرۡضِ مُخۡتَلِفًا أَلۡوَٰنُهُۥۤۚ إِنَّ فِی ذَٰلِكَ لَءَایَةࣰ لِّقَوۡمࣲ یَذَّكَّرُونَ"],[16,14,"وَهُوَ ٱلَّذِی سَخَّرَ ٱلۡبَحۡرَ لِتَأۡكُلُوا۟ مِنۡهُ لَحۡمࣰا طَرِیࣰّا وَتَسۡتَخۡرِجُوا۟ مِنۡهُ حِلۡیَةࣰ تَلۡبَسُونَهَاۖ وَتَرَى ٱلۡفُلۡكَ مَوَاخِرَ فِیهِ وَلِتَبۡتَغُوا۟ مِن فَضۡلِهِۦ وَلَعَلَّكُمۡ تَشۡكُرُونَ"]]}