,"حَكِيمٌ"],["9:110","۝١١٠",1]]],["l",[["9:111","۞",2],["9:111","إِنَّ"],["9:111","ٱللَّهَ"],["9:111","ٱشۡتَرَىٰ"],["9:111","مِنَ"],["9:111","ٱلۡمُؤۡمِنِينَ"],["9:111","أَنفُسَهُمۡ"],["9:111","وَأَمۡوَٰلَهُم"]]],["l",[["9:111","بِأَنَّ"],["9:111","لَهُمُ"],["9:111","ٱلۡجَنَّةَۚ"],["9:111","يُقَٰتِلُونَ"],["9:111","فِي"],["9:111","سَبِيلِ"],["9:111","ٱللَّهِ"],["9:111","فَيَقۡتُلُونَ"]]],["l",[["9:111","وَيُقۡتَلُونَۖ"],["9:111","وَعۡدًا"],["9:111","عَلَيۡهِ"],["9:111","حَقࣰّا"],["9:111","فِي"],["9:111","ٱلتَّوۡرَىٰةِ"],["9:111","وَٱلۡإِنجِيلِ"]]],["l",[["9:111","وَٱلۡقُرۡءَانِۚ"],["9:111","وَمَنۡ"],["9:111","أَوۡفَىٰ"],["9:111","بِعَهۡدِهِۦ"],["9:111","مِنَ"],["9:111","ٱللَّهِۚ"],["9:111","فَٱسۡتَبۡشِرُواْ"]]],["l",[["9:111","بِبَيۡعِكُمُ"],["9:111","ٱلَّذِي"],["9:111","بَايَعۡتُم"],["9:111","بِهِۦۚ"],["9:111","وَذَٰلِكَ"],["9:111","هُوَ"],["9:111","ٱلۡفَوۡزُ"],["9:111","ٱلۡعَظِيمُ"],["9:111","۝١١١",1]]]],"a":[[9,107,"وَٱلَّذِینَ ٱتَّخَذُوا۟ مَسۡجِدࣰا ضِرَارࣰا وَكُفۡرࣰا وَتَفۡرِیقَۢا بَیۡنَ ٱلۡمُؤۡمِنِینَ وَإِرۡصَادࣰا لِّمَنۡ حَارَبَ ٱللَّهَ وَرَسُولَهُۥ مِن قَبۡلُۚ وَلَیَحۡلِفُنَّ إِنۡ أَرَدۡنَاۤ إِلَّا ٱلۡحُسۡنَىٰۖ وَٱللَّهُ یَشۡهَدُ إِنَّهُمۡ لَكَـٰذِبُونَ"],[9,108,"لَا تَقُمۡ فِیهِ أَبَدࣰاۚ لَّمَسۡجِدٌ أُسِّسَ عَلَى ٱلتَّقۡوَىٰ مِنۡ أَوَّلِ یَوۡمٍ أَحَقُّ أَن تَقُومَ فِیهِۚ فِیهِ رِجَالࣱ یُحِبُّونَ أَن یَتَطَهَّرُوا۟ۚ وَٱللَّهُ یُحِبُّ ٱلۡمُطَّهِّرِینَ"],[9,109,"أَفَمَنۡ أَسَّسَ بُنۡیَـٰنَهُۥ عَلَىٰ تَقۡوَىٰ مِنَ ٱللَّهِ وَرِضۡوَٰنٍ خَیۡرٌ أَم مَّنۡ أَسَّسَ بُنۡیَـٰنَهُۥ عَلَىٰ شَفَا جُرُفٍ هَارࣲ فَٱنۡهَارَ بِهِۦ فِی نَارِ جَهَنَّمَۗ وَٱللَّهُ لَا یَهۡدِی ٱلۡقَوۡمَ ٱلظَّـٰلِمِینَ"],[9,110,"لَا یَزَالُ بُنۡیَـٰنُهُمُ ٱلَّذِی بَنَوۡا۟ رِیبَةࣰ فِی قُلُوبِهِمۡ إِلَّاۤ أَن تَقَطَّعَ قُلُوبُهُمۡۗ وَٱللَّهُ عَلِیمٌ حَكِیمٌ"],[9,111,"۞ إِنَّ ٱللَّهَ ٱشۡتَرَىٰ مِنَ ٱلۡمُؤۡمِنِینَ أَنفُسَهُمۡ وَأَمۡوَٰلَهُم بِأَنَّ لَهُمُ ٱلۡجَنَّةَۚ یُقَـٰتِلُونَ فِی سَبِیلِ ٱللَّهِ فَیَقۡتُلُونَ وَیُقۡتَلُونَۖ وَعۡدًا عَلَیۡهِ حَقࣰّا فِی ٱلتَّوۡرَىٰةِ وَٱلۡإِنجِیلِ وَٱلۡقُرۡءَانِۚ وَمَنۡ أَوۡفَىٰ بِعَهۡدِهِۦ مِنَ ٱللَّهِۚ فَٱسۡتَبۡشِرُوا۟ بِبَیۡعِكُمُ ٱلَّذِی بَایَعۡتُم بِهِۦۚ وَذَٰلِكَ هُوَ ٱلۡفَوۡزُ ٱلۡعَظِیمُ"]]}