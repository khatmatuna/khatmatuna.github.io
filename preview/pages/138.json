["l",[["6:88","يَعۡمَلُونَ"],["6:88","۝٨٨",1],["6:89","أُوْلَٰٓئِكَ"],["6:89","ٱلَّذِينَ"],["6:89","ءَاتَيۡنَٰهُمُ"],["6:89","ٱلۡكِتَٰبَ"],["6:89","وَٱلۡحُكۡمَ"]]],["l",[["6:89","وَٱلنُّبُوَّةَۚ"],["6:89","فَإِن"],["6:89","يَكۡفُرۡ"],["6:89","بِهَا"],["6:89","هَٰٓؤُلَآءِ"],["6:89","فَقَدۡ"],["6:89","وَكَّلۡنَا"],["6:89","بِهَا"],["6:89","قَوۡمࣰا"],["6:89","لَّيۡسُواْ"]]],["l",[["6:89","بِهَا"],["6:89","بِكَٰفِرِينَ"],["6:89","۝٨٩",1],["6:90","أُوْلَٰٓئِكَ"],["6:90","ٱلَّذِينَ"],["6:90","هَدَى"],["6:90","ٱللَّهُۖ"],["6:90","فَبِهُدَىٰهُمُ"],["6:90","ٱقۡتَدِهۡۗ"]]],["l",[["6:90","قُل"],["6:90","لَّآ"],["6:90","أَسۡـَٔلُكُمۡ"],["6:90","عَلَيۡهِ"],["6:90","أَجۡرًاۖ"],["6:90","إِنۡ"],["6:90","هُوَ"],["6:90","إِلَّا"],["6:90","ذِكۡرَىٰ"],["6:90","لِلۡعَٰلَمِينَ"],["6:90","۝٩٠",1]]]],"a":[[6,82,"ٱلَّذِینَ ءَامَنُوا۟ وَلَمۡ یَلۡبِسُوۤا۟ إِیمَـٰنَهُم بِظُلۡمٍ أُو۟لَـٰۤئِكَ لَهُمُ ٱلۡأَمۡنُ وَهُم مُّهۡتَدُونَ"],[6,83,"وَتِلۡكَ حُجَّتُنَاۤ ءَاتَیۡنَـٰهَاۤ إِبۡرَٰهِیمَ عَلَىٰ قَوۡمِهِۦۚ نَرۡفَعُ دَرَجَـٰتࣲ مَّن نَّشَاۤءُۗ إِنَّ رَبَّكَ حَكِیمٌ عَلِیمࣱ"],[6,84,"وَوَهَبۡنَا لَهُۥۤ إِسۡحَـٰقَ وَیَعۡقُوبَۚ كُلًّا هَدَیۡنَاۚ وَنُوحًا هَدَیۡنَا مِن قَبۡلُۖ وَمِن ذُرِّیَّتِهِۦ دَاوُۥدَ وَسُلَیۡمَـٰنَ وَأَیُّوبَ وَیُوسُفَ وَمُوسَىٰ وَهَـٰرُونَۚ وَكَذَٰلِكَ نَجۡزِی ٱلۡمُحۡسِنِینَ"],[6,85,"وَزَكَرِیَّا وَیَحۡیَىٰ وَعِیسَىٰ وَإِلۡیَاسَۖ كُلࣱّ مِّنَ ٱلصَّـٰلِحِینَ"],[6,86,"وَإِسۡمَـٰعِیلَ وَٱلۡیَسَعَ وَیُونُسَ وَلُوطࣰاۚ وَكُلࣰّا فَضَّلۡنَا عَلَى ٱلۡعَـٰلَمِینَ"],[6,87,"وَمِنۡ ءَابَاۤئِهِمۡ وَذُرِّیَّـٰتِهِمۡ وَإِخۡوَٰنِهِمۡۖ وَٱجۡتَبَیۡنَـٰهُمۡ وَهَدَیۡنَـٰهُمۡ إِلَىٰ صِرَٰطࣲ مُّسۡتَقِیمࣲ"],[6,88,"ذَٰلِكَ هُدَى ٱللَّهِ یَهۡدِی بِهِۦ مَن یَشَاۤءُ مِنۡ عِبَادِهِۦۚ وَلَوۡ أَشۡرَكُوا۟ لَحَبِطَ عَنۡهُم مَّا كَانُوا۟ یَعۡمَلُونَ"],[6,89,"أُو۟لَـٰۤئِكَ ٱلَّذِینَ ءَاتَیۡنَـٰهُمُ ٱلۡكِتَـٰبَ وَٱلۡحُكۡمَ وَٱلنُّبُوَّةَۚ فَإِن یَكۡفُرۡ بِهَا هَـٰۤؤُلَاۤءِ فَقَدۡ وَكَّلۡنَا بِهَا قَوۡمࣰا لَّیۡسُوا۟ بِهَا بِكَـٰفِرِینَ"],[6,90,"أُو۟لَـٰۤئِكَ ٱلَّذِینَ هَدَى ٱللَّهُۖ فَبِهُدَىٰهُمُ ٱقۡتَدِهۡۗ قُل لَّاۤ أَسۡءَلُكُمۡ عَلَیۡهِ أَجۡرًاۖ إِنۡ هُوَ إِلَّا ذِكۡرَىٰ لِلۡعَـٰلَمِینَ"]]}