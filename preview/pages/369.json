َ"],[26,47,"قَالُوۤا۟ ءَامَنَّا بِرَبِّ ٱلۡعَـٰلَمِینَ"],[26,48,"رَبِّ مُوسَىٰ وَهَـٰرُونَ"],[26,49,"قَالَ ءَامَنتُمۡ لَهُۥ قَبۡلَ أَنۡ ءَاذَنَ لَكُمۡۖ إِنَّهُۥ لَكَبِیرُكُمُ ٱلَّذِی عَلَّمَكُمُ ٱلسِّحۡرَ فَلَسَوۡفَ تَعۡلَمُونَۚ لَأُقَطِّعَنَّ أَیۡدِیَكُمۡ وَأَرۡجُلَكُم مِّنۡ خِلَـٰفࣲ وَلَأُصَلِّبَنَّكُمۡ أَجۡمَعِینَ"],[26,50,"قَالُوا۟ لَا ضَیۡرَۖ إِنَّاۤ إِلَىٰ رَبِّنَا مُنقَلِبُونَ"],[26,51,"إِنَّا نَطۡمَعُ أَن یَغۡفِرَ لَنَا رَبُّنَا خَطَـٰیَـٰنَاۤ أَن كُنَّاۤ أَوَّلَ ٱلۡمُؤۡمِنِینَ"],[26,52,"۞ وَأَوۡحَیۡنَاۤ إِلَىٰ مُوسَىٰۤ أَنۡ أَسۡرِ بِعِبَادِیۤ إِنَّكُم مُّتَّبَعُونَ"],[26,53,"فَأَرۡسَلَ فِرۡعَوۡنُ فِی ٱلۡمَدَاۤئِنِ حَـٰشِرِینَ"],[26,54,"إِنَّ هَـٰۤؤُلَاۤءِ لَشِرۡذِمَةࣱ قَلِیلُونَ"],[26,55,"وَإِنَّهُمۡ لَنَا لَغَاۤئِظُونَ"],[26,56,"وَإِنَّا لَجَمِیعٌ حَـٰذِرُونَ"],[26,57,"فَأَخۡرَجۡنَـٰهُم مِّن جَنَّـٰتࣲ وَعُیُونࣲ"],[26,58,"وَكُنُوزࣲ وَمَقَامࣲ كَرِیمࣲ"],[26,59,"كَذَٰلِكَۖ وَأَوۡرَثۡنَـٰهَا بَنِیۤ إِسۡرَٰۤءِیلَ"],[26,60,"فَأَتۡبَعُوهُم مُّشۡرِقِینَ"]]}