"8:38","۝٣٨",1],["8:39","وَقَٰتِلُوهُمۡ"],["8:39","حَتَّىٰ"]]],["l",[["8:39","لَا"],["8:39","تَكُونَ"],["8:39","فِتۡنَةࣱ"],["8:39","وَيَكُونَ"],["8:39","ٱلدِّينُ"],["8:39","كُلُّهُۥ"],["8:39","لِلَّهِۚ"],["8:39","فَإِنِ"]]],["l",[["8:39","ٱنتَهَوۡاْ"],["8:39","فَإِنَّ"],["8:39","ٱللَّهَ"],["8:39","بِمَا"],["8:39","يَعۡمَلُونَ"],["8:39","بَصِيرࣱ"],["8:39","۝٣٩",1],["8:40","وَإِن"],["8:40","تَوَلَّوۡاْ"]]],["l",[["8:40","فَٱعۡلَمُوٓاْ"],["8:40","أَنَّ"],["8:40","ٱللَّهَ"],["8:40","مَوۡلَىٰكُمۡۚ"],["8:40","نِعۡمَ"],["8:40","ٱلۡمَوۡلَىٰ"],["8:40","وَنِعۡمَ"],["8:40","ٱلنَّصِيرُ"],["8:40","۝٤٠",1]]]],"a":[[8,34,"وَمَا لَهُمۡ أَلَّا یُعَذِّبَهُمُ ٱللَّهُ وَهُمۡ یَصُدُّونَ عَنِ ٱلۡمَسۡجِدِ ٱلۡحَرَامِ وَمَا كَانُوۤا۟ أَوۡلِیَاۤءَهُۥۤۚ إِنۡ أَوۡلِیَاۤؤُهُۥۤ إِلَّا ٱلۡمُتَّقُونَ وَلَـٰكِنَّ أَكۡثَرَهُمۡ لَا یَعۡلَمُونَ"],[8,35,"وَمَا كَانَ صَلَاتُهُمۡ عِندَ ٱلۡبَیۡتِ إِلَّا مُكَاۤءࣰ وَتَصۡدِیَةࣰۚ فَذُوقُوا۟ ٱلۡعَذَابَ بِمَا كُنتُمۡ تَكۡفُرُونَ"],[8,36,"إِنَّ ٱلَّذِینَ كَفَرُوا۟ یُنفِقُونَ أَمۡوَٰلَهُمۡ لِیَصُدُّوا۟ عَن سَبِیلِ ٱللَّهِۚ فَسَیُنفِقُونَهَا ثُمَّ تَكُونُ عَلَیۡهِمۡ حَسۡرَةࣰ ثُمَّ یُغۡلَبُونَۗ وَٱلَّذِینَ كَفَرُوۤا۟ إِلَىٰ جَهَنَّمَ یُحۡشَرُونَ"],[8,37,"لِیَمِیزَ ٱللَّهُ ٱلۡخَبِیثَ مِنَ ٱلطَّیِّبِ وَیَجۡعَلَ ٱلۡخَبِیثَ بَعۡضَهُۥ عَلَىٰ بَعۡضࣲ فَیَرۡكُمَهُۥ جَمِیعࣰا فَیَجۡعَلَهُۥ فِی جَهَنَّمَۚ أُو۟لَـٰۤئِكَ هُمُ ٱلۡخَـٰسِرُونَ"],[8,38,"قُل لِّلَّذِینَ كَفَرُوۤا۟ إِن یَنتَهُوا۟ یُغۡفَرۡ لَهُم مَّا قَدۡ سَلَفَ وَإِن یَعُودُوا۟ فَقَدۡ مَضَتۡ سُنَّتُ ٱلۡأَوَّلِینَ"],[8,39,"وَقَـٰتِلُوهُمۡ حَتَّىٰ لَا تَكُونَ فِتۡنَةࣱ وَیَكُونَ ٱلدِّینُ كُلُّهُۥ لِلَّهِۚ فَإِنِ ٱنتَهَوۡا۟ فَإِنَّ ٱللَّهَ بِمَا یَعۡمَلُونَ بَصِیرࣱ"],[8,40,"وَإِن تَوَلَّوۡا۟ فَٱعۡلَمُوۤا۟ أَنَّ ٱللَّهَ مَوۡلَىٰكُمۡۚ نِعۡمَ ٱلۡمَوۡلَىٰ وَنِعۡمَ ٱلنَّصِیرُ"]]}