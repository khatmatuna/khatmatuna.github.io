],["42:8","لَهُم"],["42:8","مِّن"],["42:8","وَلِيࣲّ"],["42:8","وَلَا"],["42:8","نَصِيرٍ"],["42:8","۝٨",1],["42:9","أَمِ"]]],["l",[["42:9","ٱتَّخَذُواْ"],["42:9","مِن"],["42:9","دُونِهِۦٓ"],["42:9","أَوۡلِيَآءَۖ"],["42:9","فَٱللَّهُ"],["42:9","هُوَ"],["42:9","ٱلۡوَلِيُّ"],["42:9","وَهُوَ"],["42:9","يُحۡيِ"],["42:9","ٱلۡمَوۡتَىٰ"],["42:9","وَهُوَ"]]],["l",[["42:9","عَلَىٰ"],["42:9","كُلِّ"],["42:9","شَيۡءࣲ"],["42:9","قَدِيرࣱ"],["42:9","۝٩",1],["42:10","وَمَا"],["42:10","ٱخۡتَلَفۡتُمۡ"],["42:10","فِيهِ"],["42:10","مِن"],["42:10","شَيۡءࣲ"],["42:10","فَحُكۡمُهُۥٓ"]]],["l",[["42:10","إِلَى"],["42:10","ٱللَّهِۚ"],["42:10","ذَٰلِكُمُ"],["42:10","ٱللَّهُ"],["42:10","رَبِّي"],["42:10","عَلَيۡهِ"],["42:10","تَوَكَّلۡتُ"],["42:10","وَإِلَيۡهِ"],["42:10","أُنِيبُ"],["42:10","۝١٠",1]]]],"a":[[42,1,"حمۤ"],[42,2,"عۤسۤقۤ"],[42,3,"كَذَٰلِكَ یُوحِیۤ إِلَیۡكَ وَإِلَى ٱلَّذِینَ مِن قَبۡلِكَ ٱللَّهُ ٱلۡعَزِیزُ ٱلۡحَكِیمُ"],[42,4,"لَهُۥ مَا فِی ٱلسَّمَـٰوَٰتِ وَمَا فِی ٱلۡأَرۡضِۖ وَهُوَ ٱلۡعَلِیُّ ٱلۡعَظِیمُ"],[42,5,"تَكَادُ ٱلسَّمَـٰوَٰتُ یَتَفَطَّرۡنَ مِن فَوۡقِهِنَّۚ وَٱلۡمَلَـٰۤئِكَةُ یُسَبِّحُونَ بِحَمۡدِ رَبِّهِمۡ وَیَسۡتَغۡفِرُونَ لِمَن فِی ٱلۡأَرۡضِۗ أَلَاۤ إِنَّ ٱللَّهَ هُوَ ٱلۡغَفُورُ ٱلرَّحِیمُ"],[42,6,"وَٱلَّذِینَ ٱتَّخَذُوا۟ مِن دُونِهِۦۤ أَوۡلِیَاۤءَ ٱللَّهُ حَفِیظٌ عَلَیۡهِمۡ وَمَاۤ أَنتَ عَلَیۡهِم بِوَكِیلࣲ"],[42,7,"وَكَذَٰلِكَ أَوۡحَیۡنَاۤ إِلَیۡكَ قُرۡءَانًا عَرَبِیࣰّا لِّتُنذِرَ أُمَّ ٱلۡقُرَىٰ وَمَنۡ حَوۡلَهَا وَتُنذِرَ یَوۡمَ ٱلۡجَمۡعِ لَا رَیۡبَ فِیهِۚ فَرِیقࣱ فِی ٱلۡجَنَّةِ وَفَرِیقࣱ فِی ٱلسَّعِیرِ"],[42,8,"وَلَوۡ شَاۤءَ ٱللَّهُ لَجَعَلَهُمۡ أُمَّةࣰ وَٰحِدَةࣰ وَلَـٰكِن یُدۡخِلُ مَن یَشَاۤءُ فِی رَحۡمَتِهِۦۚ وَٱلظَّـٰلِمُونَ مَا لَهُم مِّن وَلِیࣲّ وَلَا نَصِیرٍ"],[42,9,"أَمِ ٱتَّخَذُوا۟ مِن دُونِهِۦۤ أَوۡلِیَاۤءَۖ فَٱللَّهُ هُوَ ٱلۡوَلِیُّ وَهُوَ یُحۡیِ ٱلۡمَوۡتَىٰ وَهُوَ عَلَىٰ كُلِّ شَیۡءࣲ قَدِیرࣱ"],[42,10,"وَمَا ٱخۡتَلَفۡتُمۡ فِیهِ مِن شَیۡءࣲ فَحُكۡمُهُۥۤ إِلَى ٱللَّهِۚ ذَٰلِكُمُ ٱللَّهُ رَبِّی عَلَیۡهِ تَوَكَّلۡتُ وَإِلَیۡهِ أُنِیبُ"]]}