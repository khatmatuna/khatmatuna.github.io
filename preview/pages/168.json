وۡمُ"],["7:148","مُوسَىٰ"],["7:148","مِنۢ"],["7:148","بَعۡدِهِۦ"],["7:148","مِنۡ"],["7:148","حُلِيِّهِمۡ"]]],["l",[["7:148","عِجۡلࣰا"],["7:148","جَسَدࣰا"],["7:148","لَّهُۥ"],["7:148","خُوَارٌۚ"],["7:148","أَلَمۡ"],["7:148","يَرَوۡاْ"],["7:148","أَنَّهُۥ"],["7:148","لَا"],["7:148","يُكَلِّمُهُمۡ"]]],["l",[["7:148","وَلَا"],["7:148","يَهۡدِيهِمۡ"],["7:148","سَبِيلًاۘ"],["7:148","ٱتَّخَذُوهُ"],["7:148","وَكَانُواْ"],["7:148","ظَٰلِمِينَ"],["7:148","۝١٤٨",1]]],["l",[["7:149","وَلَمَّا"],["7:149","سُقِطَ"],["7:149","فِيٓ"],["7:149","أَيۡدِيهِمۡ"],["7:149","وَرَأَوۡاْ"],["7:149","أَنَّهُمۡ"],["7:149","قَدۡ"],["7:149","ضَلُّواْ"],["7:149","قَالُواْ"],["7:149","لَئِن"]]],["l",[["7:149","لَّمۡ"],["7:149","يَرۡحَمۡنَا"],["7:149","رَبُّنَا"],["7:149","وَيَغۡفِرۡ"],["7:149","لَنَا"],["7:149","لَنَكُونَنَّ"],["7:149","مِنَ"],["7:149","ٱلۡخَٰسِرِينَ"],["7:149","۝١٤٩",1]]]],"a":[[7,144,"قَالَ یَـٰمُوسَىٰۤ إِنِّی ٱصۡطَفَیۡتُكَ عَلَى ٱلنَّاسِ بِرِسَـٰلَـٰتِی وَبِكَلَـٰمِی فَخُذۡ مَاۤ ءَاتَیۡتُكَ وَكُن مِّنَ ٱلشَّـٰكِرِینَ"],[7,145,"وَكَتَبۡنَا لَهُۥ فِی ٱلۡأَلۡوَاحِ مِن كُلِّ شَیۡءࣲ مَّوۡعِظَةࣰ وَتَفۡصِیلࣰا لِّكُلِّ شَیۡءࣲ فَخُذۡهَا بِقُوَّةࣲ وَأۡمُرۡ قَوۡمَكَ یَأۡخُذُوا۟ بِأَحۡسَنِهَاۚ سَأُو۟رِیكُمۡ دَارَ ٱلۡفَـٰسِقِینَ"],[7,146,"سَأَصۡرِفُ عَنۡ ءَایَـٰتِیَ ٱلَّذِینَ یَتَكَبَّرُونَ فِی ٱلۡأَرۡضِ بِغَیۡرِ ٱلۡحَقِّ وَإِن یَرَوۡا۟ كُلَّ ءَایَةࣲ لَّا یُؤۡمِنُوا۟ بِهَا وَإِن یَرَوۡا۟ سَبِیلَ ٱلرُّشۡدِ لَا یَتَّخِذُوهُ سَبِیلࣰا وَإِن یَرَوۡا۟ سَبِیلَ ٱلۡغَیِّ یَتَّخِذُوهُ سَبِیلࣰاۚ ذَٰلِكَ بِأَنَّهُمۡ كَذَّبُوا۟ بِءَایَـٰتِنَا وَكَانُوا۟ عَنۡهَا غَـٰفِلِینَ"],[7,147,"وَٱلَّذِینَ كَذَّبُوا۟ بِءَایَـٰتِنَا وَلِقَاۤءِ ٱلۡءَاخِرَةِ حَبِطَتۡ أَعۡمَـٰلُهُمۡۚ هَلۡ یُجۡزَوۡنَ إِلَّا مَا كَانُوا۟ یَعۡمَلُونَ"],[7,148,"وَٱتَّخَذَ قَوۡمُ مُوسَىٰ مِنۢ بَعۡدِهِۦ مِنۡ حُلِیِّهِمۡ عِجۡلࣰا جَسَدࣰا لَّهُۥ خُوَارٌۚ أَلَمۡ یَرَوۡا۟ أَنَّهُۥ لَا یُكَلِّمُهُمۡ وَلَا یَهۡدِیهِمۡ سَبِیلًاۘ ٱتَّخَذُوهُ وَكَانُوا۟ ظَـٰلِمِینَ"],[7,149,"وَلَمَّا سُقِطَ فِیۤ أَیۡدِیهِمۡ وَرَأَوۡا۟ أَنَّهُمۡ قَدۡ ضَلُّوا۟ قَالُوا۟ لَئِن لَّمۡ یَرۡحَمۡنَا رَبُّنَا وَیَغۡفِرۡ لَنَا لَنَكُونَنَّ مِنَ ٱلۡخَـٰسِرِینَ"]]}