["l",[["6:141","كُلُواْ"],["6:141","مِن"],["6:141","ثَمَرِهِۦٓ"],["6:141","إِذَآ"],["6:141","أَثۡمَرَ"],["6:141","وَءَاتُواْ"],["6:141","حَقَّهُۥ"],["6:141","يَوۡمَ"],["6:141","حَصَادِهِۦۖ"]]],["l",[["6:141","وَلَا"],["6:141","تُسۡرِفُوٓاْۚ"],["6:141","إِنَّهُۥ"],["6:141","لَا"],["6:141","يُحِبُّ"],["6:141","ٱلۡمُسۡرِفِينَ"],["6:141","۝١٤١",1],["6:142","وَمِنَ"],["6:142","ٱلۡأَنۡعَٰمِ"]]],["l",[["6:142","حَمُولَةࣰ"],["6:142","وَفَرۡشࣰاۚ"],["6:142","كُلُواْ"],["6:142","مِمَّا"],["6:142","رَزَقَكُمُ"],["6:142","ٱللَّهُ"],["6:142","وَلَا"],["6:142","تَتَّبِعُواْ"]]],["l",[["6:142","خُطُوَٰتِ"],["6:142","ٱلشَّيۡطَٰنِۚ"],["6:142","إِنَّهُۥ"],["6:142","لَكُمۡ"],["6:142","عَدُوࣱّ"],["6:142","مُّبِينࣱ"],["6:142","۝١٤٢",1]]]],"a":[[6,138,"وَقَالُوا۟ هَـٰذِهِۦۤ أَنۡعَـٰمࣱ وَحَرۡثٌ حِجۡرࣱ لَّا یَطۡعَمُهَاۤ إِلَّا مَن نَّشَاۤءُ بِزَعۡمِهِمۡ وَأَنۡعَـٰمٌ حُرِّمَتۡ ظُهُورُهَا وَأَنۡعَـٰمࣱ لَّا یَذۡكُرُونَ ٱسۡمَ ٱللَّهِ عَلَیۡهَا ٱفۡتِرَاۤءً عَلَیۡهِۚ سَیَجۡزِیهِم بِمَا كَانُوا۟ یَفۡتَرُونَ"],[6,139,"وَقَالُوا۟ مَا فِی بُطُونِ هَـٰذِهِ ٱلۡأَنۡعَـٰمِ خَالِصَةࣱ لِّذُكُورِنَا وَمُحَرَّمٌ عَلَىٰۤ أَزۡوَٰجِنَاۖ وَإِن یَكُن مَّیۡتَةࣰ فَهُمۡ فِیهِ شُرَكَاۤءُۚ سَیَجۡزِیهِمۡ وَصۡفَهُمۡۚ إِنَّهُۥ حَكِیمٌ عَلِیمࣱ"],[6,140,"قَدۡ خَسِرَ ٱلَّذِینَ قَتَلُوۤا۟ أَوۡلَـٰدَهُمۡ سَفَهَۢا بِغَیۡرِ عِلۡمࣲ وَحَرَّمُوا۟ مَا رَزَقَهُمُ ٱللَّهُ ٱفۡتِرَاۤءً عَلَى ٱللَّهِۚ قَدۡ ضَلُّوا۟ وَمَا كَانُوا۟ مُهۡتَدِینَ"],[6,141,"۞ وَهُوَ ٱلَّذِیۤ أَنشَأَ جَنَّـٰتࣲ مَّعۡرُوشَـٰتࣲ وَغَیۡرَ مَعۡرُوشَـٰتࣲ وَٱلنَّخۡلَ وَٱلزَّرۡعَ مُخۡتَلِفًا أُكُلُهُۥ وَٱلزَّیۡتُونَ وَٱلرُّمَّانَ مُتَشَـٰبِهࣰا وَغَیۡرَ مُتَشَـٰبِهࣲۚ كُلُوا۟ مِن ثَمَرِهِۦۤ إِذَاۤ أَثۡمَرَ وَءَاتُوا۟ حَقَّهُۥ یَوۡمَ حَصَادِهِۦۖ وَلَا تُسۡرِفُوۤا۟ۚ إِنَّهُۥ لَا یُحِبُّ ٱلۡمُسۡرِفِینَ"],[6,142,"وَمِنَ ٱلۡأَنۡعَـٰمِ حَمُولَةࣰ وَفَرۡشࣰاۚ كُلُوا۟ مِمَّا رَزَقَكُمُ ٱللَّهُ وَلَا تَتَّبِعُوا۟ خُطُوَٰتِ ٱلشَّیۡطَـٰنِۚ إِنَّهُۥ لَكُمۡ عَدُوࣱّ مُّبِینࣱ"]]}