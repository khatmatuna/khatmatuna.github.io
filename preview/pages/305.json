{"p":305,"juz":16,"rows":[["h",19],["b"],["l",[["19:1","كٓهيعٓصٓ"],["19:1","۝١",1],["19:2","ذِكۡرُ"],["19:2","رَحۡمَتِ"],["19:2","رَبِّكَ"],["19:2","عَبۡدَهُۥ"],["19:2","زَكَرِيَّآ"],["19:2","۝٢",1],["19:3","إِذۡ"]]],["l",[["19:3","نَادَىٰ"],["19:3","رَبَّهُۥ"],["19:3","نِدَآءً"],["19:3","خَفِيࣰّا"],["19:3","۝٣",1],["19:4","قَالَ"],["19:4","رَبِّ"],["19:4","إِنِّي"],["19:4","وَهَنَ"],["19:4","ٱلۡعَظۡمُ"],["19:4","مِنِّي"]]],["l",[["19:4","وَٱشۡتَعَلَ"],["19:4","ٱلرَّأۡسُ"],["19:4","شَيۡبࣰا"],["19:4","وَلَمۡ"],["19:4","أَكُنۢ"],["19:4","بِدُعَآئِكَ"],["19:4","رَبِّ"],["19:4","شَقِيࣰّا"],["19:4","۝٤",1]]],["l",[["19:5","وَإِنِّي"],["19:5","خِفۡتُ"],["19:5","ٱلۡمَوَٰلِيَ"],["19:5","مِن"],["19:5","وَرَآءِي"],["19:5","وَكَانَتِ"],["19:5","ٱمۡرَأَتِي"]]],["l",[["19:5","عَاقِرࣰا"],["19:5","فَهَبۡ"],["19:5","لِي"],["19:5","مِن"],["19:5","لَّدُنكَ"],["19:5","وَلِيࣰّا"],["19:5","۝٥",1],["19:6","يَرِثُنِي"],["19:6","وَيَرِثُ"],["19:6","مِنۡ"]]],["l",[["19:6","ءَالِ"],["19:6","يَعۡقُوبَۖ"],["19:6","وَٱجۡعَلۡهُ"],["19:6","رَبِّ"],["19:6","رَضِيࣰّا"],["19:6","۝٦",1],["19:7","يَٰزَكَرِيَّآ"],["19:7","إِنَّا"]]],["l",[["19:7","نُبَشِّرُكَ"],["19:7","بِغُلَٰمٍ"],["19:7","ٱسۡمُهُۥ"],["19:7","يَحۡيَىٰ"],["19:7","لَمۡ"],["19:7","نَجۡعَل"],["19:7","لَّهُۥ"],["19:7","مِن"],["19:7","قَبۡلُ"],["19:7","سَمِيࣰّا"],["19:7","۝٧",1]]],["l",[["19:8","قَالَ"],["19:8","رَبِّ"],["19:8","أَنَّىٰ"],["19:8","يَكُونُ"],["19:8","لِي"],["19:8","غُلَٰمࣱ"],["19:8","وَكَانَتِ"],["19:8","ٱمۡرَأَتِي"],["19:8","عَاقِرࣰا"]]],["l",[["19:8","وَقَدۡ"],["19:8","بَلَغۡتُ"],["19:8","مِنَ"],["19:8","ٱلۡكِبَرِ"],["19:8","عِتِيࣰّا"],["19:8","۝٨",1],["19:9","قَالَ"],["19:9","كَذَٰلِكَ"],["19:9","قَالَ"]]],["l",[["19:9","رَبُّكَ"],["19:9","هُوَ"],["19:9","عَلَيَّ"],["19:9","هَيِّنࣱ"],["19:9","وَقَدۡ"],["19:9","خَلَقۡتُكَ"],["19:9","مِن"],["19:9","قَبۡلُ"],["19:9","وَلَمۡ"],["19:9","تَكُ"]]],["l",[["19:9","شَيۡـࣰٔا"],["19:9","۝٩",1],["19:10","قَالَ"],["19:10","رَبِّ"],["19:10","ٱجۡعَل"],["19:10","لِّيٓ"],["19:10","ءَايَةࣰۖ"],["19:10","قَالَ"],["19:10","ءَايَتُكَ"],["19:10","أَلَّا"]]],["l",[["19:10","تُكَلِّمَ"],["19:10","ٱلنَّاسَ"],["19:10","ثَلَٰثَ"],["19:10","لَيَالࣲ"],["19:10","سَوِيࣰّا"],["19:10","۝١٠",1],["19:11","فَخَرَجَ"],["19:11","عَلَىٰ"],["19:11","قَوۡمِهِۦ"],["19:11","مِنَ"]]],["l",[["19:11","ٱلۡمِحۡرَابِ"],["19:11","فَأَوۡحَىٰٓ"],["19:11","إِلَيۡهِمۡ"],["19:11","أَن"],["19:11","سَبِّحُواْ"],["19:11","بُكۡرَةࣰ"],["19:11","وَعَشِيࣰّا"],["19:11","۝١١",1]]]],"a":[[19,1,"كۤهیعۤصۤ"],[19,2,"ذِكۡرُ رَحۡمَتِ رَبِّكَ عَبۡدَهُۥ زَكَرِیَّاۤ"],[19,3,"إِذۡ نَادَىٰ رَبَّهُۥ نِدَاۤءً خَفِیࣰّا"],[19,4,"قَالَ رَبِّ إِنِّی وَهَنَ ٱلۡعَظۡمُ مِنِّی وَٱشۡتَعَلَ ٱلرَّأۡسُ شَیۡبࣰا وَلَمۡ أَكُنۢ بِدُعَاۤئِكَ رَبِّ شَقِیࣰّا"],[19,5,"وَإِنِّی خِفۡتُ ٱلۡمَوَٰلِیَ مِن وَرَاۤءِی وَكَانَتِ ٱمۡرَأَتِی عَاقِرࣰا فَهَبۡ لِی مِن لَّدُنكَ وَلِیࣰّا"],[19,6,"یَرِثُنِی وَیَرِثُ مِنۡ ءَالِ یَعۡقُوبَۖ وَٱجۡعَلۡهُ رَبِّ رَضِیࣰّا"],[19,7,"یَـٰزَكَرِیَّاۤ إِنَّا نُبَشِّرُكَ بِغُلَـٰمٍ ٱسۡمُهُۥ یَحۡیَىٰ لَمۡ نَجۡعَل لَّهُۥ مِن قَبۡلُ سَمِیࣰّا"],[19,8,"قَالَ رَبِّ أَنَّىٰ یَكُونُ لِی غُلَـٰمࣱ وَكَانَتِ ٱمۡرَأَتِی عَاقِرࣰا وَقَدۡ بَلَغۡتُ مِنَ ٱلۡكِبَرِ عِتِیࣰّا"],[19,9,"قَالَ كَذَٰلِكَ قَالَ رَبُّكَ هُوَ عَلَیَّ هَیِّنࣱ وَقَدۡ خَلَقۡتُكَ مِن قَبۡلُ وَلَمۡ تَكُ شَیۡءࣰا"],[19,10,"قَالَ رَبِّ ٱجۡعَل لِّیۤ ءَایَةࣰۖ قَالَ ءَایَتُكَ أَلَّا تُكَلِّمَ ٱلنَّاسَ ثَلَـٰثَ لَیَالࣲ سَوِیࣰّا"],[19,11,"فَخَرَجَ عَلَىٰ قَوۡمِهِۦ مِنَ ٱلۡمِحۡرَابِ فَأَوۡحَىٰۤ إِلَیۡهِمۡ أَن سَبِّحُوا۟ بُكۡرَةࣰ وَعَشِیࣰّا"]]}