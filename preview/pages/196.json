["9:60","وَٱبۡنِ"],["9:60","ٱلسَّبِيلِۖ"],["9:60","فَرِيضَةࣰ"]]],["l",[["9:60","مِّنَ"],["9:60","ٱللَّهِۗ"],["9:60","وَٱللَّهُ"],["9:60","عَلِيمٌ"],["9:60","حَكِيمࣱ"],["9:60","۝٦٠",1],["9:61","وَمِنۡهُمُ"],["9:61","ٱلَّذِينَ"],["9:61","يُؤۡذُونَ"]]],["l",[["9:61","ٱلنَّبِيَّ"],["9:61","وَيَقُولُونَ"],["9:61","هُوَ"],["9:61","أُذُنࣱۚ"],["9:61","قُلۡ"],["9:61","أُذُنُ"],["9:61","خَيۡرࣲ"],["9:61","لَّكُمۡ"],["9:61","يُؤۡمِنُ"]]],["l",[["9:61","بِٱللَّهِ"],["9:61","وَيُؤۡمِنُ"],["9:61","لِلۡمُؤۡمِنِينَ"],["9:61","وَرَحۡمَةࣱ"],["9:61","لِّلَّذِينَ"],["9:61","ءَامَنُواْ"]]],["l",[["9:61","مِنكُمۡۚ"],["9:61","وَٱلَّذِينَ"],["9:61","يُؤۡذُونَ"],["9:61","رَسُولَ"],["9:61","ٱللَّهِ"],["9:61","لَهُمۡ"],["9:61","عَذَابٌ"],["9:61","أَلِيمࣱ"],["9:61","۝٦١",1]]]],"a":[[9,55,"فَلَا تُعۡجِبۡكَ أَمۡوَٰلُهُمۡ وَلَاۤ أَوۡلَـٰدُهُمۡۚ إِنَّمَا یُرِیدُ ٱللَّهُ لِیُعَذِّبَهُم بِهَا فِی ٱلۡحَیَوٰةِ ٱلدُّنۡیَا وَتَزۡهَقَ أَنفُسُهُمۡ وَهُمۡ كَـٰفِرُونَ"],[9,56,"وَیَحۡلِفُونَ بِٱللَّهِ إِنَّهُمۡ لَمِنكُمۡ وَمَا هُم مِّنكُمۡ وَلَـٰكِنَّهُمۡ قَوۡمࣱ یَفۡرَقُونَ"],[9,57,"لَوۡ یَجِدُونَ مَلۡجَءًا أَوۡ مَغَـٰرَٰتٍ أَوۡ مُدَّخَلࣰا لَّوَلَّوۡا۟ إِلَیۡهِ وَهُمۡ یَجۡمَحُونَ"],[9,58,"وَمِنۡهُم مَّن یَلۡمِزُكَ فِی ٱلصَّدَقَـٰتِ فَإِنۡ أُعۡطُوا۟ مِنۡهَا رَضُوا۟ وَإِن لَّمۡ یُعۡطَوۡا۟ مِنۡهَاۤ إِذَا هُمۡ یَسۡخَطُونَ"],[9,59,"وَلَوۡ أَنَّهُمۡ رَضُوا۟ مَاۤ ءَاتَىٰهُمُ ٱللَّهُ وَرَسُولُهُۥ وَقَالُوا۟ حَسۡبُنَا ٱللَّهُ سَیُؤۡتِینَا ٱللَّهُ مِن فَضۡلِهِۦ وَرَسُولُهُۥۤ إِنَّاۤ إِلَى ٱللَّهِ رَٰغِبُونَ"],[9,60,"۞ إِنَّمَا ٱلصَّدَقَـٰتُ لِلۡفُقَرَاۤءِ وَٱلۡمَسَـٰكِینِ وَٱلۡعَـٰمِلِینَ عَلَیۡهَا وَٱلۡمُؤَلَّفَةِ قُلُوبُهُمۡ وَفِی ٱلرِّقَابِ وَٱلۡغَـٰرِمِینَ وَفِی سَبِیلِ ٱللَّهِ وَٱبۡنِ ٱلسَّبِیلِۖ فَرِیضَةࣰ مِّنَ ٱللَّهِۗ وَٱللَّهُ عَلِیمٌ حَكِیمࣱ"],[9,61,"وَمِنۡهُمُ ٱلَّذِینَ یُؤۡذُونَ ٱلنَّبِیَّ وَیَقُولُونَ هُوَ أُذُنࣱۚ قُلۡ أُذُنُ خَیۡرࣲ لَّكُمۡ یُؤۡمِنُ بِٱللَّهِ وَیُؤۡمِنُ لِلۡمُؤۡمِنِینَ وَرَحۡمَةࣱ لِّلَّذِینَ ءَامَنُوا۟ مِنكُمۡۚ وَٱلَّذِینَ یُؤۡذُونَ رَسُولَ ٱللَّهِ لَهُمۡ عَذَابٌ أَلِیمࣱ"]]}