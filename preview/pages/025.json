َ"],["2:167","ٱتَّبَعُواْ"],["2:167","لَوۡ"],["2:167","أَنَّ"]]],["l",[["2:167","لَنَا"],["2:167","كَرَّةࣰ"],["2:167","فَنَتَبَرَّأَ"],["2:167","مِنۡهُمۡ"],["2:167","كَمَا"],["2:167","تَبَرَّءُواْ"],["2:167","مِنَّاۗ"],["2:167","كَذَٰلِكَ"],["2:167","يُرِيهِمُ"],["2:167","ٱللَّهُ"]]],["l",[["2:167","أَعۡمَٰلَهُمۡ"],["2:167","حَسَرَٰتٍ"],["2:167","عَلَيۡهِمۡۖ"],["2:167","وَمَا"],["2:167","هُم"],["2:167","بِخَٰرِجِينَ"],["2:167","مِنَ"],["2:167","ٱلنَّارِ"],["2:167","۝١٦٧",1]]],["l",[["2:168","يَٰٓأَيُّهَا"],["2:168","ٱلنَّاسُ"],["2:168","كُلُواْ"],["2:168","مِمَّا"],["2:168","فِي"],["2:168","ٱلۡأَرۡضِ"],["2:168","حَلَٰلࣰا"],["2:168","طَيِّبࣰا"],["2:168","وَلَا"],["2:168","تَتَّبِعُواْ"]]],["l",[["2:168","خُطُوَٰتِ"],["2:168","ٱلشَّيۡطَٰنِۚ"],["2:168","إِنَّهُۥ"],["2:168","لَكُمۡ"],["2:168","عَدُوࣱّ"],["2:168","مُّبِينٌ"],["2:168","۝١٦٨",1],["2:169","إِنَّمَا"],["2:169","يَأۡمُرُكُم"]]],["l",[["2:169","بِٱلسُّوٓءِ"],["2:169","وَٱلۡفَحۡشَآءِ"],["2:169","وَأَن"],["2:169","تَقُولُواْ"],["2:169","عَلَى"],["2:169","ٱللَّهِ"],["2:169","مَا"],["2:169","لَا"],["2:169","تَعۡلَمُونَ"],["2:169","۝١٦٩",1]]]],"a":[[2,164,"إِنَّ فِی خَلۡقِ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِ وَٱخۡتِلَـٰفِ ٱلَّیۡلِ وَٱلنَّهَارِ وَٱلۡفُلۡكِ ٱلَّتِی تَجۡرِی فِی ٱلۡبَحۡرِ بِمَا یَنفَعُ ٱلنَّاسَ وَمَاۤ أَنزَلَ ٱللَّهُ مِنَ ٱلسَّمَاۤءِ مِن مَّاۤءࣲ فَأَحۡیَا بِهِ ٱلۡأَرۡضَ بَعۡدَ مَوۡتِهَا وَبَثَّ فِیهَا مِن كُلِّ دَاۤبَّةࣲ وَتَصۡرِیفِ ٱلرِّیَـٰحِ وَٱلسَّحَابِ ٱلۡمُسَخَّرِ بَیۡنَ ٱلسَّمَاۤءِ وَٱلۡأَرۡضِ لَءَایَـٰتࣲ لِّقَوۡمࣲ یَعۡقِلُونَ"],[2,165,"وَمِنَ ٱلنَّاسِ مَن یَتَّخِذُ مِن دُونِ ٱللَّهِ أَندَادࣰا یُحِبُّونَهُمۡ كَحُبِّ ٱللَّهِۖ وَٱلَّذِینَ ءَامَنُوۤا۟ أَشَدُّ حُبࣰّا لِّلَّهِۗ وَلَوۡ یَرَى ٱلَّذِینَ ظَلَمُوۤا۟ إِذۡ یَرَوۡنَ ٱلۡعَذَابَ أَنَّ ٱلۡقُوَّةَ لِلَّهِ جَمِیعࣰا وَأَنَّ ٱللَّهَ شَدِیدُ ٱلۡعَذَابِ"],[2,166,"إِذۡ تَبَرَّأَ ٱلَّذِینَ ٱتُّبِعُوا۟ مِنَ ٱلَّذِینَ ٱتَّبَعُوا۟ وَرَأَوُا۟ ٱلۡعَذَابَ وَتَقَطَّعَتۡ بِهِمُ ٱلۡأَسۡبَابُ"],[2,167,"وَقَالَ ٱلَّذِینَ ٱتَّبَعُوا۟ لَوۡ أَنَّ لَنَا كَرَّةࣰ فَنَتَبَرَّأَ مِنۡهُمۡ كَمَا تَبَرَّءُوا۟ مِنَّاۗ كَذَٰلِكَ یُرِیهِمُ ٱللَّهُ أَعۡمَـٰلَهُمۡ حَسَرَٰتٍ عَلَیۡهِمۡۖ وَمَا هُم بِخَـٰرِجِینَ مِنَ ٱلنَّارِ"],[2,168,"یَـٰۤأَیُّهَا ٱلنَّاسُ كُلُوا۟ مِمَّا فِی ٱلۡأَرۡضِ حَلَـٰلࣰا طَیِّبࣰا وَلَا تَتَّبِعُوا۟ خُطُوَٰتِ ٱلشَّیۡطَـٰنِۚ إِنَّهُۥ لَكُمۡ عَدُوࣱّ مُّبِینٌ"],[2,169,"إِنَّمَا یَأۡمُرُكُم بِٱلسُّوۤءِ وَٱلۡفَحۡشَاۤءِ وَأَن تَقُولُوا۟ عَلَى ٱللَّهِ مَا لَا تَعۡلَمُونَ"]]}