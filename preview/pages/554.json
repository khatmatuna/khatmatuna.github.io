"63:3","بِأَنَّهُمۡ"],["63:3","ءَامَنُواْ"],["63:3","ثُمَّ"],["63:3","كَفَرُواْ"],["63:3","فَطُبِعَ"],["63:3","عَلَىٰ"],["63:3","قُلُوبِهِمۡ"],["63:3","فَهُمۡ"]]],["l",[["63:3","لَا"],["63:3","يَفۡقَهُونَ"],["63:3","۝٣",1],["63:4","۞",2],["63:4","وَإِذَا"],["63:4","رَأَيۡتَهُمۡ"],["63:4","تُعۡجِبُكَ"],["63:4","أَجۡسَامُهُمۡۖ"],["63:4","وَإِن"],["63:4","يَقُولُواْ"]]],["l",[["63:4","تَسۡمَعۡ"],["63:4","لِقَوۡلِهِمۡۖ"],["63:4","كَأَنَّهُمۡ"],["63:4","خُشُبࣱ"],["63:4","مُّسَنَّدَةࣱۖ"],["63:4","يَحۡسَبُونَ"],["63:4","كُلَّ"],["63:4","صَيۡحَةٍ"]]],["l",[["63:4","عَلَيۡهِمۡۚ"],["63:4","هُمُ"],["63:4","ٱلۡعَدُوُّ"],["63:4","فَٱحۡذَرۡهُمۡۚ"],["63:4","قَٰتَلَهُمُ"],["63:4","ٱللَّهُۖ"],["63:4","أَنَّىٰ"],["63:4","يُؤۡفَكُونَ"],["63:4","۝٤",1]]]],"a":[[62,9,"یَـٰۤأَیُّهَا ٱلَّذِینَ ءَامَنُوۤا۟ إِذَا نُودِیَ لِلصَّلَوٰةِ مِن یَوۡمِ ٱلۡجُمُعَةِ فَٱسۡعَوۡا۟ إِلَىٰ ذِكۡرِ ٱللَّهِ وَذَرُوا۟ ٱلۡبَیۡعَۚ ذَٰلِكُمۡ خَیۡرࣱ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ"],[62,10,"فَإِذَا قُضِیَتِ ٱلصَّلَوٰةُ فَٱنتَشِرُوا۟ فِی ٱلۡأَرۡضِ وَٱبۡتَغُوا۟ مِن فَضۡلِ ٱللَّهِ وَٱذۡكُرُوا۟ ٱللَّهَ كَثِیرࣰا لَّعَلَّكُمۡ تُفۡلِحُونَ"],[62,11,"وَإِذَا رَأَوۡا۟ تِجَـٰرَةً أَوۡ لَهۡوًا ٱنفَضُّوۤا۟ إِلَیۡهَا وَتَرَكُوكَ قَاۤئِمࣰاۚ قُلۡ مَا عِندَ ٱللَّهِ خَیۡرࣱ مِّنَ ٱللَّهۡوِ وَمِنَ ٱلتِّجَـٰرَةِۚ وَٱللَّهُ خَیۡرُ ٱلرَّٰزِقِینَ"],[63,1,"إِذَا جَاۤءَكَ ٱلۡمُنَـٰفِقُونَ قَالُوا۟ نَشۡهَدُ إِنَّكَ لَرَسُولُ ٱللَّهِۗ وَٱللَّهُ یَعۡلَمُ إِنَّكَ لَرَسُولُهُۥ وَٱللَّهُ یَشۡهَدُ إِنَّ ٱلۡمُنَـٰفِقِینَ لَكَـٰذِبُونَ"],[63,2,"ٱتَّخَذُوۤا۟ أَیۡمَـٰنَهُمۡ جُنَّةࣰ فَصَدُّوا۟ عَن سَبِیلِ ٱللَّهِۚ إِنَّهُمۡ سَاۤءَ مَا كَانُوا۟ یَعۡمَلُونَ"],[63,3,"ذَٰلِكَ بِأَنَّهُمۡ ءَامَنُوا۟ ثُمَّ كَفَرُوا۟ فَطُبِعَ عَلَىٰ قُلُوبِهِمۡ فَهُمۡ لَا یَفۡقَهُونَ"],[63,4,"۞ وَإِذَا رَأَیۡتَهُمۡ تُعۡجِبُكَ أَجۡسَامُهُمۡۖ وَإِن یَقُولُوا۟ تَسۡمَعۡ لِقَوۡلِهِمۡۖ كَأَنَّهُمۡ خُشُبࣱ مُّسَنَّدَةࣱۖ یَحۡسَبُونَ كُلَّ صَیۡحَةٍ عَلَیۡهِمۡۚ هُمُ ٱلۡعَدُوُّ فَٱحۡذَرۡهُمۡۚ قَـٰتَلَهُمُ ٱللَّهُۖ أَنَّىٰ یُؤۡفَكُونَ"]]}