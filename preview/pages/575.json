ّرُ"],[74,2,"قُمۡ فَأَنذِرۡ"],[74,3,"وَرَبَّكَ فَكَبِّرۡ"],[74,4,"وَثِیَابَكَ فَطَهِّرۡ"],[74,5,"وَٱلرُّجۡزَ فَٱهۡجُرۡ"],[74,6,"وَلَا تَمۡنُن تَسۡتَكۡثِرُ"],[74,7,"وَلِرَبِّكَ فَٱصۡبِرۡ"],[74,8,"فَإِذَا نُقِرَ فِی ٱلنَّاقُورِ"],[74,9,"فَذَٰلِكَ یَوۡمَئِذࣲ یَوۡمٌ عَسِیرٌ"],[74,10,"عَلَى ٱلۡكَـٰفِرِینَ غَیۡرُ یَسِیرࣲ"],[74,11,"ذَرۡنِی وَمَنۡ خَلَقۡتُ وَحِیدࣰا"],[74,12,"وَجَعَلۡتُ لَهُۥ مَالࣰا مَّمۡدُودࣰا"],[74,13,"وَبَنِینَ شُهُودࣰا"],[74,14,"وَمَهَّدتُّ لَهُۥ تَمۡهِیدࣰا"],[74,15,"ثُمَّ یَطۡمَعُ أَنۡ أَزِیدَ"],[74,16,"كَلَّاۤۖ إِنَّهُۥ كَانَ لِءَایَـٰتِنَا عَنِیدࣰا"],[74,17,"سَأُرۡهِقُهُۥ صَعُودًا"],[74,18,"إِنَّهُۥ فَكَّرَ وَقَدَّرَ"]]}