,"وَهُمۡ"],["28:11","لَا"],["28:11","يَشۡعُرُونَ"],["28:11","۝١١",1]]],["l",[["28:12","۞",2],["28:12","وَحَرَّمۡنَا"],["28:12","عَلَيۡهِ"],["28:12","ٱلۡمَرَاضِعَ"],["28:12","مِن"],["28:12","قَبۡلُ"],["28:12","فَقَالَتۡ"],["28:12","هَلۡ"],["28:12","أَدُلُّكُمۡ"]]],["l",[["28:12","عَلَىٰٓ"],["28:12","أَهۡلِ"],["28:12","بَيۡتࣲ"],["28:12","يَكۡفُلُونَهُۥ"],["28:12","لَكُمۡ"],["28:12","وَهُمۡ"],["28:12","لَهُۥ"],["28:12","نَٰصِحُونَ"],["28:12","۝١٢",1]]],["l",[["28:13","فَرَدَدۡنَٰهُ"],["28:13","إِلَىٰٓ"],["28:13","أُمِّهِۦ"],["28:13","كَيۡ"],["28:13","تَقَرَّ"],["28:13","عَيۡنُهَا"],["28:13","وَلَا"],["28:13","تَحۡزَنَ"],["28:13","وَلِتَعۡلَمَ"]]],["l",[["28:13","أَنَّ"],["28:13","وَعۡدَ"],["28:13","ٱللَّهِ"],["28:13","حَقࣱّ"],["28:13","وَلَٰكِنَّ"],["28:13","أَكۡثَرَهُمۡ"],["28:13","لَا"],["28:13","يَعۡلَمُونَ"],["28:13","۝١٣",1]]]],"a":[[28,6,"وَنُمَكِّنَ لَهُمۡ فِی ٱلۡأَرۡضِ وَنُرِیَ فِرۡعَوۡنَ وَهَـٰمَـٰنَ وَجُنُودَهُمَا مِنۡهُم مَّا كَانُوا۟ یَحۡذَرُونَ"],[28,7,"وَأَوۡحَیۡنَاۤ إِلَىٰۤ أُمِّ مُوسَىٰۤ أَنۡ أَرۡضِعِیهِۖ فَإِذَا خِفۡتِ عَلَیۡهِ فَأَلۡقِیهِ فِی ٱلۡیَمِّ وَلَا تَخَافِی وَلَا تَحۡزَنِیۤۖ إِنَّا رَاۤدُّوهُ إِلَیۡكِ وَجَاعِلُوهُ مِنَ ٱلۡمُرۡسَلِینَ"],[28,8,"فَٱلۡتَقَطَهُۥۤ ءَالُ فِرۡعَوۡنَ لِیَكُونَ لَهُمۡ عَدُوࣰّا وَحَزَنًاۗ إِنَّ فِرۡعَوۡنَ وَهَـٰمَـٰنَ وَجُنُودَهُمَا كَانُوا۟ خَـٰطِءِینَ"],[28,9,"وَقَالَتِ ٱمۡرَأَتُ فِرۡعَوۡنَ قُرَّتُ عَیۡنࣲ لِّی وَلَكَۖ لَا تَقۡتُلُوهُ عَسَىٰۤ أَن یَنفَعَنَاۤ أَوۡ نَتَّخِذَهُۥ وَلَدࣰا وَهُمۡ لَا یَشۡعُرُونَ"],[28,10,"وَأَصۡبَحَ فُؤَادُ أُمِّ مُوسَىٰ فَـٰرِغًاۖ إِن كَادَتۡ لَتُبۡدِی بِهِۦ لَوۡلَاۤ أَن رَّبَطۡنَا عَلَىٰ قَلۡبِهَا لِتَكُونَ مِنَ ٱلۡمُؤۡمِنِینَ"],[28,11,"وَقَالَتۡ لِأُخۡتِهِۦ قُصِّیهِۖ فَبَصُرَتۡ بِهِۦ عَن جُنُبࣲ وَهُمۡ لَا یَشۡعُرُونَ"],[28,12,"۞ وَحَرَّمۡنَا عَلَیۡهِ ٱلۡمَرَاضِعَ مِن قَبۡلُ فَقَالَتۡ هَلۡ أَدُلُّكُمۡ عَلَىٰۤ أَهۡلِ بَیۡتࣲ یَكۡفُلُونَهُۥ لَكُمۡ وَهُمۡ لَهُۥ نَـٰصِحُونَ"],[28,13,"فَرَدَدۡنَـٰهُ إِلَىٰۤ أُمِّهِۦ كَیۡ تَقَرَّ عَیۡنُهَا وَلَا تَحۡزَنَ وَلِتَعۡلَمَ أَنَّ وَعۡدَ ٱللَّهِ حَقࣱّ وَلَـٰكِنَّ أَكۡثَرَهُمۡ لَا یَعۡلَمُونَ"]]}