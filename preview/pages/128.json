["6:6","۝٦",1],["6:7","وَلَوۡ"],["6:7","نَزَّلۡنَا"],["6:7","عَلَيۡكَ"],["6:7","كِتَٰبࣰا"],["6:7","فِي"],["6:7","قِرۡطَاسࣲ"],["6:7","فَلَمَسُوهُ"],["6:7","بِأَيۡدِيهِمۡ"]]],["l",[["6:7","لَقَالَ"],["6:7","ٱلَّذِينَ"],["6:7","كَفَرُوٓاْ"],["6:7","إِنۡ"],["6:7","هَٰذَآ"],["6:7","إِلَّا"],["6:7","سِحۡرࣱ"],["6:7","مُّبِينࣱ"],["6:7","۝٧",1],["6:8","وَقَالُواْ"],["6:8","لَوۡلَآ"],["6:8","أُنزِلَ"]]],["l",[["6:8","عَلَيۡهِ"],["6:8","مَلَكࣱۖ"],["6:8","وَلَوۡ"],["6:8","أَنزَلۡنَا"],["6:8","مَلَكࣰا"],["6:8","لَّقُضِيَ"],["6:8","ٱلۡأَمۡرُ"],["6:8","ثُمَّ"],["6:8","لَا"],["6:8","يُنظَرُونَ"],["6:8","۝٨",1]]]],"a":[[6,1,"ٱلۡحَمۡدُ لِلَّهِ ٱلَّذِی خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضَ وَجَعَلَ ٱلظُّلُمَـٰتِ وَٱلنُّورَۖ ثُمَّ ٱلَّذِینَ كَفَرُوا۟ بِرَبِّهِمۡ یَعۡدِلُونَ"],[6,2,"هُوَ ٱلَّذِی خَلَقَكُم مِّن طِینࣲ ثُمَّ قَضَىٰۤ أَجَلࣰاۖ وَأَجَلࣱ مُّسَمًّى عِندَهُۥۖ ثُمَّ أَنتُمۡ تَمۡتَرُونَ"],[6,3,"وَهُوَ ٱللَّهُ فِی ٱلسَّمَـٰوَٰتِ وَفِی ٱلۡأَرۡضِ یَعۡلَمُ سِرَّكُمۡ وَجَهۡرَكُمۡ وَیَعۡلَمُ مَا تَكۡسِبُونَ"],[6,4,"وَمَا تَأۡتِیهِم مِّنۡ ءَایَةࣲ مِّنۡ ءَایَـٰتِ رَبِّهِمۡ إِلَّا كَانُوا۟ عَنۡهَا مُعۡرِضِینَ"],[6,5,"فَقَدۡ كَذَّبُوا۟ بِٱلۡحَقِّ لَمَّا جَاۤءَهُمۡ فَسَوۡفَ یَأۡتِیهِمۡ أَنۢبَـٰۤؤُا۟ مَا كَانُوا۟ بِهِۦ یَسۡتَهۡزِءُونَ"],[6,6,"أَلَمۡ یَرَوۡا۟ كَمۡ أَهۡلَكۡنَا مِن قَبۡلِهِم مِّن قَرۡنࣲ مَّكَّنَّـٰهُمۡ فِی ٱلۡأَرۡضِ مَا لَمۡ نُمَكِّن لَّكُمۡ وَأَرۡسَلۡنَا ٱلسَّمَاۤءَ عَلَیۡهِم مِّدۡرَارࣰا وَجَعَلۡنَا ٱلۡأَنۡهَـٰرَ تَجۡرِی مِن تَحۡتِهِمۡ فَأَهۡلَكۡنَـٰهُم بِذُنُوبِهِمۡ وَأَنشَأۡنَا مِنۢ بَعۡدِهِمۡ قَرۡنًا ءَاخَرِینَ"],[6,7,"وَلَوۡ نَزَّلۡنَا عَلَیۡكَ كِتَـٰبࣰا فِی قِرۡطَاسࣲ فَلَمَسُوهُ بِأَیۡدِیهِمۡ لَقَالَ ٱلَّذِینَ كَفَرُوۤا۟ إِنۡ هَـٰذَاۤ إِلَّا سِحۡرࣱ مُّبِینࣱ"],[6,8,"وَقَالُوا۟ لَوۡلَاۤ أُنزِلَ عَلَیۡهِ مَلَكࣱۖ وَلَوۡ أَنزَلۡنَا مَلَكࣰا لَّقُضِیَ ٱلۡأَمۡرُ ثُمَّ لَا یُنظَرُونَ"]]}