],["l",[["4:119","وَلَأٓمُرَنَّهُمۡ"],["4:119","فَلَيُبَتِّكُنَّ"],["4:119","ءَاذَانَ"],["4:119","ٱلۡأَنۡعَٰمِ"],["4:119","وَلَأٓمُرَنَّهُمۡ"]]],["l",[["4:119","فَلَيُغَيِّرُنَّ"],["4:119","خَلۡقَ"],["4:119","ٱللَّهِۚ"],["4:119","وَمَن"],["4:119","يَتَّخِذِ"],["4:119","ٱلشَّيۡطَٰنَ"],["4:119","وَلِيࣰّا"],["4:119","مِّن"]]],["l",[["4:119","دُونِ"],["4:119","ٱللَّهِ"],["4:119","فَقَدۡ"],["4:119","خَسِرَ"],["4:119","خُسۡرَانࣰا"],["4:119","مُّبِينࣰا"],["4:119","۝١١٩",1],["4:120","يَعِدُهُمۡ"]]],["l",[["4:120","وَيُمَنِّيهِمۡۖ"],["4:120","وَمَا"],["4:120","يَعِدُهُمُ"],["4:120","ٱلشَّيۡطَٰنُ"],["4:120","إِلَّا"],["4:120","غُرُورًا"],["4:120","۝١٢٠",1],["4:121","أُوْلَٰٓئِكَ"]]],["l",[["4:121","مَأۡوَىٰهُمۡ"],["4:121","جَهَنَّمُ"],["4:121","وَلَا"],["4:121","يَجِدُونَ"],["4:121","عَنۡهَا"],["4:121","مَحِيصࣰا"],["4:121","۝١٢١",1]]]],"a":[[4,114,"۞ لَّا خَیۡرَ فِی كَثِیرࣲ مِّن نَّجۡوَىٰهُمۡ إِلَّا مَنۡ أَمَرَ بِصَدَقَةٍ أَوۡ مَعۡرُوفٍ أَوۡ إِصۡلَـٰحِۭ بَیۡنَ ٱلنَّاسِۚ وَمَن یَفۡعَلۡ ذَٰلِكَ ٱبۡتِغَاۤءَ مَرۡضَاتِ ٱللَّهِ فَسَوۡفَ نُؤۡتِیهِ أَجۡرًا عَظِیمࣰا"],[4,115,"وَمَن یُشَاقِقِ ٱلرَّسُولَ مِنۢ بَعۡدِ مَا تَبَیَّنَ لَهُ ٱلۡهُدَىٰ وَیَتَّبِعۡ غَیۡرَ سَبِیلِ ٱلۡمُؤۡمِنِینَ نُوَلِّهِۦ مَا تَوَلَّىٰ وَنُصۡلِهِۦ جَهَنَّمَۖ وَسَاۤءَتۡ مَصِیرًا"],[4,116,"إِنَّ ٱللَّهَ لَا یَغۡفِرُ أَن یُشۡرَكَ بِهِۦ وَیَغۡفِرُ مَا دُونَ ذَٰلِكَ لِمَن یَشَاۤءُۚ وَمَن یُشۡرِكۡ بِٱللَّهِ فَقَدۡ ضَلَّ ضَلَـٰلَۢا بَعِیدًا"],[4,117,"إِن یَدۡعُونَ مِن دُونِهِۦۤ إِلَّاۤ إِنَـٰثࣰا وَإِن یَدۡعُونَ إِلَّا شَیۡطَـٰنࣰا مَّرِیدࣰا"],[4,118,"لَّعَنَهُ ٱللَّهُۘ وَقَالَ لَأَتَّخِذَنَّ مِنۡ عِبَادِكَ نَصِیبࣰا مَّفۡرُوضࣰا"],[4,119,"وَلَأُضِلَّنَّهُمۡ وَلَأُمَنِّیَنَّهُمۡ وَلَءَامُرَنَّهُمۡ فَلَیُبَتِّكُنَّ ءَاذَانَ ٱلۡأَنۡعَـٰمِ وَلَءَامُرَنَّهُمۡ فَلَیُغَیِّرُنَّ خَلۡقَ ٱللَّهِۚ وَمَن یَتَّخِذِ ٱلشَّیۡطَـٰنَ وَلِیࣰّا مِّن دُونِ ٱللَّهِ فَقَدۡ خَسِرَ خُسۡرَانࣰا مُّبِینࣰا"],[4,120,"یَعِدُهُمۡ وَیُمَنِّیهِمۡۖ وَمَا یَعِدُهُمُ ٱلشَّیۡطَـٰنُ إِلَّا غُرُورًا"],[4,121,"أُو۟لَـٰۤئِكَ مَأۡوَىٰهُمۡ جَهَنَّمُ وَلَا یَجِدُونَ عَنۡهَا مَحِیصࣰا"]]}