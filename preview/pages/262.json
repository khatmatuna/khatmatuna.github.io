l",[["15:12","فِي"],["15:12","قُلُوبِ"],["15:12","ٱلۡمُجۡرِمِينَ"],["15:12","۝١٢",1],["15:13","لَا"],["15:13","يُؤۡمِنُونَ"],["15:13","بِهِۦ"],["15:13","وَقَدۡ"],["15:13","خَلَتۡ"],["15:13","سُنَّةُ"],["15:13","ٱلۡأَوَّلِينَ"],["15:13","۝١٣",1]]],["l",[["15:14","وَلَوۡ"],["15:14","فَتَحۡنَا"],["15:14","عَلَيۡهِم"],["15:14","بَابࣰا"],["15:14","مِّنَ"],["15:14","ٱلسَّمَآءِ"],["15:14","فَظَلُّواْ"],["15:14","فِيهِ"],["15:14","يَعۡرُجُونَ"],["15:14","۝١٤",1]]],["l",[["15:15","لَقَالُوٓاْ"],["15:15","إِنَّمَا"],["15:15","سُكِّرَتۡ"],["15:15","أَبۡصَٰرُنَا"],["15:15","بَلۡ"],["15:15","نَحۡنُ"],["15:15","قَوۡمࣱ"],["15:15","مَّسۡحُورُونَ"],["15:15","۝١٥",1]]]],"a":[[15,1,"۞ الۤرۚ تِلۡكَ ءَایَـٰتُ ٱلۡكِتَـٰبِ وَقُرۡءَانࣲ مُّبِینࣲ"],[15,2,"رُّبَمَا یَوَدُّ ٱلَّذِینَ كَفَرُوا۟ لَوۡ كَانُوا۟ مُسۡلِمِینَ"],[15,3,"ذَرۡهُمۡ یَأۡكُلُوا۟ وَیَتَمَتَّعُوا۟ وَیُلۡهِهِمُ ٱلۡأَمَلُۖ فَسَوۡفَ یَعۡلَمُونَ"],[15,4,"وَمَاۤ أَهۡلَكۡنَا مِن قَرۡیَةٍ إِلَّا وَلَهَا كِتَابࣱ مَّعۡلُومࣱ"],[15,5,"مَّا تَسۡبِقُ مِنۡ أُمَّةٍ أَجَلَهَا وَمَا یَسۡتَءۡخِرُونَ"],[15,6,"وَقَالُوا۟ یَـٰۤأَیُّهَا ٱلَّذِی نُزِّلَ عَلَیۡهِ ٱلذِّكۡرُ إِنَّكَ لَمَجۡنُونࣱ"],[15,7,"لَّوۡ مَا تَأۡتِینَا بِٱلۡمَلَـٰۤئِكَةِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِینَ"],[15,8,"مَا نُنَزِّلُ ٱلۡمَلَـٰۤئِكَةَ إِلَّا بِٱلۡحَقِّ وَمَا كَانُوۤا۟ إِذࣰا مُّنظَرِینَ"],[15,9,"إِنَّا نَحۡنُ نَزَّلۡنَا ٱلذِّكۡرَ وَإِنَّا لَهُۥ لَحَـٰفِظُونَ"],[15,10,"وَلَقَدۡ أَرۡسَلۡنَا مِن قَبۡلِكَ فِی شِیَعِ ٱلۡأَوَّلِینَ"],[15,11,"وَمَا یَأۡتِیهِم مِّن رَّسُولٍ إِلَّا كَانُوا۟ بِهِۦ یَسۡتَهۡزِءُونَ"],[15,12,"كَذَٰلِكَ نَسۡلُكُهُۥ فِی قُلُوبِ ٱلۡمُجۡرِمِینَ"],[15,13,"لَا یُؤۡمِنُونَ بِهِۦ وَقَدۡ خَلَتۡ سُنَّةُ ٱلۡأَوَّلِینَ"],[15,14,"وَلَوۡ فَتَحۡنَا عَلَیۡهِم بَابࣰا مِّنَ ٱلسَّمَاۤءِ فَظَلُّوا۟ فِیهِ یَعۡرُجُونَ"],[15,15,"لَقَالُوۤا۟ إِنَّمَا سُكِّرَتۡ أَبۡصَـٰرُنَا بَلۡ نَحۡنُ قَوۡمࣱ مَّسۡحُورُونَ"]]}